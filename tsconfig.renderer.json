{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2022"],
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist/renderer",
    "skipLibCheck": true
  },
  "include": [
    "src/renderer/**/*",
    "src/titlebar/**/*",
    "src/window/**/*",
    "src/shared/**/*",
    "src/types/**/*",
    "assets/**/*"
  ],
  "exclude": [
    "node_modules",
    "test",
    "**/*.test.ts",
    "**/*.spec.ts",
    "release/build",
    "release/app/dist",
    ".erb/dll",
    "src/renderer/unused/**/*"
  ]
}