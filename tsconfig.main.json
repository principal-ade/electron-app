{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "types": ["node", "electron"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist/main",
    "skipLibCheck": true
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "src/types/**/*",
    "src/window/main-process-api-implementations/**/*"
  ],
  "exclude": [
    "node_modules",
    "test",
    "**/*.test.ts",
    "**/*.spec.ts",
    "release/build",
    "release/app/dist",
    ".erb/dll",
    "src/shared/components/**/*",
    "src/shared/hooks/**/*",
    // Only exclude specific problematic services temporarily
    "src/main/services/ai/**/*",
    // Exclude VS Code extension examples from main process compilation
    "src/main/planning-mcp/vscode-extension-example/**/*",
    // Temporarily exclude shared files with TypeScript errors - TO BE FIXED ONE BY ONE
  ]
}