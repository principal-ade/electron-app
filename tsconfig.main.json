{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist/main",
    "skipLibCheck": true
  },
  "include": [
    "src/main/**/*",
    "src/event-processing-server/**/*",
    "src/terminal-worker/**/*",
    "src/shared/**/*",
    "src/telemetry/**/*",
    "src/types/**/*",
    "src/window/main-process-api-implementations/**/*"
  ],
  "exclude": [
    "node_modules",
    "test",
    "**/*.test.ts",
    "**/*.spec.ts",
    "release/build",
    "release/app/dist",
    ".erb/dll",
    "src/shared/components/**/*",
    "src/shared/hooks/**/*"
  ]
}