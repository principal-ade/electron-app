{
  "name": "@principal-ai/agent-monitoring",
  "version": "0.3.4",
  "description": "Agent event monitoring and processing system",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:clean": "rm -rf dist",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "pack:local": "npm pack",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.15.26",
    "husky": "^9.1.7",
    "tsup": "^8.5.0",
    "typescript": "^5.0.4"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/principal-ai/agent-monitoring.git"
  },
  "keywords": [
    "agent",
    "monitoring",
    "events",
    "telemetry"
  ],
  "author": "Principal AI",
  "license": "MIT"
}
