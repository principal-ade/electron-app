{
  "name": "@a24z/observability-sdk",
  "version": "0.4.1",
  "description": "SDK for writing normalized session data directly to A24Z Observability database",
  "private": false,
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json",
    "setup-database.sql"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "publish:npm": "npm publish --access restricted",
    "publish:dry": "npm publish --dry-run --access restricted"
  },
  "dependencies": {
    "drizzle-orm": "^0.29.3",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  }
}