{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main/main.ts",
    "src/main/terminal/index.ts",
    "src/renderer/index.tsx",
    "src/window/preload.ts",
    "src/window/preload-dev-workspace.ts",
    "src/window/preload-extension-window.ts",
    "src/window/preload-quick-open.ts",
    "src/window/preload-window-switcher.ts",
    "src/window/preload-remote-terminal-viewer.ts",
    "src/terminal-worker/worker-entry.ts",
    ".erb/scripts/**/*.{js,ts}",
    ".erb/configs/**/*.ts",
    "src/renderer/principal-window/index.tsx",
    "src/renderer/quick-open/index.tsx",
    "src/renderer/window-switcher/index.tsx",
    "src/renderer/dev-workspace/index.tsx",
    "src/renderer/extension-window/index.tsx",
    "src/event-processing-server/server.ts",
    "src/event-processing-server/worker-entry.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,jsx}"
  ],
  "ignore": [
    "**/*.test.*",
    ".erb/**"
  ],
  "ignoreDependencies": [
    "keytar"
  ],
  "webpack": false,
  "eslint": {
    "config": ["eslint.config.mjs"]
  },
  "jest": {
    "config": ["package.json"]
  },
  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": ["tests/e2e/**/*.spec.ts"]
  },
  "typescript": {
    "config": [
      "tsconfig.json",
      "tsconfig.node.json",
      "tsconfig.strict.json"
    ]
  },
  "babel": {
    "config": ["babel.config.js", ".babelrc.js"]
  },
  "postcss": {
    "config": ["postcss.config.js"]
  },
  "tailwind": {
    "config": ["tailwind.config.js"]
  },
  "ignoreBinaries": [],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
    "enum": true
  }
}