{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "types": ["node", "jest"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist/shared"
  },
  "include": [
    "src/shared/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "test",
    "release/build",
    "release/app/dist",
    ".erb/dll",
    // Temporarily exclude files with TypeScript errors - TO BE FIXED ONE BY ONE
  ]
}