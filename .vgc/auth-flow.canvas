{
  "vv": {
    "name": "Authentication & Token Refresh Flow",
    "version": "1.0.0",
    "nodeTypes": {
      "renderer": {
        "label": "Renderer Process",
        "color": "#22C55E"
      },
      "main": {
        "label": "Main Process",
        "color": "#3B82F6"
      },
      "preload": {
        "label": "Preload (Bridge)",
        "color": "#A855F7"
      },
      "storage": {
        "label": "Storage/OS",
        "color": "#F59E0B"
      },
      "external": {
        "label": "External Service",
        "color": "#EF4444"
      }
    },
    "edgeTypes": {
      "ipc-invoke": {
        "label": "IPC Invoke",
        "style": "solid",
        "color": "#6366F1"
      },
      "ipc-event": {
        "label": "IPC Event",
        "style": "dashed",
        "color": "#818CF8"
      },
      "http": {
        "label": "HTTP",
        "style": "solid",
        "color": "#EF4444"
      },
      "uses": {
        "label": "Uses",
        "style": "dotted",
        "color": "#64748B"
      },
      "stores": {
        "label": "Stores",
        "style": "solid",
        "color": "#10B981"
      },
      "broadcasts": {
        "label": "Broadcasts",
        "style": "dashed",
        "color": "#0EA5E9"
      }
    }
  },
  "nodes": [
    {
      "id": "auth-view",
      "type": "text",
      "x": 294,
      "y": -5,
      "width": 160,
      "height": 60,
      "text": "AuthView",
      "vv": {
        "nodeType": "renderer",
        "shape": "rectangle",
        "notes": "[React Component] Login/logout UI component. Uses useAuthState hook for auth operations. File: src/renderer/principal-window/views/AuthView/AuthView.tsx"
      }
    },
    {
      "id": "use-auth-state",
      "type": "text",
      "x": 294,
      "y": 110,
      "width": 160,
      "height": 60,
      "text": "useAuthState()",
      "vv": {
        "nodeType": "renderer",
        "shape": "rectangle",
        "notes": "[React Hook] Provides isAuthenticated, user, login(), logout(), refresh(). Subscribes to auth state changes. File: src/renderer/hooks/useAuthState.ts"
      }
    },
    {
      "id": "authentication-service",
      "type": "text",
      "x": 276,
      "y": 210,
      "width": 180,
      "height": 60,
      "text": "AuthenticationService",
      "vv": {
        "nodeType": "renderer",
        "shape": "rectangle",
        "notes": "[Service Layer] Wraps preload API with error handling. login(), logout(), check(), onAuthStateChanged(). File: src/renderer/main-process-api/AuthenticationService.ts"
      }
    },
    {
      "id": "authentication-api",
      "type": "text",
      "x": 49,
      "y": 308,
      "width": 180,
      "height": 60,
      "text": "authenticationApi",
      "vv": {
        "nodeType": "preload",
        "shape": "rectangle",
        "notes": "Preload bridge. Exposes window.mainProcess.authentication. Uses ipcRenderer.invoke/on for IPC. File: src/window/main-process-api-implementations/authenticationApi.ts"
      }
    },
    {
      "id": "auth-events",
      "type": "text",
      "x": -118,
      "y": 426,
      "width": 160,
      "height": 60,
      "text": "AuthEvent enum",
      "vv": {
        "nodeType": "preload",
        "shape": "rectangle",
        "notes": "[Shared] IPC channel definitions: LOGIN, LOGOUT, CHECK, STATUS, STATE_CHANGED, GET_TOKEN_METADATA, VALIDATE_GITHUB_TOKEN. File: src/shared/ipc-events/AuthEvents.ts"
      }
    },
    {
      "id": "auth-service",
      "type": "text",
      "x": 77,
      "y": 411,
      "width": 180,
      "height": 70,
      "text": "AuthService",
      "vv": {
        "nodeType": "main",
        "shape": "rectangle",
        "notes": "Core auth logic. Handles LOGIN/LOGOUT IPC. Orchestrates OAuth flow, token refresh, state updates. File: src/main/services/AuthService.ts"
      }
    },
    {
      "id": "auth-state-manager",
      "type": "text",
      "x": 438,
      "y": 330,
      "width": 180,
      "height": 70,
      "text": "AuthStateManager",
      "vv": {
        "nodeType": "main",
        "shape": "rectangle",
        "notes": "[Singleton] Canonical auth state: isAuthenticated, user, token. Broadcasts state changes to all windows. File: src/main/services/AuthStateManager.ts"
      }
    },
    {
      "id": "oauth-client",
      "type": "text",
      "x": -248,
      "y": 561,
      "width": 180,
      "height": 70,
      "text": "OAuthServerClient",
      "vv": {
        "nodeType": "main",
        "shape": "rectangle",
        "notes": "PKCE OAuth flow. authenticate(): start → browser → poll for token. refreshAccessToken(): POST /api/auth/workos/refresh. File: src/main/services/OAuthServerClient.ts"
      }
    },
    {
      "id": "secure-token-ipc",
      "type": "text",
      "x": 207,
      "y": 544,
      "width": 180,
      "height": 70,
      "text": "SecureTokenIPC",
      "vv": {
        "nodeType": "main",
        "shape": "rectangle",
        "notes": "Token IPC handlers. SAVE/GET/CLEAR_GITHUB_AUTH. Lazy initialization - no keychain access on startup. File: src/main/services/SecureTokenIPC.ts"
      }
    },
    {
      "id": "jwt-service",
      "type": "text",
      "x": 399,
      "y": 526,
      "width": 160,
      "height": 70,
      "text": "JWTService",
      "vv": {
        "nodeType": "main",
        "shape": "rectangle",
        "notes": "Creates JWTs for git-sync. Maps GitHub permissions to sync permissions. Signs with HS256. File: src/main/services/JWTService.ts"
      }
    },
    {
      "id": "unified-storage",
      "type": "text",
      "x": 250,
      "y": 650,
      "width": 200,
      "height": 70,
      "text": "UnifiedSecureStorage",
      "vv": {
        "nodeType": "storage",
        "shape": "rectangle",
        "notes": "Singleton. Encrypts tokens using safeStorage (Keychain-protected key), then writes encrypted blobs to JSON file. 30s timeout protection. Manages: github_token, workos_token, workos_refresh_token. File: src/main/services/UnifiedSecureStorage.ts"
      }
    },
    {
      "id": "keychain",
      "type": "text",
      "x": 250,
      "y": 760,
      "width": 200,
      "height": 50,
      "text": "OS Keychain (safeStorage)",
      "vv": {
        "nodeType": "storage",
        "shape": "rectangle",
        "notes": "macOS Keychain / Windows Credential Manager. Holds the encryption KEY used by safeStorage.encryptString/decryptString. Tokens are NOT stored here directly - only the key that encrypts them."
      }
    },
    {
      "id": "storage-file",
      "type": "text",
      "x": 500,
      "y": 700,
      "width": 200,
      "height": 60,
      "text": "unified-secure-storage.json",
      "vv": {
        "nodeType": "storage",
        "shape": "rectangle",
        "notes": "~/Library/Application Support/[App]/unified-secure-storage.json. Contains ENCRYPTED token blobs (base64), not plaintext. Encrypted using Keychain-protected key. File permissions: 0o600."
      }
    },
    {
      "id": "workos-api",
      "type": "text",
      "x": -132,
      "y": 669,
      "width": 160,
      "height": 70,
      "text": "WorkOS Auth API",
      "vv": {
        "nodeType": "external",
        "shape": "rectangle",
        "notes": "External OAuth server. Endpoints: /api/auth/workos/start, /token, /refresh. Returns github_access_token, workos_access_token, refresh_token, expires_in."
      }
    },
    {
      "id": "github-api",
      "type": "text",
      "x": 73,
      "y": 666,
      "width": 160,
      "height": 50,
      "text": "GitHub API",
      "vv": {
        "nodeType": "external",
        "shape": "rectangle",
        "notes": "GET /user for profile enrichment. Validates tokens. Returns user info (login, email, avatar)."
      }
    },
    {
      "id": "browser",
      "type": "text",
      "x": -337,
      "y": 671,
      "width": 140,
      "height": 50,
      "text": "System Browser",
      "vv": {
        "nodeType": "external",
        "shape": "rectangle",
        "notes": "shell.openExternal(auth_url). User authorizes GitHub access. Redirects back to WorkOS."
      }
    },
    {
      "id": "github-token-auth",
      "type": "text",
      "x": 597,
      "y": 601,
      "width": 160,
      "height": 70,
      "text": "githubTokenAuth",
      "vv": {
        "nodeType": "main",
        "shape": "rectangle",
        "notes": "Git HTTPS auth helper. Creates GIT_ASKPASS script. Provides token for git clone/push. File: src/shared/git/githubTokenAuth.ts"
      }
    },
    {
      "id": "token-github",
      "type": "text",
      "x": 570,
      "y": 872,
      "width": 130,
      "height": 50,
      "text": "github_token",
      "vv": {
        "nodeType": "storage",
        "shape": "rectangle",
        "notes": "GitHub PAT. Never expires. Used for API calls and git operations."
      }
    },
    {
      "id": "token-workos",
      "type": "text",
      "x": 200,
      "y": 850,
      "width": 130,
      "height": 50,
      "text": "workos_token",
      "vv": {
        "nodeType": "storage",
        "shape": "rectangle",
        "notes": "WorkOS session token. Expires in 1 hour. Used for session management."
      }
    },
    {
      "id": "token-refresh",
      "type": "text",
      "x": 350,
      "y": 850,
      "width": 130,
      "height": 50,
      "text": "workos_refresh_token",
      "vv": {
        "nodeType": "storage",
        "shape": "rectangle",
        "notes": "WorkOS refresh token. Used to refresh workos_token via POST /api/auth/workos/refresh. Rotated on each refresh (token rotation). Long-lived."
      }
    }
  ],
  "edges": [
    {
      "id": "view-to-hook",
      "fromNode": "auth-view",
      "toNode": "use-auth-state",
      "label": "uses",
      "vv": {
        "edgeType": "uses",
        "notes": "Component uses hook for auth state and actions"
      }
    },
    {
      "id": "hook-to-service",
      "fromNode": "use-auth-state",
      "toNode": "authentication-service",
      "label": "calls",
      "vv": {
        "edgeType": "uses",
        "notes": "Hook calls service methods for login/logout/refresh"
      }
    },
    {
      "id": "service-to-api",
      "fromNode": "authentication-service",
      "toNode": "authentication-api",
      "label": "window.mainProcess",
      "vv": {
        "edgeType": "uses",
        "notes": "Service wraps preload API calls"
      }
    },
    {
      "id": "api-to-events",
      "fromNode": "authentication-api",
      "toNode": "auth-events",
      "label": "uses channels",
      "vv": {
        "edgeType": "uses",
        "notes": "API uses AuthEvent enum for type-safe IPC channels"
      }
    },
    {
      "id": "api-to-auth-service",
      "fromNode": "authentication-api",
      "toNode": "auth-service",
      "label": "ipcRenderer.invoke(LOGIN)",
      "vv": {
        "edgeType": "ipc-invoke",
        "notes": "LOGIN, LOGOUT, CHECK, GET_TOKEN_METADATA IPC calls"
      }
    },
    {
      "id": "state-to-api",
      "fromNode": "auth-state-manager",
      "toNode": "authentication-api",
      "label": "auth-state:changed",
      "vv": {
        "edgeType": "ipc-event",
        "notes": "Broadcasts state changes to all renderer windows via webContents.send()"
      }
    },
    {
      "id": "auth-service-to-state",
      "fromNode": "auth-service",
      "toNode": "auth-state-manager",
      "label": "setAuthenticated()",
      "vv": {
        "edgeType": "uses",
        "notes": "Updates canonical auth state after login/logout/refresh"
      }
    },
    {
      "id": "auth-service-to-oauth",
      "fromNode": "auth-service",
      "toNode": "oauth-client",
      "label": "authenticate()",
      "vv": {
        "edgeType": "uses",
        "notes": "Delegates OAuth flow to OAuthServerClient"
      }
    },
    {
      "id": "auth-service-to-token-ipc",
      "fromNode": "auth-service",
      "toNode": "secure-token-ipc",
      "label": "store tokens",
      "vv": {
        "edgeType": "uses",
        "notes": "Stores/retrieves tokens via SecureTokenIPC"
      }
    },
    {
      "id": "auth-service-to-jwt",
      "fromNode": "auth-service",
      "toNode": "jwt-service",
      "label": "createJWT()",
      "vv": {
        "edgeType": "uses",
        "notes": "Creates JWTs for git-sync operations"
      }
    },
    {
      "id": "oauth-to-workos",
      "fromNode": "oauth-client",
      "toNode": "workos-api",
      "label": "POST /start, /token, /refresh",
      "vv": {
        "edgeType": "http",
        "notes": "PKCE OAuth flow: start auth, poll for token, refresh token"
      }
    },
    {
      "id": "oauth-to-browser",
      "fromNode": "oauth-client",
      "toNode": "browser",
      "label": "shell.openExternal()",
      "vv": {
        "edgeType": "uses",
        "notes": "Opens system browser for user authorization"
      }
    },
    {
      "id": "auth-service-to-github",
      "fromNode": "auth-service",
      "toNode": "github-api",
      "label": "GET /user",
      "vv": {
        "edgeType": "http",
        "notes": "Fetches user profile for enrichment after OAuth"
      }
    },
    {
      "id": "token-ipc-to-storage",
      "fromNode": "secure-token-ipc",
      "toNode": "unified-storage",
      "label": "setToken/getToken",
      "vv": {
        "edgeType": "uses",
        "notes": "IPC handlers delegate to UnifiedSecureStorage"
      }
    },
    {
      "id": "storage-to-keychain",
      "fromNode": "unified-storage",
      "toNode": "keychain",
      "label": "safeStorage.encrypt/decrypt",
      "vv": {
        "edgeType": "stores",
        "notes": "Uses Electron safeStorage for encryption keys"
      }
    },
    {
      "id": "storage-to-file",
      "fromNode": "unified-storage",
      "toNode": "storage-file",
      "label": "write/read",
      "vv": {
        "edgeType": "stores",
        "notes": "Persists encrypted tokens to JSON file"
      }
    },
    {
      "id": "jwt-to-github-token-auth",
      "fromNode": "jwt-service",
      "toNode": "github-token-auth",
      "label": "provides token",
      "vv": {
        "edgeType": "uses",
        "notes": "JWTService provides tokens for git operations"
      }
    },
    {
      "id": "file-to-token-github",
      "fromNode": "storage-file",
      "toNode": "token-github",
      "label": "contains",
      "vv": {
        "edgeType": "stores",
        "notes": "Stores encrypted github_token"
      }
    },
    {
      "id": "file-to-token-workos",
      "fromNode": "storage-file",
      "toNode": "token-workos",
      "label": "contains",
      "vv": {
        "edgeType": "stores",
        "notes": "Stores encrypted workos_token"
      }
    },
    {
      "id": "file-to-token-refresh",
      "fromNode": "storage-file",
      "toNode": "token-refresh",
      "label": "contains",
      "vv": {
        "edgeType": "stores",
        "notes": "Stores encrypted workos_refresh_token"
      }
    }
  ]
}