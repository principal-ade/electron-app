  "nodes": [
    {
      "id": "git-changes-context",
      "type": "text",
      "x": 5,
      "y": 22,
      "width": 180,
      "height": 70,
      "text": "GitChangesContext",
      "vv": {
        "nodeType": "react-context",
        "shape": "rectangle",
        "notes": "React context for git state. Subscribes to onGitStatusChanged events. Manages git diff highlighting. File: src/renderer/contexts/GitChangesContext.tsx"
      }
    },
    {
      "id": "repository-panel-context",
      "type": "text",
      "x": 278,
      "y": 26,
