      "height": 70,
      "text": "RepositoryPanelContext",
      "vv": {
        "nodeType": "react-context",
        "shape": "rectangle",
        "notes": "React context for repository panel data. Subscribes to onCacheSync for fileTree and packages updates. File: src/renderer/contexts/RepositoryPanelContext.tsx"
      }
    },
    {
      "id": "workspaces-panel-context",
      "type": "text",
      "x": 551,
      "y": 30,
      "width": 200,
      "height": 70,
      "text": "WorkspacesPanelContext",
      "vv": {
        "nodeType": "react-context",
        "shape": "rectangle",
        "notes": "React context for workspace file changes. File: src/renderer/contexts/WorkspacesPanelContext.tsx"
      }
    },
    {
      "id": "repository-monitoring-service",
      "type": "text",
      "x": 260,
      "y": 160,
      "width": 220,
      "height": 70,
      "text": "RepositoryMonitoringService",
      "vv": {
        "nodeType": "service",
        "shape": "rectangle",
        "notes": "High-level TypeScript service class. Wraps preload API with error handling. Used by React components and contexts. File: src/renderer/main-process-api/RepositoryMonitoringService.ts"
      }
    },
    {
      "id": "repository-monitoring-api",
      "type": "text",
      "x": -41,
      "y": 278,
      "width": 220,
      "height": 70,
      "text": "repositoryMonitoringApi",
      "vv": {
        "nodeType": "api-layer",
        "shape": "rectangle",
        "notes": "Preload API implementation. IPC method wrappers using ipcRenderer.invoke/on. Exposed via window.mainProcess.repositoryMonitoring. File: src/window/main-process-api-implementations/repositoryMonitoringApi.ts"
      }
    },
    {
      "id": "monitoring-events-enum",
      "type": "text",
      "x": -31,
      "y": 417,
      "width": 200,
      "height": 70,
      "text": "RepositoryMonitoringAPIEvent",
      "vv": {
        "nodeType": "event-enum",
        "shape": "rectangle",
        "notes": "41 event types: GET_FILE_TREE, GET_PACKAGES, CACHE_SYNC, GIT_STATUS_CHANGED, WORKSPACE_CHANGED, etc. File: src/shared/main-process-api-interfaces/RepositoryMonitoringAPI.ts"
      }
    },
    {
      "id": "ipc-handlers",
      "type": "text",
      "x": 410,
      "y": 334,
      "width": 220,
      "height": 70,
      "text": "IPC Handlers",
      "vv": {
        "nodeType": "main-process",
        "shape": "rectangle",
        "notes": "Central IPC handler registration. Forwards events from worker to renderer windows. ipcMain.handle() for all monitoring operations. File: src/main/repository-monitoring/ipcHandlers.ts"
      }
    },
    {
      "id": "monitoring-manager",
      "type": "text",
      "x": 240,
      "y": 513,
      "width": 220,
      "height": 70,
      "text": "RepositoryMonitoringManager",
      "vv": {
        "nodeType": "main-process",
        "shape": "rectangle",
        "notes": "Singleton manager. Manages worker process lifecycle. Handles IPC message routing to/from worker. Broadcasts events to all renderer windows."
      }
    },
    {
      "id": "browser-windows",
      "type": "text",
      "x": 542,
      "y": 504,
      "width": 180,
      "height": 70,
      "text": "BrowserWindow.getAllWindows()",
      "vv": {
        "nodeType": "main-process",
        "shape": "rectangle",
        "notes": "All open windows receive broadcast events via webContents.send(). Events pushed to ALL renderer windows simultaneously."
      }
    },
    {
      "id": "worker-process",
      "type": "text",
      "x": -385,
      "y": 526,
      "width": 220,
      "height": 80,
      "text": "Worker Process (Utility)",
      "vv": {
        "nodeType": "worker-process",
        "shape": "rectangle",
        "notes": "Separate Node.js utility process. Runs @principal-ai/repository-monitoring-server. Isolates heavy I/O from main process. Communicates via process.parentPort.postMessage()."
      }
    },
    {
      "id": "git-watcher",
      "type": "text",
      "x": -707,
      "y": 762,
      "width": 150,
      "height": 60,
      "text": "GitWatcherAdapter",
      "vv": {
        "nodeType": "watcher",
        "shape": "rectangle",
        "notes": "Monitors git state changes (branch, dirty, staged, ahead/behind). Emits GIT_STATUS_CHANGED events."
      }
    },
    {
      "id": "file-tree-builder",
      "type": "text",
      "x": -449,
      "y": 750,
      "width": 150,
      "height": 60,
      "text": "FileTreeBuilder",
      "vv": {
        "nodeType": "service",
        "shape": "rectangle",
        "notes": "Creates FileTree structures. Respects .gitignore patterns. Emits fileTree cache updates."
      }
    },
    {
      "id": "package-processor",
      "type": "text",
      "x": 103,
      "y": 752,
      "width": 150,
      "height": 60,
      "text": "PackageProcessor",
      "vv": {
        "nodeType": "service",
        "shape": "rectangle",
        "notes": "Detects packages in monorepos. Scans for package.json, Cargo.toml, etc. Emits packages cache updates."
      }
    },
    {
      "id": "git-remote-service",
      "type": "text",
      "x": 389,
      "y": 753,
      "width": 150,
      "height": 60,
      "text": "GitRemoteService",
      "vv": {
        "nodeType": "service",
        "shape": "rectangle",
        "notes": "Fetches remote URL, branches, auth methods. Emits gitRemote cache updates."
      }
    },
    {
      "id": "cache-registry",
      "type": "text",
      "x": -127,
      "y": 915,
      "width": 220,
      "height": 80,
      "text": "RepositoryCacheRegistry",
      "vv": {
        "nodeType": "cache",
        "shape": "rectangle",
        "notes": "Centralized cache with 4 slices: gitStatus, fileTree, packages, gitRemote. Each slice has version, hash, timestamp. Emits CACHE_SYNC events on updates."
      }
    },
    {
      "id": "cache-slice-git",
      "type": "text",
      "x": -591,
