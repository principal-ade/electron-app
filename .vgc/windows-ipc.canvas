  "edges": [
    {
      "id": "renderer-to-preload",
      "fromNode": "renderer-process",
      "toNode": "preload",
      "label": "window.mainProcess.*",
      "vv": {
        "edgeType": "ipc",
        "notes": "Renderer calls preload APIs via global window.mainProcess object"
      }
    },
    {
      "id": "preload-to-main",
      "fromNode": "preload",
      "toNode": "main-process",
      "label": "ipcRenderer.invoke()",
      "vv": {
        "edgeType": "ipc",
        "notes": "Preload uses ipcRenderer.invoke for request/response, ipcRenderer.send for fire-and-forget"
      }
    },
    {
      "id": "main-to-preload-events",
      "fromNode": "main-process",
      "toNode": "preload",
      "label": "webContents.send()",
      "vv": {
        "edgeType": "ipc-event",
        "notes": "Main process pushes events to renderer via webContents.send(channel, data)"
      }
    },
    {
      "id": "principal-renders-renderer",
      "fromNode": "principal-window",
      "toNode": "renderer-process",
      "label": "loads",
      "vv": {
        "edgeType": "renders",
        "notes": "Each window loads renderer process with its HTML entry point"
      }
    },
    {
      "id": "repo-renders-renderer",
      "fromNode": "repo-manager",
      "toNode": "renderer-process",
      "label": "loads",
      "vv": {
        "edgeType": "renders",
        "notes": "Loads src/renderer/repo-manager/index.tsx"
      }
    },
    {
      "id": "alexandria-renders-renderer",
      "fromNode": "alexandria-workspace",
      "toNode": "renderer-process",
      "label": "loads",
      "vv": {
        "edgeType": "renders",
        "notes": "Loads src/renderer/alexandria-workspace/index.tsx"
      }
    },
    {
      "id": "dev-renders-renderer",
      "fromNode": "dev-workspace",
      "toNode": "renderer-process",
      "label": "loads",
      "vv": {
        "edgeType": "renders",
        "notes": "Loads dev workspace entry with custom preload"
      }
    },
    {
      "id": "main-uses-fs-adapter",
      "fromNode": "main-process",
      "toNode": "file-system-adapter",
      "label": "per-window",
      "vv": {
        "edgeType": "uses",
        "notes": "Each window gets its own FileSystemAdapter instance with isolated state"
      }
    },
    {
      "id": "main-uses-wm-adapter",
      "fromNode": "main-process",
      "toNode": "window-manager-adapter",
      "label": "per-window",
      "vv": {
        "edgeType": "uses",
        "notes": "Each window gets its own WindowManagerAdapter for window state"
      }
    },
    {
      "id": "main-uses-gh-adapter",
      "fromNode": "main-process",
      "toNode": "github-adapter",
      "label": "per-window",
      "vv": {
        "edgeType": "uses",
        "notes": "Each window gets its own GitHub context"
      }
    },
    {
      "id": "main-uses-terminal",
      "fromNode": "main-process",
      "toNode": "terminal-manager",
      "label": "per-window",
      "vv": {
        "edgeType": "uses",
        "notes": "PTY sessions are scoped to windows"
      }
    },
    {
      "id": "main-uses-window-manager",
      "fromNode": "main-process",
      "toNode": "modern-window-manager",
      "label": "creates windows",
      "vv": {
        "edgeType": "uses",
        "notes": "ModernWindowManager.createWindow() / createSpecialWindow()"
      }
    },
    {
      "id": "main-uses-handlers",
      "fromNode": "main-process",
      "toNode": "ipc-handlers",
      "label": "registers",
      "vv": {
        "edgeType": "uses",
        "notes": "ipcMain.handle() registered in initialization.ts"
      }
    },
    {
      "id": "preload-uses-interfaces",
      "fromNode": "preload",
      "toNode": "api-interfaces",
      "label": "implements",
      "vv": {
        "edgeType": "uses",
        "notes": "Preload implements interfaces from shared types"
      }
    },
    {
      "id": "preload-uses-implementations",
      "fromNode": "preload",
      "toNode": "api-implementations",
      "label": "exports",
      "vv": {
        "edgeType": "uses",
        "notes": "Aggregates all API implementations into mainProcess object"
      }
    },
    {
      "id": "handlers-use-channels",
      "fromNode": "ipc-handlers",
      "toNode": "event-channels",
      "label": "listens to",
      "vv": {
        "edgeType": "uses",
        "notes": "Handlers register for specific event channels"
      }
    },
    {
      "id": "implementations-use-channels",
      "fromNode": "api-implementations",
      "toNode": "event-channels",
      "label": "invokes",
      "vv": {
        "edgeType": "uses",
        "notes": "API implementations use channel enums for type-safe IPC"
      }
    }
