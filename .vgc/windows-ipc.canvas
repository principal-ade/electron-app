      "height": 80,
      "text": "Preload Bridge",
      "vv": {
        "nodeType": "preload",
        "shape": "rectangle",
        "notes": "Isolated context bridge. Exposes 40+ APIs via contextBridge.exposeInMainWorld('mainProcess', apis). File: src/window/preload.ts"
      }
    },
