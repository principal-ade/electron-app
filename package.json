{
  "name": "principal-ade",
  "version": "0.0.303",
  "description": "Principal ADE - The future of Agentic Development Environment",
  "type": "module",
  "keywords": [
    "electron",
    "react",
    "typescript",
    "ts",
    "sass",
    "webpack",
    "hot",
    "reload"
  ],
  "homepage": "https://principle-md.com",
  "bugs": {
    "url": "https://discord.gg/k5u7StPU"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a24z-ai/electron-app.git"
  },
  "license": "GPL-3.0",
  "author": {
    "name": "principle-md",
    "email": "contact@principlemd.com",
    "url": "https://principle-md.com"
  },
  "contributors": [],
  "main": "dist/main/main.js",
  "scripts": {
    "icons:generate": "python3 generate_icons.py",
    "icons:build": "npm run icons:generate",
    "icons:build:mac": "npm run icons:generate",
    "icons:build:windows": "npm run icons:generate",
    "icons:build:linux": "npm run icons:generate",
    "validate:deps": "node scripts/validate-dependencies.js",
    "download:act": "node scripts/download-act-binaries.js",
    "install:libsql": "node scripts/install-libsql-deps.js",
    "build": "npm run validate:deps && npm run install:libsql && node .erb/scripts/copy-native-deps.js && npm run download:act && npm run icons:build && npm run build:dll && concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:mac": "npm run validate:deps && npm run install:libsql && node .erb/scripts/copy-native-deps.js && npm run download:act && npm run icons:build:mac && npm run build:dll && concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:windows": "npm run validate:deps && npm run install:libsql && npm run download:act && npm run icons:build:windows && npm run build:dll && concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:linux": "npm run validate:deps && npm run install:libsql && npm run download:act && npm run icons:build:linux && npm run build:dll && concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:dll": "cross-env NODE_ENV=development TS_NODE_PROJECT=tsconfig.node.json TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.renderer.dev.dll.windows.ts",
    "build:main": "cross-env NODE_ENV=production TS_NODE_PROJECT=tsconfig.node.json TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "node -e \"process.exit(process.platform === 'win32' ? 0 : 1)\" && npm run build:renderer:windows || npm run build:renderer:unix",
    "build:renderer:unix": "cross-env NODE_ENV=production TS_NODE_PROJECT=tsconfig.node.json TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings --max-old-space-size=8192\" webpack --config ./.erb/configs/webpack.config.renderer.prod.multi.ts",
    "build:renderer:windows": "cross-env NODE_ENV=production TS_NODE_PROJECT=tsconfig.node.json TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.renderer.prod.multi.ts",
    "postinstall": "ts-node .erb/scripts/check-native-dep.js && electron-rebuild --version 38.1.0",
    "postinstall:full": "ts-node .erb/scripts/check-native-dep.js && electron-builder install-app-deps && electron-rebuild --version 38.1.0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:all": "eslint . --ignore-pattern ''",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:staged": "prettier --write \"src/main/main.ts\" \"src/window/preload.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "check:strict": "npm run typecheck:strict && npm run lint && npm run format:check",
    "fix": "npm run format && npm run lint:fix",
    "package": "npm run validate:deps && ts-node ./.erb/scripts/clean.js dist && npm run build && node --stack-size=4096 ./node_modules/.bin/electron-builder build --publish never && node .erb/scripts/staple-artifacts.js",
    "package:mac": "npm run validate:deps && ts-node ./.erb/scripts/clean.js dist && npm run build:mac && node --stack-size=4096 ./node_modules/.bin/electron-builder build --publish never && node .erb/scripts/staple-artifacts.js",
    "package:mac:with-shared": "npm run validate:deps && ts-node ./.erb/scripts/clean.js dist && npm run prepare:shared-lib && npm run build:mac && node --stack-size=4096 ./node_modules/.bin/electron-builder build --publish never && node .erb/scripts/staple-artifacts.js",
    "package:mac:npm": "npm run validate:deps && node ./.erb/scripts/build-production.js",
    "package:windows": "npm run validate:deps && ts-node ./.erb/scripts/clean.js dist && npm run build:windows && node --stack-size=4096 ./node_modules/.bin/electron-builder build --publish never",
    "package:windows:npm": "npm run validate:deps && node ./.erb/scripts/build-production-windows.js",
    "package:linux": "npm run validate:deps && ts-node ./.erb/scripts/clean.js dist && npm run build:linux && node --stack-size=4096 ./node_modules/.bin/electron-builder build --publish never",
    "release": "./release-all-platforms.sh",
    "rebuild": "node scripts/rebuild-native.js",
    "rebuild:direct": "electron-rebuild --version 38.1.0 --parallel --types prod,dev,optional --module-dir release/app",
    "prestart": "cross-env NODE_ENV=development TS_NODE_PROJECT=tsconfig.node.json TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.main.dev.ts",
    "start": "ts-node ./.erb/scripts/check-port-in-use.js && npm run prestart && npm run start:renderer",
    "dev": "node scripts/dev-with-prod-constraints.js",
    "dev:unsafe": "npm run build:dll && npm run start",
    "clean-install": "node scripts/clean-install.js",
    "clear-extensions": "node scripts/clear-extension-cache.js",
    "dev:static": "npm run prestart && npm run dev:renderer",
    "dev:renderer": "concurrently -k \"npm run dev:renderer:watch\" \"npm run dev:renderer:serve\" \"npm run start:main\" \"npm run start:preload\"",
    "dev:renderer:watch": "cross-env NODE_ENV=development TS_NODE_PROJECT=tsconfig.node.json TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings --max-old-space-size=4096\" webpack --config ./.erb/configs/webpack.config.renderer.dev.nohmr.ts",
    "dev:renderer:serve": "mkdir -p dist/renderer && sleep 5 && cd dist/renderer && npx http-server -p 1212 -c-1",
    "start:main": "concurrently -k -P \"cross-env NODE_ENV=development TS_NODE_PROJECT=tsconfig.node.json TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\\\"-r ts-node/register --no-warnings\\\" webpack --watch --config ./.erb/configs/webpack.config.main.dev.ts\" \"electronmon .erb/dll/main.bundle.dev.js\"",
    "start:preload": "cross-env NODE_ENV=development TS_NODE_PROJECT=tsconfig.node.json TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.preload.dev.ts",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_PROJECT=tsconfig.node.json TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack serve --config ./.erb/configs/webpack.config.renderer.dev.windows.ts",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:slides": "playwright test tests/e2e/slide-interactions.spec.ts",
    "test:e2e:mcp": "playwright test tests/e2e/mcp-slide-interactions.spec.ts",
    "test:e2e:validation": "playwright test tests/e2e/slide-validation.spec.ts",
    "test:e2e:keyboard": "playwright test tests/e2e/keyboard-navigation.spec.ts",
    "test:e2e:all-slides": "playwright test tests/e2e/all-slide-tests.spec.ts",
    "test:e2e:baseline": "playwright test tests/e2e/app-baseline.spec.ts",
    "playwright:install": "npm install -D playwright @playwright/test && playwright install",
    "dev:old": "npm run build:dll && npm run start",
    "dev:watch": "npm run start",
    "typecheck": "tsc --build",
    "typecheck:main": "tsc --project tsconfig.main.json --noEmit",
    "typecheck:renderer": "tsc --project tsconfig.renderer.json --noEmit",
    "typecheck:shared": "tsc --project tsconfig.shared.json --noEmit",
    "typecheck:strict": "tsc --project tsconfig.strict.json --noEmit",
    "typecheck:watch": "tsc --build --watch --noEmit",
    "typecheck:strict:watch": "tsc --project tsconfig.strict.json --noEmit --watch",
    "knip": "knip",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "browserslist": [
    "electron >= 31.0.0"
  ],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "setupFiles": [
      "./.erb/scripts/check-build-exists.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "release/app/dist",
      ".erb/dll"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react-markdown|remark-gfm|rehype-raw|rehype-highlight|hast-util-sanitize|unist-util-position|globby|@principal-ai|@sindresorhus|path-type|slash|unicorn-magic)/)"
    ]
  },
