<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Principal ADE</title>
    <style>
      /* Digital matrix grid fallback theme */
      html, body {
        margin: 0;
        padding: 0;
        background: rgba(0, 0, 0, 0.5);
        background-image:
          linear-gradient(rgba(128, 128, 128, 0.15) 1px, transparent 1px),
          linear-gradient(90deg, rgba(128, 128, 128, 0.15) 1px, transparent 1px);
        background-size: 20px 20px;
        color: rgba(128, 128, 128, 0.8);
        height: 100vh;
        overflow: hidden;
        font-family: 'Courier New', monospace;
      }
      #root {
        height: 100vh;
        width: 100vw;
        background: transparent;
      }
    </style>
    <script>
      // Define global before any other scripts load
      window.global = window.global || window;
      // Also define process if it doesn't exist
      if (typeof process === "undefined") {
        window.process = {
          env: {},
          version: 'v16.0.0',
          platform: 'browser',
          arch: 'browser'
        };
      }
    </script>
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
