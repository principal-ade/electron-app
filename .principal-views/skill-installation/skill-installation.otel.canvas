{
  "pv": {
    "name": "Skill Installation",
    "version": "1.0.0",
    "description": "Flow for browsing, installing, and managing skills in agent directories (Claude, OpenCode, Cursor, Windsurf)",
    "markdown": ".principal-views/skill-installation/skill-installation.md",
    "nodeTypes": {
      "ui-component": {
        "label": "UI Component",
        "color": "#3B82F6"
      },
      "renderer-service": {
        "label": "Renderer Service",
        "color": "#8B5CF6"
      },
      "ipc-handler": {
        "label": "IPC Handler",
        "color": "#22C55E"
      },
      "external-api": {
        "label": "External API",
        "color": "#F59E0B"
      },
      "filesystem": {
        "label": "Filesystem",
        "color": "#EC4899"
      },
      "error-state": {
        "label": "Error State",
        "color": "#EF4444"
      },
      "event": {
        "label": "Event",
        "color": "#3B82F6"
      },
      "boundary": {
        "label": "Boundary",
        "color": "#64748B"
      }
    },
    "edgeTypes": {
      "user-action": {
        "label": "User Action",
        "style": "solid",
        "color": "#3B82F6"
      },
      "ipc-call": {
        "label": "IPC Call",
        "style": "solid",
        "color": "#22C55E"
      },
      "function-call": {
        "label": "Function Call",
        "style": "solid",
        "color": "#8B5CF6"
      },
      "file-operation": {
        "label": "File Operation",
        "style": "dashed",
        "color": "#EC4899"
      },
      "http-request": {
        "label": "HTTP Request",
        "style": "solid",
        "color": "#F59E0B"
      },
      "error-flow": {
        "label": "Error Flow",
        "style": "dashed",
        "color": "#EF4444"
      }
    }
  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 400,
      "y": -100,
      "width": 500,
      "height": 60,
      "color": "#64748B",
      "text": "# Skill Installation\n**Browse, install, and manage skills for Claude, OpenCode, Cursor, Windsurf**"
    },
    {
      "id": "skill-browser-view",
      "type": "otel-event",
      "x": -152,
      "y": 36,
      "width": 220,
      "height": 100,
      "label": "SkillBrowserView",
      "shape": "rectangle",
      "event": {
        "name": "skill.ui.view_opened",
        "description": "User opens the skill browser view",
        "attributes": {
          "view.mode": {
            "type": "string",
            "description": "Current view mode: browse or installed"
          },
          "skills.installed_count": {
            "type": "number",
            "description": "Number of currently installed skills"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "install-toolbar",
      "type": "otel-event",
      "x": -284,
      "y": 199,
      "width": 220,
      "height": 100,
      "label": "InstallSkillToolbar",
      "shape": "rectangle",
      "event": {
        "name": "skill.ui.install_clicked",
        "description": "User clicks install button on skill toolbar",
        "attributes": {
          "skill.name": {
            "type": "string",
            "description": "Name of skill being installed"
          },
          "skill.source_repo": {
            "type": "string",
            "description": "GitHub repository source"
          },
          "skill.current_status": {
            "type": "string",
            "description": "Current status: not_installed, installed, update_available"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "installation-modal",
      "type": "otel-event",
      "x": -284,
      "y": 391,
      "width": 220,
      "height": 100,
      "label": "SkillInstallationModal",
      "shape": "rectangle",
      "event": {
        "name": "skill.ui.modal_confirmed",
        "description": "User confirms skill installation with selected directories",
        "attributes": {
          "skill.name": {
            "type": "string",
            "description": "Name of skill being installed"
          },
          "directories.selected": {
            "type": "array",
            "description": "Array of selected directory IDs"
          },
          "directories.count": {
            "type": "number",
            "description": "Number of directories selected for installation"
          },
          "action.type": {
            "type": "string",
            "description": "Action type: install, uninstall, update"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "github-service",
      "type": "otel-event",
      "x": 205,
      "y": 113,
      "width": 220,
      "height": 100,
      "label": "GithubService",
      "shape": "rectangle",
      "event": {
        "name": "skill.service.install_requested",
        "description": "Renderer service initiates skill installation request",
        "attributes": {
          "skill.name": {
            "type": "string",
            "description": "Skill name"
          },
          "github.url": {
            "type": "string",
            "description": "GitHub URL of skill"
          },
          "destination.type": {
            "type": "string",
            "description": "Destination type: global-universal, global-claude, project-claude, etc."
          },
          "files.count": {
            "type": "number",
            "description": "Number of files to install"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "filesystem-service",
      "type": "otel-event",
      "x": 82,
      "y": 237,
      "width": 220,
      "height": 100,
      "label": "FileSystemService",
      "shape": "rectangle",
      "event": {
        "name": "skill.service.directories_detected",
        "description": "Service detects available agent directories",
        "attributes": {
          "directories.count": {
            "type": "number",
            "description": "Number of directories detected"
          },
          "directories.types": {
            "type": "array",
            "description": "Types of directories found: claude, opencode, cursor, windsurf"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "skill-lock-service",
      "type": "otel-event",
      "x": 80,
      "y": 362,
      "width": 220,
      "height": 100,
      "label": "SkillLockService",
      "shape": "rectangle",
      "event": {
        "name": "skill.service.lock_checked",
        "description": "Service checks skill lock file for metadata",
        "attributes": {
          "skill.name": {
            "type": "string",
            "description": "Skill name being checked"
          },
          "skill.installed": {
            "type": "boolean",
            "description": "Whether skill is in lock file"
          },
          "skill.sha": {
            "type": "string",
            "description": "Current installed SHA"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "ipc-install-skill",
      "type": "otel-event",
      "x": 530,
      "y": -15,
      "width": 200,
      "height": 100,
      "label": "IPC Handler",
      "shape": "rectangle",
      "event": {
        "name": "skill.ipc.install_received",
        "description": "Main process receives install skill request via IPC",
        "attributes": {
          "skill.name": {
            "type": "string",
            "description": "Skill name"
          },
          "github.url": {
            "type": "string",
            "description": "GitHub URL"
          },
          "install_destination": {
            "type": "string",
            "description": "Installation destination"
          },
          "files.count": {
            "type": "number",
            "description": "Number of files to download"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "ipc-detect-dirs",
      "type": "otel-event",
      "x": 439,
      "y": 247,
      "width": 200,
      "height": 80,
      "label": "IPC Handler",
      "shape": "rectangle",
      "event": {
        "name": "skill.ipc.detect_dirs_received",
        "description": "Main process receives detect directories request",
        "attributes": {
          "scan.scope": {
            "type": "string",
            "description": "Scope of directory scan"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "ipc-skill-lock",
      "type": "otel-event",
      "x": 470,
      "y": 373,
      "width": 200,
      "height": 80,
      "label": "IPC Handler",
      "shape": "rectangle",
      "event": {
        "name": "skill.ipc.lock_operation",
        "description": "Main process handles skill lock file operation",
        "attributes": {
          "operation": {
            "type": "string",
            "description": "Operation: get, add, remove, update"
          },
          "skill.name": {
            "type": "string",
            "description": "Skill name"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "github-api",
      "type": "otel-event",
      "x": 820,
      "y": -15,
      "width": 200,
      "height": 100,
      "label": "GitHub API",
      "shape": "rectangle",
      "event": {
        "name": "skill.github.files_downloaded",
        "description": "Files downloaded from GitHub repository",
        "attributes": {
          "github.owner": {
            "type": "string",
            "description": "Repository owner"
          },
          "github.repo": {
            "type": "string",
            "description": "Repository name"
          },
          "files.downloaded": {
            "type": "number",
            "description": "Number of files downloaded"
          },
          "bytes.total": {
            "type": "number",
            "description": "Total bytes downloaded"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "canonical-write",
      "type": "otel-event",
      "x": 1090,
      "y": -5,
      "width": 200,
      "height": 80,
      "label": "Canonical Location",
      "shape": "rectangle",
      "event": {
        "name": "skill.fs.canonical_written",
        "description": "Skill files written to canonical location",
        "attributes": {
          "path": {
            "type": "string",
            "description": "Canonical path: ~/.agents/skills/{skillName}"
          },
          "files.written": {
            "type": "number",
            "description": "Number of files written"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "symlink-creation",
      "type": "otel-event",
      "x": 1090,
      "y": 150,
      "width": 200,
      "height": 80,
      "label": "Symlinks Created",
      "shape": "rectangle",
      "event": {
        "name": "skill.fs.symlinks_created",
        "description": "Symlinks created in agent-specific directories",
        "attributes": {
          "symlinks.count": {
            "type": "number",
            "description": "Number of symlinks created"
          },
          "target_directories": {
            "type": "array",
            "description": "Target directories for symlinks"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "lock-file-update",
      "type": "otel-event",
      "x": 1090,
      "y": 297,
      "width": 200,
      "height": 80,
      "label": "Lock File Updated",
      "shape": "rectangle",
      "event": {
        "name": "skill.lock.updated",
        "description": "Skill lock file updated with installation metadata",
        "attributes": {
          "skill.name": {
            "type": "string",
            "description": "Installed skill name"
          },
          "skill.sha": {
            "type": "string",
            "description": "Git tree SHA"
          },
          "skill.source": {
            "type": "string",
            "description": "Source GitHub URL"
          },
          "installed_at": {
            "type": "string",
            "description": "Installation timestamp"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "operation-success",
      "type": "otel-event",
      "x": 766,
      "y": 124,
      "width": 200,
      "height": 80,
      "label": "Installation Success",
      "shape": "rectangle",
      "event": {
        "name": "skill.install.success",
        "description": "Skill installation completed successfully",
        "attributes": {
          "skill.name": {
            "type": "string",
            "description": "Installed skill name"
          },
          "installed.path": {
            "type": "string",
            "description": "Path where skill was installed"
          },
          "files.installed": {
            "type": "number",
            "description": "Number of files installed"
          },
          "duration_ms": {
            "type": "number",
            "description": "Installation duration in milliseconds"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "operation-error",
      "type": "otel-event",
      "x": 942,
      "y": 395,
      "width": 200,
      "height": 80,
      "label": "Installation Error",
      "shape": "rectangle",
      "event": {
        "name": "skill.install.error",
        "description": "Skill installation failed",
        "attributes": {
          "skill.name": {
            "type": "string",
            "description": "Skill that failed to install"
          },
          "error.message": {
            "type": "string",
            "description": "Error message"
          },
          "error.type": {
            "type": "string",
            "description": "Error type: network_error, write_failed, permission_denied"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "ui-refresh",
      "type": "otel-event",
      "x": 347,
      "y": 500,
      "width": 220,
      "height": 80,
      "label": "UI State Refreshed",
      "shape": "rectangle",
      "event": {
        "name": "skill.ui.state_refreshed",
        "description": "UI state refreshed after installation",
        "attributes": {
          "skill.name": {
            "type": "string",
            "description": "Skill that was installed"
          },
          "ui.new_status": {
            "type": "string",
            "description": "New installation status"
          },
          "directories.installed": {
            "type": "number",
            "description": "Number of directories where skill is now installed"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "ui-error-shown",
      "type": "otel-event",
      "x": 205,
      "y": 607,
      "width": 220,
      "height": 80,
      "label": "Error Displayed",
      "shape": "rectangle",
      "event": {
        "name": "skill.ui.error_displayed",
        "description": "Error message displayed to user",
        "attributes": {
          "error.message": {
            "type": "string",
            "description": "Error message shown to user"
          },
          "skill.name": {
            "type": "string",
            "description": "Skill that failed"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "agent-setup-modal",
      "type": "otel-event",
      "x": -152,
      "y": 530,
      "width": 220,
      "height": 100,
      "label": "AgentSetupModal",
      "shape": "rectangle",
      "event": {
        "name": "skill.ui.agent_setup_opened",
        "description": "User opens agent setup modal to create directories",
        "attributes": {
          "existing_dirs": {
            "type": "array",
            "description": "Currently existing agent directories"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "supported-destinations",
      "type": "text",
      "x": 548,
      "y": 658,
      "width": 200,
      "height": 120,
      "text": "**Destinations**\n- global-universal\n- global-claude\n- global-opencode\n- global-cursor\n- global-windsurf\n- project-claude",
      "color": "#64748B"
    },
    {
      "id": "install-options",
      "type": "text",
      "x": 706,
      "y": 542,
      "width": 200,
      "height": 120,
      "text": "**InstallSkillOptions**\n- githubUrl\n- skillPath\n- destination\n- repositoryPath\n- fileList\n- skillTreeSha",
      "color": "#64748B"
    }
  ],
  "edges": [
    {
      "id": "browser-to-toolbar",
      "fromNode": "skill-browser-view",
      "fromSide": "bottom",
      "toNode": "install-toolbar",
      "toSide": "top",
      "label": "select skill",
      "pv": {
        "edgeType": "user-action"
      }
    },
    {
      "id": "toolbar-to-modal",
      "fromNode": "install-toolbar",
      "fromSide": "bottom",
      "toNode": "installation-modal",
      "toSide": "top",
      "label": "click install",
      "pv": {
        "edgeType": "user-action"
      }
    },
    {
      "id": "browser-to-github-service",
      "fromNode": "skill-browser-view",
      "fromSide": "right",
      "toNode": "github-service",
      "toSide": "left",
      "label": "getTree()",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "browser-to-fs-service",
      "fromNode": "skill-browser-view",
      "fromSide": "right",
      "toNode": "filesystem-service",
      "toSide": "left",
      "label": "getAllLocalSkills()",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "toolbar-to-lock-service",
      "fromNode": "install-toolbar",
      "fromSide": "right",
      "toNode": "skill-lock-service",
      "toSide": "left",
      "label": "getSkillEntry()",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "modal-to-github-service",
      "fromNode": "installation-modal",
      "fromSide": "right",
      "toNode": "github-service",
      "toSide": "left",
      "label": "installSkill()",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "github-service-to-ipc",
      "fromNode": "github-service",
      "fromSide": "right",
      "toNode": "ipc-install-skill",
      "toSide": "left",
      "label": "INSTALL_SKILL",
      "pv": {
        "edgeType": "ipc-call"
      }
    },
    {
      "id": "fs-service-to-ipc",
      "fromNode": "filesystem-service",
      "fromSide": "right",
      "toNode": "ipc-detect-dirs",
      "toSide": "left",
      "label": "DETECT_PRESET_DIRS",
      "pv": {
        "edgeType": "ipc-call"
      }
    },
    {
      "id": "lock-service-to-ipc",
      "fromNode": "skill-lock-service",
      "fromSide": "right",
      "toNode": "ipc-skill-lock",
      "toSide": "left",
      "label": "GET_SKILL_LOCK",
      "pv": {
        "edgeType": "ipc-call"
      }
    },
    {
      "id": "ipc-to-github-api",
      "fromNode": "ipc-install-skill",
      "fromSide": "right",
      "toNode": "github-api",
      "toSide": "left",
      "label": "fetch files",
      "pv": {
        "edgeType": "http-request"
      }
    },
    {
      "id": "github-to-canonical",
      "fromNode": "github-api",
      "fromSide": "right",
      "toNode": "canonical-write",
      "toSide": "left",
      "label": "write files",
      "pv": {
        "edgeType": "file-operation"
      }
    },
    {
      "id": "canonical-to-symlinks",
      "fromNode": "canonical-write",
      "fromSide": "bottom",
      "toNode": "symlink-creation",
      "toSide": "top",
      "label": "create symlinks",
      "pv": {
        "edgeType": "file-operation"
      }
    },
    {
      "id": "symlinks-to-lock",
      "fromNode": "symlink-creation",
      "fromSide": "bottom",
      "toNode": "lock-file-update",
      "toSide": "top",
      "label": "update metadata",
      "pv": {
        "edgeType": "file-operation"
      }
    },
    {
      "id": "ipc-to-success",
      "fromNode": "ipc-install-skill",
      "fromSide": "bottom",
      "toNode": "operation-success",
      "toSide": "top",
      "label": "success",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "ipc-to-error",
      "fromNode": "ipc-install-skill",
      "fromSide": "bottom",
      "toNode": "operation-error",
      "toSide": "top",
      "label": "catch error",
      "pv": {
        "edgeType": "error-flow"
      }
    },
    {
      "id": "success-to-service",
      "fromNode": "operation-success",
      "fromSide": "left",
      "toNode": "github-service",
      "toSide": "right",
      "label": "return result",
      "pv": {
        "edgeType": "ipc-call"
      }
    },
    {
      "id": "error-to-service",
      "fromNode": "operation-error",
      "fromSide": "left",
      "toNode": "github-service",
      "toSide": "right",
      "label": "return error",
      "pv": {
        "edgeType": "error-flow"
      }
    },
    {
      "id": "service-to-ui-refresh",
      "fromNode": "github-service",
      "fromSide": "bottom",
      "toNode": "ui-refresh",
      "toSide": "top",
      "label": "update state",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "service-to-ui-error",
      "fromNode": "github-service",
      "fromSide": "bottom",
      "toNode": "ui-error-shown",
      "toSide": "top",
      "label": "show error",
      "pv": {
        "edgeType": "error-flow"
      }
    },
    {
      "id": "browser-to-agent-setup",
      "fromNode": "skill-browser-view",
      "fromSide": "bottom",
      "toNode": "agent-setup-modal",
      "toSide": "top",
      "label": "setup agents",
      "pv": {
        "edgeType": "user-action"
      }
    }
  ]
}
