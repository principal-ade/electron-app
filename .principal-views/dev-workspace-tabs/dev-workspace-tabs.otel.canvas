      "y": 400,
      "width": 140,
      "height": 100,
      "label": "MediaViewerPanel",
      "shape": "rectangle",
      "event": {
        "name": "devworkspace.panel.media.rendered",
        "description": "Media viewer panel for images (png, jpg, gif, webp, svg, etc.) and videos (mp4, webm, mov, etc.)",
        "attributes": {
          "file.path": {
            "type": "string",
            "description": "Media file path"
          },
          "file.name": {
            "type": "string",
            "description": "Media file name"
          },
          "media.type": {
            "type": "string",
            "description": "Media type (image or video)"
          }
        }
