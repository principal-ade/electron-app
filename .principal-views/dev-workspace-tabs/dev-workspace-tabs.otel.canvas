    {
      "id": "key-diff",
      "type": "text",
      "x": 730,
      "y": 520,
      "width": 400,
      "height": 100,
      "color": "#64748B",
      "text": "## Key: Event name determines handler\n\nTab events → Tab handlers → Create/focus tab → TabbedTerminalPanel\nPanel events → Panel handlers → setActiveFile → MarkdownPanel\n\n**file:open** routes by extension: .md/.mdx → Markdown, images/videos → MediaViewer, others → FileEditor/GitDiff"
    }
  ],
  "edges": [
    {
      "id": "trigger-tab-to-bus",
      "fromNode": "trigger-tab-intent",
      "fromSide": "right",
      "toNode": "event-bus",
      "toSide": "left",
      "label": "emit",
      "edgeType": "subscription"
    },
    {
      "id": "trigger-panel-to-bus",
      "fromNode": "trigger-panel-intent",
      "fromSide": "right",
      "toNode": "event-bus",
      "toSide": "left",
      "label": "emit",
      "edgeType": "subscription"
    },
    {
      "id": "bus-to-tab-handlers",
      "fromNode": "event-bus",
      "fromSide": "right",
      "toNode": "handler-tab-events",
      "toSide": "left",
      "label": "dispatch",
      "edgeType": "uses"
    },
    {
      "id": "bus-to-panel-handlers",
      "fromNode": "event-bus",
      "fromSide": "right",
      "toNode": "handler-panel-events",
      "toSide": "left",
      "label": "dispatch",
      "edgeType": "uses"
    },
    {
      "id": "tab-handler-to-loop",
      "fromNode": "handler-tab-events",
      "fromSide": "right",
      "toNode": "loop-check",
      "toSide": "left",
      "label": "check",
      "edgeType": "uses"
    },
    {
      "id": "loop-to-existing",
      "fromNode": "loop-check",
      "fromSide": "bottom",
      "toNode": "check-existing-tab",
      "toSide": "top",
      "label": "proceed",
      "edgeType": "uses"
    },
    {
      "id": "existing-to-create",
      "fromNode": "check-existing-tab",
      "fromSide": "right",
      "toNode": "create-focus-tab",
      "toSide": "left",
      "label": "create/focus",
      "edgeType": "uses"
    },
    {
      "id": "create-to-render",
      "fromNode": "create-focus-tab",
      "fromSide": "bottom",
      "toNode": "render-tab",
      "toSide": "top",
      "label": "render",
      "edgeType": "renders"
    },
    {
      "id": "render-to-tabbed",
      "fromNode": "render-tab",
      "fromSide": "right",
      "toNode": "tabbed-terminal-panel",
      "toSide": "left",
      "label": "in",
      "edgeType": "renders"
    },
    {
      "id": "panel-handler-to-active",
      "fromNode": "handler-panel-events",
      "fromSide": "right",
      "toNode": "set-active-file",
      "toSide": "left",
      "label": "call",
      "edgeType": "uses"
    },
    {
      "id": "active-to-layout",
      "fromNode": "set-active-file",
      "fromSide": "right",
      "toNode": "change-layout",
      "toSide": "left",
      "label": "then",
      "edgeType": "uses"
    },
    {
      "id": "layout-to-markdown",
      "fromNode": "change-layout",
      "fromSide": "right",
      "toNode": "markdown-panel",
      "toSide": "left",
      "label": "render",
      "edgeType": "renders"
    },
    {
      "id": "render-to-media",
      "fromNode": "render-tab",
      "fromSide": "bottom",
      "toNode": "media-viewer-panel",
      "toSide": "top",
      "label": "media files",
      "edgeType": "renders"
    }
  ],
