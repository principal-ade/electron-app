{
  "pv": {
    "name": "Agent Event Flow to Renderer",
    "version": "1.0.0",
    "nodeTypes": {
      "utility-process": {
        "label": "Utility Process",
        "color": "#EF4444"
      },
      "main-process": {
        "label": "Main Process",
        "color": "#4F46E5"
      },
      "event-manager": {
        "label": "Event Manager",
        "color": "#7C3AED"
      },
      "cache": {
        "label": "Session Cache",
        "color": "#8B5CF6"
      },
      "ipc-handler": {
        "label": "IPC Handler",
        "color": "#6366F1"
      },
      "preload": {
        "label": "Preload Script",
        "color": "#14B8A6"
      },
      "renderer-api": {
        "label": "Renderer API",
        "color": "#10B981"
      },
      "service": {
        "label": "Service Layer",
        "color": "#22C55E"
      },
      "context": {
        "label": "React Context",
        "color": "#84CC16"
      },
      "component": {
        "label": "Component",
        "color": "#EAB308"
      },
      "interface": {
        "label": "Interface",
        "color": "#64748B"
      }
    },
    "edgeTypes": {
      "event-flow": {
        "label": "Event Flow",
        "style": "solid",
        "color": "#7C3AED",
        "animation": {
          "type": "flow",
          "duration": 1500
        }
      },
      "ipc": {
        "label": "IPC",
        "style": "solid",
        "color": "#6366F1"
      },
      "broadcast": {
        "label": "Broadcast",
        "style": "dashed",
        "color": "#F59E0B",
        "animation": {
          "type": "pulse",
          "duration": 1000
        }
      },
      "subscribe": {
        "label": "Subscribe",
        "style": "dotted",
        "color": "#22C55E"
      },
      "uses": {
        "label": "Uses",
        "style": "dotted",
        "color": "#64748B"
      }
    }
  },
  "nodes": [
    {
      "id": "group-main",
      "type": "group",
      "x": -71,
      "y": 341,
      "width": 720,
      "height": 380,
      "label": "Main Process"
    },
    {
      "id": "group-renderer",
      "type": "group",
      "x": 739,
      "y": -448,
      "width": 480,
      "height": 700,
      "label": "Renderer Process"
    },
    {
      "id": "event-server",
      "type": "text",
      "x": 199,
      "y": -203,
      "width": 200,
      "height": 80,
      "text": "Event Processing Server\n(Utility Process)",
      "pv": {
        "nodeType": "utility-process",
