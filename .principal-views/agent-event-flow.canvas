  ],
  "edges": [
    {
      "id": "server-to-manager",
      "fromNode": "event-server",
      "toNode": "event-server-manager",
      "label": "ProcessedEventMessage",
      "pv": {
        "edgeType": "event-flow"
      }
    },
    {
      "id": "manager-to-cache",
      "fromNode": "event-server-manager",
      "toNode": "session-cache",
      "label": "emit('processed-event')",
      "pv": {
        "edgeType": "event-flow"
      }
    },
    {
      "id": "cache-to-handlers",
      "fromNode": "session-cache",
      "toNode": "sdk-handlers",
      "label": "provides data",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "manager-to-broadcast",
      "fromNode": "event-server-manager",
      "toNode": "broadcast-node",
      "label": "handleProcessedEvent()",
      "pv": {
        "edgeType": "event-flow"
      }
    },
    {
      "id": "broadcast-to-events",
      "fromNode": "broadcast-node",
      "toNode": "event-types",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "broadcast-to-preload",
      "fromNode": "broadcast-node",
      "toNode": "preload",
      "label": "IPC Channel",
      "pv": {
        "edgeType": "broadcast"
      }
    },
    {
      "id": "preload-to-api",
      "fromNode": "preload",
      "toNode": "renderer-api-impl",
      "label": "exposes API",
      "pv": {
        "edgeType": "ipc"
      }
    },
    {
      "id": "api-to-service",
      "fromNode": "renderer-api-impl",
      "toNode": "sdk-service",
      "label": "wrapped by",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "service-to-context",
      "fromNode": "sdk-service",
      "toNode": "agent-highlight-context",
      "label": "onProcessedEvent()",
      "pv": {
        "edgeType": "subscribe"
      }
    },
    {
      "id": "context-to-highlight",
      "fromNode": "agent-highlight-context",
      "toNode": "event-highlight-service",
      "label": "service.processEvent()",
      "pv": {
        "edgeType": "event-flow"
      }
    },
    {
      "id": "context-to-view",
      "fromNode": "agent-highlight-context",
      "toNode": "session-events-view",
      "label": "provides events",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "highlight-to-codacity",
      "fromNode": "event-highlight-service",
      "toNode": "code-city",
      "label": "emit('highlight-update')",
      "pv": {
        "edgeType": "event-flow"
      }
    },
    {
      "id": "manager-uses-interface",
      "fromNode": "event-server-manager",
      "toNode": "event-interface",
      "pv": {
        "edgeType": "uses"
      }
    }
  ]
}