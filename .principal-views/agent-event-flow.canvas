    {
      "id": "event-interface",
      "type": "text",
      "x": 28,
      "y": 146,
      "width": 220,
      "height": 100,
      "text": "RepoNormalized\nUniversalAgentSessionEvent\n(@principal-ai/agent-monitoring)",
      "pv": {
