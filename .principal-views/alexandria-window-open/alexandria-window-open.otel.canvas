            }
          }
        }
      }
    },
    {
      "id": "open-failed",
      "type": "text",
      "text": "# Open Failed\n\nWindow open failed due to error",
      "x": 1535,
      "y": 341,
      "width": 250,
      "height": 80,
      "color": "#ef4444",
      "pv": {
        "nodeType": "main-process",
