            "repository.id": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "id": "window-creating",
      "type": "text",
      "text": "# Creating Window\n\nNew BrowserWindow being created",
      "x": 872,
      "y": 699,
      "width": 200,
      "height": 80,
      "color": "#4f46e5",
      "pv": {
        "nodeType": "main-process",
