{
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "text": "# Alexandria Window Opening Flow\n\nTelemetry-traced lifecycle from user trigger to ready state",
      "x": 300,
      "y": -180,
      "width": 450,
      "height": 80,
      "color": "#8b5cf6",
      "pv": {
        "name": "Window Open Flow",
        "references": [
          "src/main/window/modernWindowHandlers.ts"
        ],
        "status": "draft",
        "event": {
          "name": "alexandria.window.open.flow",
          "attributes": {
            "flow.name": {
              "type": "string",
              "value": "alexandria-window-open"
            }
          }
        }
      }
    },
    {
      "id": "trigger",
      "type": "otel-event",
      "x": -3,
      "y": 0,
      "width": 280,
      "height": 220,
      "color": "#22c55e",
      "label": "User Trigger",
      "icon": "Mouse",
      "event": {
        "name": "alexandria.window.open.requested",
        "attributes": {
          "workspace.id": {
            "type": "string",
            "description": "Workspace UUID if opening named workspace"
          },
          "repository.path": {
            "type": "string",
            "description": "Local path if opening single repo"
          },
          "repository.id": {
            "type": "string",
            "description": "PURL or GitHub ID"
          },
          "trigger.source": {
            "type": "string",
            "description": "Where the open was triggered from"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "window-service",
      "type": "otel-event",
      "x": 350,
      "y": 0,
      "width": 300,
      "height": 200,
      "color": "#06b6d4",
      "label": "Window Service",
      "icon": "Zap",
      "event": {
        "name": "alexandria.window.ipc.invoke",
        "attributes": {
          "ipc.channel": {
            "type": "string",
            "value": "window:open-alexandria-workspace"
          },
          "workspace.id": {
            "type": "string"
          },
          "has.repository.path": {
            "type": "boolean"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "ipc-handler",
      "type": "otel-event",
      "x": 720,
      "y": 0,
      "width": 280,
      "height": 220,
      "color": "#ef4444",
      "label": "IPC Handler",
      "icon": "Server",
      "event": {
        "name": "alexandria.window.handler.received",
        "attributes": {
          "window.name": {
            "type": "string",
            "description": "Unique window identifier"
          },
          "window.mode": {
            "type": "string",
            "description": "workspace or temp"
          },
          "workspace.name": {
            "type": "string",
            "description": "Display name for titlebar"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "registry-lookup",
      "type": "otel-event",
      "x": 720,
      "y": 290,
      "width": 280,
      "height": 180,
      "color": "#ef4444",
      "label": "Registry Lookup",
      "icon": "Database",
      "event": {
        "name": "alexandria.workspace.lookup",
        "attributes": {
          "workspace.id": {
            "type": "string"
          },
          "workspace.found": {
            "type": "boolean"
          },
          "workspace.name": {
            "type": "string"
          },
          "repository.count": {
            "type": "number"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "create-window",
      "type": "otel-event",
      "x": 350,
      "y": 280,
      "width": 300,
      "height": 200,
      "color": "#4f46e5",
      "label": "Create Window",
      "icon": "Box",
      "event": {
        "name": "window.createSpecial",
        "attributes": {
          "window.purpose": {
            "type": "string"
          },
          "window.reused": {
            "type": "boolean"
          },
          "window.id": {
            "type": "number"
          },
          "window.type": {
            "type": "string",
            "description": "secondary or minimal"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/main/window/modernWindowManager.ts"
        ]
      }
    },
    {
      "id": "terminal-register",
      "type": "otel-event",
      "x": 0,
      "y": 310,
      "width": 280,
      "height": 140,
      "color": "#818cf8",
      "label": "Terminal Register",
      "icon": "Monitor",
      "event": {
        "name": "terminal.window.registered",
        "attributes": {
          "window.id": {
            "type": "number"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "watch-acquire",
      "type": "otel-event",
      "x": -4,
      "y": 589,
      "width": 280,
      "height": 240,
      "color": "#0d9488",
      "label": "Watch Acquire",
      "icon": "Eye",
      "event": {
        "name": "alexandria.watches.acquired",
        "attributes": {
          "window.id": {
            "type": "number"
          },
          "watch.reference.id": {
            "type": "string"
          },
          "repositories.total": {
            "type": "number"
          },
          "repositories.watched": {
            "type": "number"
          },
          "repositories.failed": {
            "type": "number"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "load-url",
      "type": "otel-event",
      "x": 317,
      "y": 617,
      "width": 300,
      "height": 180,
      "color": "#4f46e5",
      "label": "Load URL",
      "icon": "Globe",
      "event": {
        "name": "window.loadURL",
        "attributes": {
          "window.id": {
            "type": "number"
          },
          "url.path": {
            "type": "string"
          },
          "url.has.workspace.id": {
            "type": "boolean"
          },
          "url.has.repository.path": {
            "type": "boolean"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "app-init",
      "type": "otel-event",
      "x": 325,
      "y": 876,
      "width": 280,
      "height": 240,
      "color": "#22c55e",
      "label": "App Init",
      "icon": "Play",
      "event": {
        "name": "alexandria.app.initialized",
        "attributes": {
          "workspace.id": {
            "type": "string"
          },
          "workspace.name": {
            "type": "string"
          },
          "repository.count": {
            "type": "number"
          },
          "layout.panels": {
            "type": "string",
            "description": "Comma-separated panel IDs"
          },
          "init.duration.ms": {
            "type": "number"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "window-ready",
      "type": "otel-event",
      "x": 339,
      "y": 1188,
      "width": 250,
      "height": 200,
      "color": "#22c55e",
      "label": "Window Ready",
      "icon": "Check",
      "event": {
        "name": "alexandria.window.ready",
        "attributes": {
          "window.id": {
            "type": "number"
          },
          "window.name": {
            "type": "string"
          },
          "workspace.id": {
            "type": "string"
          },
          "total.duration.ms": {
            "type": "number"
          },
          "watches.active": {
            "type": "number"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "workspace-found",
      "type": "otel-event",
      "x": 735,
      "y": 502,
      "width": 250,
      "height": 100,
      "color": "#22c55e",
      "label": "Workspace Found",
      "icon": "CheckCircle",
      "event": {
        "name": "alexandria.workspace.found",
        "attributes": {
          "workspace.id": {
            "type": "string"
          },
          "workspace.name": {
            "type": "string"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "workspace-not-found",
      "type": "otel-event",
      "x": 1198,
      "y": 331,
      "width": 250,
      "height": 100,
      "color": "#ef4444",
      "label": "Workspace Not Found",
      "icon": "XCircle",
      "event": {
        "name": "alexandria.workspace.not_found",
        "attributes": {
          "workspace.id": {
            "type": "string"
          },
          "error.message": {
            "type": "string"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "temp-mode",
      "type": "otel-event",
      "x": 1030,
      "y": 504,
      "width": 250,
      "height": 100,
      "color": "#f59e0b",
      "label": "Temp Mode",
      "icon": "Clock",
      "event": {
        "name": "alexandria.window.temp.mode",
        "attributes": {
          "repository.path": {
            "type": "string"
          },
          "repository.id": {
            "type": "string"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "window-creating",
      "type": "otel-event",
      "x": 872,
      "y": 699,
      "width": 200,
      "height": 80,
      "color": "#4f46e5",
      "label": "Creating Window",
      "icon": "Plus",
      "event": {
        "name": "alexandria.window.creating",
        "attributes": {
          "window.name": {
            "type": "string"
          },
          "window.type": {
            "type": "string"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "window-reusing",
      "type": "otel-event",
      "x": 651,
      "y": 701,
      "width": 200,
      "height": 80,
      "color": "#06b6d4",
      "label": "Reusing Window",
      "icon": "RotateCw",
      "event": {
        "name": "alexandria.window.reusing",
        "attributes": {
          "window.id": {
            "type": "number"
          },
          "window.name": {
            "type": "string"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "open-failed",
      "type": "otel-event",
      "x": 1535,
      "y": 341,
      "width": 250,
      "height": 80,
      "color": "#ef4444",
      "label": "Open Failed",
      "icon": "AlertTriangle",
      "event": {
        "name": "alexandria.window.open.failed",
        "attributes": {
          "error.message": {
            "type": "string"
          },
          "error.code": {
            "type": "string"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    }
  ],
  "edges": [
    {
      "id": "title-to-trigger",
      "fromNode": "title",
      "toNode": "trigger",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "uses",
        "style": "dashed"
      }
    },
    {
      "id": "trigger-to-service",
      "fromNode": "trigger",
      "toNode": "window-service",
      "fromSide": "right",
      "toSide": "left",
      "label": "calls",
      "pv": {
        "edgeType": "uses",
        "style": "solid"
      }
    },
    {
      "id": "service-to-ipc",
      "fromNode": "window-service",
      "toNode": "ipc-handler",
      "fromSide": "right",
      "toSide": "left",
      "label": "IPC invoke",
      "pv": {
        "edgeType": "ipc",
        "style": "solid",
        "animation": {
          "type": "flow",
          "duration": 1500,
          "color": "#6366f1"
        }
      }
    },
    {
      "id": "ipc-to-registry",
      "fromNode": "ipc-handler",
      "toNode": "registry-lookup",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "fetch workspace",
      "pv": {
        "edgeType": "uses",
        "style": "solid"
      }
    },
    {
      "id": "ipc-to-create",
      "fromNode": "ipc-handler",
      "toNode": "create-window",
      "fromSide": "left",
      "toSide": "right",
      "label": "createSpecialWindow",
      "pv": {
        "edgeType": "uses",
        "style": "solid"
      }
    },
    {
      "id": "create-to-terminal",
      "fromNode": "create-window",
      "toNode": "terminal-register",
      "fromSide": "left",
      "toSide": "right",
      "label": "register",
      "pv": {
        "edgeType": "uses",
        "style": "solid"
      }
    },
    {
      "id": "create-to-watches",
      "fromNode": "create-window",
      "toNode": "watch-acquire",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "async",
      "pv": {
        "edgeType": "ipc",
        "style": "dashed"
      }
    },
    {
      "id": "create-to-load",
      "fromNode": "create-window",
      "toNode": "load-url",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "loadURL",
      "pv": {
        "edgeType": "uses",
        "style": "solid"
      }
    },
    {
      "id": "registry-to-create",
      "fromNode": "registry-lookup",
      "toNode": "create-window",
      "fromSide": "left",
      "toSide": "right",
      "label": "workspace data",
      "pv": {
        "edgeType": "uses",
        "style": "dashed"
      }
    },
    {
      "id": "registry-to-not-found",
      "fromNode": "registry-lookup",
      "toNode": "workspace-not-found",
      "fromSide": "right",
      "toSide": "left",
      "label": "not found",
      "pv": {
        "edgeType": "uses",
        "style": "dashed"
      }
    },
    {
      "id": "found-to-creating",
      "fromNode": "workspace-found",
      "toNode": "window-creating",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "new window",
      "pv": {
        "edgeType": "uses",
        "style": "solid"
      }
    },
    {
      "id": "found-to-reusing",
      "fromNode": "workspace-found",
      "toNode": "window-reusing",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "existing window",
      "pv": {
        "edgeType": "uses",
        "style": "dashed"
      }
    },
    {
      "id": "creating-to-create",
      "fromNode": "window-creating",
      "toNode": "create-window",
      "fromSide": "top",
      "toSide": "bottom",
      "label": "proceed",
      "pv": {
        "edgeType": "uses",
        "style": "solid"
      }
    },
    {
      "id": "reusing-to-create",
      "fromNode": "window-reusing",
      "toNode": "create-window",
      "fromSide": "top",
      "toSide": "bottom",
      "label": "focus",
      "pv": {
        "edgeType": "uses",
        "style": "solid"
      }
    },
    {
      "id": "handler-to-temp",
      "fromNode": "ipc-handler",
      "toNode": "temp-mode",
      "fromSide": "right",
      "toSide": "top",
      "label": "no workspace ID",
      "pv": {
        "edgeType": "uses",
        "style": "dashed"
      }
    },
    {
      "id": "edge-app-init-window-ready-1772376603448",
      "fromNode": "app-init",
      "toNode": "window-ready",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "ipc-event"
      }
    },
    {
      "id": "edge-load-url-app-init-1772376603448",
      "fromNode": "load-url",
      "toNode": "app-init",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "renders"
      }
    },
    {
      "id": "edge-registry-lookup-workspace-found-1772376603448",
      "fromNode": "registry-lookup",
      "toNode": "workspace-found",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "edge-temp-mode-window-creating-1772376603448",
      "fromNode": "temp-mode",
      "toNode": "window-creating",
      "fromSide": "bottom",
      "toSide": "top",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "edge-workspace-not-found-open-failed-1772376689406",
      "fromNode": "workspace-not-found",
      "toNode": "open-failed",
      "fromSide": "right",
      "toSide": "left",
      "pv": {
        "edgeType": "uses"
      }
    }
  ],
  "pv": {
    "version": "1.0",
    "name": "Alexandria Window Opening Flow",
    "description": "OTEL-traced lifecycle of opening an Alexandria Workspace window - from user trigger through IPC to ready state",
    "markdown": ".principal-views/alexandria-window-open/alexandria-window-open.md",
    "scope": "principal-ade-main",
    "display": {
      "layout": "manual",
      "theme": {
        "primary": "#8b5cf6",
        "success": "#22c55e",
        "danger": "#ef4444",
        "warning": "#eab308",
        "info": "#06b6d4"
      }
    },
    "nodeTypes": {
      "event": {
        "label": "Event",
        "color": "#3B82F6"
      },
      "boundary": {
        "label": "Boundary",
        "color": "#64748B"
      }
    }
  }
}
