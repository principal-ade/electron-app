{
  "version": "1.0.0",
  "name": "Quality Tool Execution",
  "description": "Monitors quality tool execution from UI click to results display",
  "canvas": ".principal-views/quality-panel-interaction/quality-panel-interaction.otel.canvas",
  "spanPattern": "quality.tool.completed",
  "scenarios": [
    {
      "id": "full-tool-execution",
      "description": "Full flow from user clicking 'Run' to results displayed in panel",
      "priority": 1,
      "template": {
        "introduction": "**Quality Tool Execution**\n\nExecuting quality tool `{{tool.name}}` for `{{package.path}}`",
        "events": {
          "quality.tool.requested": "1. User clicked run for `{{tool.name}}` on {{package.path}}",
          "quality.ipc.received": "2. IPC received: execute-tool for {{tool.name}} on {{repository.path}}",
          "quality.service.executing": "3. QualityLensService executing {{tool.name}} via {{lens.name}} for {{package.path}}",
          "quality.lens.running": "4. Lens running: {{lens.name}} in {{lens.cwd}}",
          "quality.executor.spawning": "5. Executor spawning: `{{command.name}}` {{command.args}}",
          "quality.cli.completed": "6. CLI {{tool.name}} completed (exit: {{exit.code}}, {{duration.ms}}ms)",
          "quality.tool.completed": "7. **Tool complete** - {{tool.name}}: success={{success}}, {{issues.count}} issues, {{duration.ms}}ms"
        },
        "summary": "**Execution Summary:**\n- Tool: {{tool.name}}\n- Exit Code: {{exit.code}}\n- Duration: {{duration.ms}}ms\n- Issues Found: {{issues.count}}"
      }
    },
    {
      "id": "tool-execution-error",
      "description": "Flow when tool execution fails",
      "priority": 2,
      "template": {
        "introduction": "**Tool Execution Failed**\n\nFailed to execute `{{tool.name}}`",
        "events": {
          "quality.tool.requested": "1. User clicked run for `{{tool.name}}` on {{package.path}}",
          "quality.ipc.received": "2. IPC received for {{tool.name}} on {{repository.path}}",
          "quality.service.executing": "3. QualityLensService executing {{tool.name}} via {{lens.name}} for {{package.path}}",
          "quality.tool.error": "4. **Error**: {{error.message}} (code: {{error.code}}) for {{tool.name}}",
          "quality.tool.completed": "5. Tool {{tool.name}} completed with error (success={{success}}, {{issues.count}} issues, {{duration.ms}}ms)"
        },
        "summary": "**Error Details:**\n- Tool: {{tool.name}}\n- Error: {{error.message}}\n- Code: {{error.code}}"
      }
    }
  ]
}
