{
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 300,
      "y": -100,
      "width": 500,
      "height": 60,
      "color": "#64748B",
      "text": "# Quality Panel Interaction Flow\n**From navigation to tool execution and visualization**"
    },
    {
      "id": "panel-sidebar",
      "type": "otel-event",
      "x": 50,
      "y": 0,
      "width": 180,
      "height": 80,
      "label": "Panel Icon Sidebar",
      "shape": "rectangle",
      "event": {
        "name": "quality.sidebar.clicked",
        "description": "User clicked Quality icon in panel sidebar",
        "attributes": {
          "panel.id": {
            "type": "string",
            "description": "Panel ID being switched to (codeQuality)"
          },
          "panel.previous": {
            "type": "string",
            "description": "Previously active panel ID"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "panel-framework",
      "type": "otel-event",
      "x": 280,
      "y": 0,
      "width": 200,
      "height": 80,
      "label": "DevWorkspace",
      "shape": "rectangle",
      "event": {
        "name": "quality.panel.switched",
        "description": "Panel framework switched to quality panel",
        "attributes": {
          "panel.id": {
            "type": "string",
            "description": "Active panel ID"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "quality-panel",
      "type": "otel-event",
      "x": 530,
      "y": 0,
      "width": 200,
      "height": 80,
      "label": "QualityHexagonPanel",
      "shape": "rectangle",
      "event": {
        "name": "quality.panel.rendered",
        "description": "Quality hexagon panel rendered",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository path"
          },
          "quality.hasData": {
            "type": "boolean",
            "description": "Whether quality data is available"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "repository-context",
      "type": "otel-event",
      "x": 530,
      "y": 130,
      "width": 200,
      "height": 100,
      "label": "RepositoryPanelContext",
      "shape": "rectangle",
      "event": {
        "name": "quality.context.updated",
        "description": "Quality data updated in React context",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository path"
          },
          "quality.packages.count": {
            "type": "number",
            "description": "Number of packages with quality data"
          },
          "quality.lastUpdated": {
            "type": "number",
            "description": "Timestamp of quality data"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "hexagon-click",
      "type": "otel-event",
      "x": 780,
      "y": 0,
      "width": 180,
      "height": 80,
      "label": "Hexagon Facet Click",
      "shape": "rectangle",
      "event": {
        "name": "quality.colorMode.selected",
        "description": "User selected color mode from quality hexagon",
        "attributes": {
          "colorMode.name": {
            "type": "string",
            "description": "Selected color mode name"
          },
          "colorMode.previous": {
            "type": "string",
            "description": "Previous color mode"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "file-city",
      "type": "otel-event",
      "x": 780,
      "y": 130,
      "width": 180,
      "height": 80,
      "label": "File City",
      "shape": "rectangle",
      "event": {
        "name": "quality.fileCity.rerendered",
        "description": "File City re-rendered with quality color mode",
        "attributes": {
          "colorMode.name": {
            "type": "string",
            "description": "Active color mode"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "run-tool-button",
      "type": "otel-event",
      "x": 50,
      "y": 280,
      "width": 180,
      "height": 80,
      "label": "Run Tool Button",
      "shape": "rectangle",
      "event": {
        "name": "quality.tool.requested",
        "description": "User requested tool execution",
        "attributes": {
          "tool.name": {
            "type": "string",
            "description": "Tool name (eslint, jest, tsc, knip)"
          },
          "package.path": {
            "type": "string",
            "description": "Package path for tool execution"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "ipc-handler",
      "type": "otel-event",
      "x": 280,
      "y": 280,
      "width": 200,
      "height": 80,
      "label": "IPC Handler",
      "shape": "rectangle",
      "event": {
        "name": "quality.ipc.received",
        "description": "IPC handler received tool execution request",
        "attributes": {
          "tool.name": {
            "type": "string",
            "description": "Requested tool name"
          },
          "repository.path": {
            "type": "string",
            "description": "Repository path"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "quality-lens-service",
      "type": "otel-event",
      "x": 530,
      "y": 280,
      "width": 200,
      "height": 80,
      "label": "QualityLensService",
      "shape": "rectangle",
      "event": {
        "name": "quality.service.executing",
        "description": "QualityLensService executing tool request",
        "attributes": {
          "tool.name": {
            "type": "string",
            "description": "Tool being executed"
          },
          "lens.name": {
            "type": "string",
            "description": "Lens used for execution"
          },
          "package.path": {
            "type": "string",
            "description": "Package path"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "quality-lens",
      "type": "otel-event",
      "x": 530,
      "y": 400,
      "width": 200,
      "height": 100,
      "label": "Quality Lens",
      "shape": "rectangle",
      "event": {
        "name": "quality.lens.running",
        "description": "Quality lens running tool pipeline",
        "attributes": {
          "lens.name": {
            "type": "string",
            "description": "Lens name"
          },
          "lens.cwd": {
            "type": "string",
            "description": "Working directory"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "cli-executor",
      "type": "otel-event",
      "x": 780,
      "y": 280,
      "width": 200,
      "height": 80,
      "label": "ElectronCLIBridge",
      "shape": "rectangle",
      "event": {
        "name": "quality.executor.spawning",
        "description": "Executor spawning CLI process",
        "attributes": {
          "command.name": {
            "type": "string",
            "description": "Command being executed"
          },
          "command.args": {
            "type": "string",
            "description": "Command arguments"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "external-tools",
      "type": "otel-event",
      "x": 780,
      "y": 400,
      "width": 200,
      "height": 100,
      "label": "External CLI Tools",
      "shape": "rectangle",
      "event": {
        "name": "quality.cli.completed",
        "description": "External CLI tool completed execution",
        "attributes": {
          "tool.name": {
            "type": "string",
            "description": "Tool name"
          },
          "exit.code": {
            "type": "number",
            "description": "Exit code"
          },
          "duration.ms": {
            "type": "number",
            "description": "Execution duration in ms"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "tool-result",
      "type": "otel-event",
      "x": 1030,
      "y": 280,
      "width": 180,
      "height": 80,
      "label": "Tool Result",
      "shape": "rectangle",
      "event": {
        "name": "quality.tool.completed",
        "description": "Tool execution completed with results",
        "attributes": {
          "tool.name": {
            "type": "string",
            "description": "Tool name"
          },
          "success": {
            "type": "boolean",
            "description": "Whether execution succeeded"
          },
          "issues.count": {
            "type": "number",
            "description": "Number of issues found"
          },
          "duration.ms": {
            "type": "number",
            "description": "Total execution duration"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "github-api",
      "type": "otel-boundary",
      "x": 50,
      "y": 550,
      "width": 180,
      "height": 80,
      "label": "GitHub Actions API",
      "shape": "rectangle",
      "otel": {
        "status": "draft"
      },
      "boundary": {
        "direction": "outbound",
        "node": {
          "pv.event.name": "quality.artifact.step.api.calling"
        }
      }
    },
    {
      "id": "artifact-data",
      "type": "otel-event",
      "x": 280,
      "y": 550,
      "width": 200,
      "height": 80,
      "label": "Quality Artifact",
      "shape": "rectangle",
      "event": {
        "name": "quality.artifact.received",
        "description": "Quality artifact data received from GitHub",
        "attributes": {
          "packages.count": {
            "type": "number",
            "description": "Number of packages in artifact"
          },
          "artifact.timestamp": {
            "type": "number",
            "description": "When artifact was created"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "artifact-not-found",
      "type": "otel-event",
      "x": 530,
      "y": 550,
      "width": 180,
      "height": 80,
      "label": "Artifact Not Found",
      "shape": "rectangle",
      "event": {
        "name": "quality.artifact.notFound",
        "description": "No quality artifacts found in GitHub Actions",
        "attributes": {
          "github.owner": {
            "type": "string",
            "description": "GitHub repository owner"
          },
          "github.repo": {
            "type": "string",
            "description": "GitHub repository name"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "tool-error",
      "type": "otel-event",
      "x": 1030,
      "y": 400,
      "width": 180,
      "height": 80,
      "label": "Tool Error",
      "shape": "rectangle",
      "event": {
        "name": "quality.tool.error",
        "description": "Tool execution encountered an error",
        "attributes": {
          "tool.name": {
            "type": "string",
            "description": "Tool that failed"
          },
          "error.message": {
            "type": "string",
            "description": "Error message"
          },
          "error.code": {
            "type": "string",
            "description": "Error code if available"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "artifact-step-remote",
      "type": "otel-event",
      "x": 50,
      "y": 700,
      "width": 160,
      "height": 70,
      "label": "Step: Get Remote",
      "shape": "rectangle",
      "event": {
        "name": "quality.artifact.step.remote",
        "description": "Starting to get git remote URL",
        "attributes": {
          "step": {
            "type": "string",
            "description": "Step description"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "artifact-step-remote-resolved",
      "type": "otel-event",
      "x": 230,
      "y": 700,
      "width": 160,
      "height": 70,
      "label": "Remote Resolved",
      "shape": "rectangle",
      "event": {
        "name": "quality.artifact.step.remote.resolved",
        "description": "Git remote URL resolved",
        "attributes": {
          "step": {
            "type": "string",
            "description": "Step description"
          },
          "remote.url": {
            "type": "string",
            "description": "Git remote URL"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "artifact-step-github-parsed",
      "type": "otel-event",
      "x": 410,
      "y": 700,
      "width": 160,
      "height": 70,
      "label": "GitHub Parsed",
      "shape": "rectangle",
      "event": {
        "name": "quality.artifact.step.github.parsed",
        "description": "GitHub owner/repo parsed from remote URL",
        "attributes": {
          "step": {
            "type": "string",
            "description": "Step description"
          },
          "github.owner": {
            "type": "string",
            "description": "GitHub repository owner"
          },
          "github.repo": {
            "type": "string",
            "description": "GitHub repository name"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "artifact-step-branch",
      "type": "otel-event",
      "x": 590,
      "y": 700,
      "width": 160,
      "height": 70,
      "label": "Step: Get Branch",
      "shape": "rectangle",
      "event": {
        "name": "quality.artifact.step.branch",
        "description": "Starting to get current branch",
        "attributes": {
          "step": {
            "type": "string",
            "description": "Step description"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "artifact-step-branch-resolved",
      "type": "otel-event",
      "x": 770,
      "y": 700,
      "width": 160,
      "height": 70,
      "label": "Branch Resolved",
      "shape": "rectangle",
      "event": {
        "name": "quality.artifact.step.branch.resolved",
        "description": "Current branch resolved",
        "attributes": {
          "step": {
            "type": "string",
            "description": "Step description"
          },
          "git.branch": {
            "type": "string",
            "description": "Current git branch"
          },
          "git.branchSource": {
            "type": "string",
            "description": "How branch was determined"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "artifact-step-api-calling",
      "type": "otel-event",
      "x": 950,
      "y": 700,
      "width": 160,
      "height": 70,
      "label": "Step: API Call",
      "shape": "rectangle",
      "event": {
        "name": "quality.artifact.step.api.calling",
        "description": "Calling GitHub Actions API",
        "attributes": {
          "step": {
            "type": "string",
            "description": "Step description"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "artifact-step-api-complete",
      "type": "otel-event",
      "x": 1130,
      "y": 700,
      "width": 160,
      "height": 70,
      "label": "API Complete",
      "shape": "rectangle",
      "event": {
        "name": "quality.artifact.step.api.complete",
        "description": "GitHub API call completed",
        "attributes": {
          "step": {
            "type": "string",
            "description": "Step description"
          },
          "api.duration.ms": {
            "type": "number",
            "description": "API call duration in milliseconds"
          },
          "api.found": {
            "type": "boolean",
            "description": "Whether artifact was found"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "artifact-skipped",
      "type": "otel-event",
      "x": 770,
      "y": 550,
      "width": 180,
      "height": 80,
      "label": "Artifact Skipped",
      "shape": "rectangle",
      "event": {
        "name": "quality.artifact.skipped",
        "description": "Artifact fetch skipped (no git remote or not GitHub)",
        "attributes": {
          "message": {
            "type": "string",
            "description": "Skip reason message"
          },
          "skip.reason": {
            "type": "string",
            "description": "Skip reason code (no_git_remote, not_github)"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    }
  ],
  "edges": [
    {
      "id": "sidebar-to-framework",
      "fromNode": "panel-sidebar",
      "fromSide": "right",
      "toNode": "panel-framework",
      "toSide": "left",
      "label": "onPanelChange",
      "edgeType": "uses"
    },
    {
      "id": "framework-to-panel",
      "fromNode": "panel-framework",
      "fromSide": "right",
      "toNode": "quality-panel",
      "toSide": "left",
      "label": "mounts panel",
      "edgeType": "uses"
    },
    {
      "id": "panel-to-context",
      "fromNode": "quality-panel",
      "fromSide": "bottom",
      "toNode": "repository-context",
      "toSide": "top",
      "label": "reads qualitySlice",
      "edgeType": "uses"
    },
    {
      "id": "panel-to-hexagon",
      "fromNode": "quality-panel",
      "fromSide": "right",
      "toNode": "hexagon-click",
      "toSide": "left",
      "label": "user clicks facet",
      "edgeType": "uses"
    },
    {
      "id": "hexagon-to-context",
      "fromNode": "hexagon-click",
      "fromSide": "bottom",
      "toNode": "repository-context",
      "toSide": "right",
      "label": "quality:colorMode:select",
      "edgeType": "subscription"
    },
    {
      "id": "context-to-filecity",
      "fromNode": "repository-context",
      "fromSide": "right",
      "toNode": "file-city",
      "toSide": "left",
      "label": "colorMode update",
      "edgeType": "uses"
    },
    {
      "id": "run-to-ipc",
      "fromNode": "run-tool-button",
      "fromSide": "right",
      "toNode": "ipc-handler",
      "toSide": "left",
      "label": "IPC invoke",
      "edgeType": "ipc"
    },
    {
      "id": "ipc-to-service",
      "fromNode": "ipc-handler",
      "fromSide": "right",
      "toNode": "quality-lens-service",
      "toSide": "left",
      "label": "executeTool()",
      "edgeType": "uses"
    },
    {
      "id": "service-to-lens",
      "fromNode": "quality-lens-service",
      "fromSide": "bottom",
      "toNode": "quality-lens",
      "toSide": "top",
      "label": "find & configure lens",
      "edgeType": "uses"
    },
    {
      "id": "service-to-executor",
      "fromNode": "quality-lens-service",
      "fromSide": "right",
      "toNode": "cli-executor",
      "toSide": "left",
      "label": "uses executor",
      "edgeType": "uses"
    },
    {
      "id": "lens-to-executor",
      "fromNode": "quality-lens",
      "fromSide": "right",
      "toNode": "cli-executor",
      "toSide": "bottom",
      "label": "execute()",
      "edgeType": "uses"
    },
    {
      "id": "executor-to-tools",
      "fromNode": "cli-executor",
      "fromSide": "bottom",
      "toNode": "external-tools",
      "toSide": "top",
      "label": "child_process.spawn",
      "edgeType": "uses"
    },
    {
      "id": "tools-to-result",
      "fromNode": "external-tools",
      "fromSide": "right",
      "toNode": "tool-result",
      "toSide": "bottom",
      "label": "stdout/stderr",
      "edgeType": "uses"
    },
    {
      "id": "executor-to-result",
      "fromNode": "cli-executor",
      "fromSide": "right",
      "toNode": "tool-result",
      "toSide": "left",
      "label": "parse output",
      "edgeType": "uses"
    },
    {
      "id": "github-to-artifact",
      "fromNode": "github-api",
      "fromSide": "right",
      "toNode": "artifact-data",
      "toSide": "left",
      "label": "HTTP GET",
      "edgeType": "http"
    },
    {
      "id": "artifact-to-context",
      "fromNode": "artifact-data",
      "fromSide": "right",
      "toNode": "repository-context",
      "toSide": "bottom",
      "label": "setQualityData",
      "edgeType": "uses"
    },
    {
      "id": "service-to-error",
      "fromNode": "quality-lens-service",
      "fromSide": "bottom",
      "toNode": "tool-error",
      "toSide": "top",
      "label": "on error",
      "edgeType": "uses"
    },
    {
      "id": "github-to-notfound",
      "fromNode": "github-api",
      "fromSide": "right",
      "toNode": "artifact-not-found",
      "toSide": "left",
      "label": "404 / empty",
      "edgeType": "http"
    },
    {
      "id": "step-remote-to-resolved",
      "fromNode": "artifact-step-remote",
      "fromSide": "right",
      "toNode": "artifact-step-remote-resolved",
      "toSide": "left",
      "label": "git remote",
      "edgeType": "uses"
    },
    {
      "id": "step-resolved-to-github",
      "fromNode": "artifact-step-remote-resolved",
      "fromSide": "right",
      "toNode": "artifact-step-github-parsed",
      "toSide": "left",
      "label": "parse URL",
      "edgeType": "uses"
    },
    {
      "id": "step-github-to-branch",
      "fromNode": "artifact-step-github-parsed",
      "fromSide": "right",
      "toNode": "artifact-step-branch",
      "toSide": "left",
      "label": "next step",
      "edgeType": "uses"
    },
    {
      "id": "step-branch-to-resolved",
      "fromNode": "artifact-step-branch",
      "fromSide": "right",
      "toNode": "artifact-step-branch-resolved",
      "toSide": "left",
      "label": "git status",
      "edgeType": "uses"
    },
    {
      "id": "step-branch-to-api",
      "fromNode": "artifact-step-branch-resolved",
      "fromSide": "right",
      "toNode": "artifact-step-api-calling",
      "toSide": "left",
      "label": "call API",
      "edgeType": "uses"
    },
    {
      "id": "step-api-to-complete",
      "fromNode": "artifact-step-api-calling",
      "fromSide": "right",
      "toNode": "artifact-step-api-complete",
      "toSide": "left",
      "label": "HTTP response",
      "edgeType": "http"
    },
    {
      "id": "step-api-to-received",
      "fromNode": "artifact-step-api-complete",
      "fromSide": "top",
      "toNode": "artifact-data",
      "toSide": "bottom",
      "label": "artifact found",
      "edgeType": "uses"
    },
    {
      "id": "step-api-to-notfound",
      "fromNode": "artifact-step-api-complete",
      "fromSide": "top",
      "toNode": "artifact-not-found",
      "toSide": "bottom",
      "label": "not found",
      "edgeType": "uses"
    },
    {
      "id": "step-remote-to-skipped",
