    {
      "id": "auth-state-cleared",
      "type": "otel-event",
      "x": 690,
      "y": 57,
      "width": 200,
      "height": 100,
      "label": "Auth State Cleared",
      "icon": "Database",
      "shape": "roundedRect",
      "description": "Clear in-memory authentication state in AuthStateManager",
      "event": {
        "name": "auth.state.cleared",
        "attributes": {
          "previous_user.login": {
            "type": "string",
            "required": false,
            "description": "Username that was logged in"
          },
          "state_manager.instance_id": {
            "type": "string",
            "required": false,
            "description": "AuthStateManager instance identifier"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-main",
        "files": [
          "src/main/services/AuthStateManager.ts"
        ]
      }
    },
