{
  "name": "Authentication - User Logout",
  "markdown": ".principal-views/authentication/authentication.md",
  "nodes": [
    {
      "id": "user-logout-initiated",
      "type": "otel-event",
      "x": -27,
      "y": 46,
      "width": 200,
      "height": 100,
      "label": "Logout Initiated",
      "icon": "LogOut",
      "shape": "roundedRect",
      "description": "User initiates logout from UI (Auth view or settings)",
      "event": {
        "name": "auth.logout.initiated",
        "attributes": {
          "user.login": {
            "type": "string",
            "required": true,
            "description": "GitHub username of user logging out"
          },
          "source": {
            "type": "string",
            "required": true,
            "description": "UI component that triggered logout"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-principal-window",
        "files": [
          "src/renderer/hooks/useAuthState.ts"
        ]
      }
    },
    {
      "id": "token-deletion-github",
      "type": "otel-event",
      "x": 312,
      "y": -28,
      "width": 200,
      "height": 100,
      "label": "Delete GitHub Token",
      "icon": "Key",
      "shape": "roundedRect",
      "description": "Delete GitHub token from UnifiedSecureStorage keychain",
      "event": {
        "name": "auth.token.deleted",
        "attributes": {
          "token.key": {
            "type": "string",
            "required": true,
            "description": "Token key (GITHUB_TOKEN)"
          },
          "success": {
            "type": "boolean",
            "required": true,
            "description": "Whether deletion succeeded"
          },
          "error.message": {
            "type": "string",
            "required": false,
            "description": "Error message if deletion failed"
          },
          "error.type": {
            "type": "string",
            "required": false,
            "description": "Error type (KeychainTimeout, KeychainPermission, KeychainNotAvailable)"
          },
          "duration_ms": {
            "type": "number",
            "required": false,
            "description": "Time taken to delete token"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-main",
        "files": [
          "src/main/services/AuthService.ts",
          "src/main/services/UnifiedSecureStorage.ts"
        ]
      }
    },
