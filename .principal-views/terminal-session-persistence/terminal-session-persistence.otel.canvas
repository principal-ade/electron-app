{
  "pv": {
    "name": "Terminal Session Persistence",
    "version": "1.0.0",
    "description": "External PTY daemon architecture for preserving terminal sessions across app updates",
    "markdown": ".principal-views/terminal-session-persistence/terminal-session-persistence.md",
    "nodeTypes": {
      "electron": {
        "label": "Electron",
        "color": "#10B981"
      },
      "daemon-client": {
        "label": "Daemon Client",
        "color": "#6366F1"
      },
      "socket": {
        "label": "Socket",
        "color": "#14B8A6"
      },
      "daemon": {
        "label": "PTY Daemon",
        "color": "#F59E0B"
      },
      "pty": {
        "label": "PTY Process",
        "color": "#8B5CF6"
      },
      "update": {
        "label": "Update",
        "color": "#EC4899"
      },
      "renderer": {
        "label": "Renderer",
        "color": "#3B82F6"
      }
    },
    "edgeTypes": {
      "socket-ipc": {
        "label": "Socket IPC",
        "style": "solid",
        "color": "#14B8A6"
      },
      "method-call": {
        "label": "Method Call",
        "style": "solid",
        "color": "#F59E0B"
      },
      "spawn": {
        "label": "Spawn",
        "style": "dashed",
        "color": "#8B5CF6"
      },
