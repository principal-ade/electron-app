  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 200,
      "y": -150,
      "width": 600,
      "height": 60,
      "color": "#64748B",
      "text": "# Terminal Session Persistence\n**External PTY Daemon for Update Survival**"
    },
    {
      "id": "electron-boundary",
      "type": "text",
      "x": -50,
      "y": -50,
      "width": 450,
      "height": 400,
      "color": "#10B981",
      "text": "ELECTRON APP PROCESS"
    },
    {
      "id": "session-manager",
      "type": "text",
      "x": 0,
      "y": 20,
      "width": 200,
      "height": 100,
      "text": "TerminalSessionManager\n\n.createSession()\n.restoreSessions()\n.prepareForRestart()",
      "pv": {
        "nodeType": "electron",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/main/terminal/TerminalSessionManager.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "files": [
            "src/main/terminal/TerminalSessionManager.ts"
          ]
        },
        "event": {
          "name": "terminal.persistence.manager_action",
          "description": "Session manager coordinating with daemon",
          "attributes": {
            "action": {
              "type": "string",
              "description": "create, restore, prepareForRestart"
            },
            "session.count": {
              "type": "number",
              "description": "Number of sessions involved"
            }
          }
        }
      }
    },
    {
      "id": "daemon-client",
      "type": "text",
      "x": 0,
      "y": 170,
      "width": 200,
      "height": 120,
      "text": "PtyDaemonClient\n\n.connect()\n.createSession()\n.listSessions()\n.onReconnected()",
      "pv": {
        "nodeType": "daemon-client",
        "shape": "rectangle",
        "status": "draft",
        "references": [],
        "otel": {
          "kind": "event",
          "category": "ipc",
          "files": []
        },
        "event": {
          "name": "terminal.daemon.client_action",
          "description": "Daemon client communicating with PTY daemon",
          "attributes": {
            "action": {
              "type": "string",
              "description": "connect, send, reconnect"
            },
            "message.type": {
              "type": "string",
              "description": "Protocol message type"
            }
          }
        }
      }
    },
    {
      "id": "renderer",
      "type": "text",
      "x": 230,
      "y": 20,
      "width": 150,
      "height": 100,
      "text": "Renderer\n\nTerminal UI\nxterm.js\nMessagePort",
      "pv": {
        "nodeType": "renderer",
        "shape": "rectangle",
        "status": "approved",
        "references": [
          "src/renderer/contexts/TerminalContext.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ui",
          "files": [
            "src/renderer/contexts/TerminalContext.tsx"
          ]
        },
        "event": {
          "name": "terminal.renderer.data_received",
          "description": "Renderer received terminal data via MessagePort",
