    {
      "id": "worker-data-flow",
      "type": "text",
      "x": 1345,
      "y": 285,
      "width": 280,
      "height": 180,
      "color": "#A855F7",
      "text": "WORKER DATA PATH\n(Bypasses Main Process)\n\nPTY Output:\nDaemon → Socket → Worker\n→ port1 → port2 → Renderer\n\nUser Input:\nRenderer → port2 → port1\n→ Worker → Socket → Daemon\n\n✓ Main process NOT involved"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "fromNode": "session-manager",
      "toNode": "daemon-client",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "delegates to",
      "pv": {
        "edgeType": "method-call"
      }
    },
    {
      "id": "e2",
      "fromNode": "daemon-client",
      "toNode": "unix-socket",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "net.connect()",
      "pv": {
        "edgeType": "socket-ipc"
      }
    },
    {
      "id": "e3",
      "fromNode": "unix-socket",
      "toNode": "daemon-server",
      "fromSide": "bottom",
      "toSide": "top",
