{
  "pv": {
    "name": "Terminal Session Persistence",
    "version": "1.0.0",
    "description": "External PTY daemon architecture for preserving terminal sessions across app updates",
    "markdown": ".principal-views/terminal-session-persistence/terminal-session-persistence.md",
    "scope": "principal-ade-daemon",
    "nodeTypes": {
      "electron": {
        "label": "Electron",
        "color": "#10B981"
      },
      "daemon-client": {
        "label": "Daemon Client",
        "color": "#6366F1"
      },
      "worker": {
        "label": "Utility Worker",
        "color": "#A855F7"
      },
      "socket": {
        "label": "Socket",
        "color": "#14B8A6"
      },
      "daemon": {
        "label": "PTY Daemon",
        "color": "#F59E0B"
      },
      "pty": {
        "label": "PTY Process",
        "color": "#8B5CF6"
      },
      "update": {
        "label": "Update",
        "color": "#EC4899"
      },
      "renderer": {
        "label": "Renderer",
        "color": "#3B82F6"
      },
      "event": {
        "label": "Event",
        "color": "#3B82F6"
      },
      "boundary": {
        "label": "Boundary",
        "color": "#64748B"
      }
    },
    "edgeTypes": {
      "socket-ipc": {
        "label": "Socket IPC",
        "style": "solid",
        "color": "#14B8A6"
      },
      "method-call": {
        "label": "Method Call",
        "style": "solid",
        "color": "#F59E0B"
      },
      "spawn": {
        "label": "Spawn",
        "style": "dashed",
        "color": "#8B5CF6"
      },
      "lifecycle": {
        "label": "Lifecycle",
        "style": "dotted",
        "color": "#EC4899"
      },
      "port-transfer": {
        "label": "Port Transfer",
        "style": "solid",
        "color": "#3B82F6"
      }
    }
  },
  "nodes": [
    {
      "id": "title",
