        "event": {
          "name": "terminal.pty.resize",
          "description": "PTY process resized",
          "attributes": {
            "session.id": {
              "type": "string",
              "description": "Terminal session ID"
            },
            "cols": {
              "type": "number",
              "description": "Column count"
            },
            "rows": {
              "type": "number",
              "description": "Row count"
            }
          }
