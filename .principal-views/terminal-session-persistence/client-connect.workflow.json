{
  "version": "1.0.0",
  "name": "Client Connect",
  "description": "Electron app connecting to PTY daemon, starting daemon if needed",
  "mode": "span-tree",
  "canvas": ".principal-views/terminal-session-persistence/terminal-session-persistence.otel.canvas",
  "spanPattern": "terminal.daemon.client",
  "scenarios": [
    {
      "id": "connect-daemon-running",
      "description": "Connect to already running daemon",
      "priority": 1,
      "template": {
        "introduction": "**Connecting to PTY Daemon**\n\nDaemon already running, connecting via socket.",
        "events": {
          "terminal.daemon.client_connecting": "[1] Connecting to `{{socket.path}}`",
          "terminal.daemon.client_connected": "[2] Connected successfully",
          "terminal.daemon.sessions_received": "[3] Received {{sessions.count}} existing sessions"
        },
        "summary": "**Connected**\n- Existing sessions: {{sessions.count}}"
      },
      "filterDefault": false
    },
    {
      "id": "connect-spawn-daemon",
      "description": "No daemon running, spawn new daemon process",
      "priority": 2,
      "template": {
        "introduction": "**Starting PTY Daemon**\n\nNo daemon found, spawning new process.",
        "events": {
          "terminal.daemon.client_connect_failed": "[1] Socket not found, spawning daemon",
          "terminal.daemon.spawn_started": "[2] Spawning daemon process (detached)",
          "terminal.daemon.spawn_waiting": "[3] Waiting for socket...",
          "terminal.daemon.client_connected": "[4] Connected to new daemon",
          "terminal.daemon.sessions_received": "[5] Sessions: {{sessions.count}} (fresh start)"
        },
        "summary": "**Daemon Started**\n- New daemon spawned\n- Sessions: {{sessions.count}}"
      },
      "filterDefault": false
    },
    {
      "id": "connect-reconnect",
      "description": "Reconnecting after daemon disconnect",
      "priority": 3,
      "template": {
        "introduction": "**Reconnecting to Daemon**\n\nConnection lost, attempting reconnection.",
        "events": {
          "terminal.daemon.client_disconnected": "[1] Connection lost",
          "terminal.daemon.reconnect_scheduled": "[2] Reconnect scheduled in {{delay}}ms",
          "terminal.daemon.client_reconnecting": "[3] Attempting reconnection...",
          "terminal.daemon.client_connected": "[4] Reconnected successfully",
          "terminal.daemon.sessions_synced": "[5] Session state synchronized"
        },
        "summary": "**Reconnected**\n- Sessions preserved: {{sessions.count}}"
      },
      "filterDefault": false
    }
  ]
}
