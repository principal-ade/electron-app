{
  "version": "1.0.0",
  "name": "Client Connect",
  "description": "Electron app connecting to PTY daemon, starting daemon if needed",
  "canvas": ".principal-views/terminal-session-persistence/terminal-session-persistence.otel.canvas",
  "spanPattern": "terminal.daemon.client",
  "scenarios": [
    {
      "id": "connect-existing-daemon",
      "description": "Connect to already running daemon with existing sessions",
      "priority": 1,
      "template": {
        "introduction": "**Connecting to PTY Daemon**\n\nDaemon already running, connecting via socket.",
        "events": {
          "terminal.socket.connection": "[1] Socket {{state}}: attempt={{attempt}}, error={{error}}",
          "terminal.worker.action": "[2] Worker {{action}}: session=`{{session.id}}`, direction={{direction}}",
          "terminal.daemon.client_action": "[3] Client {{action}}: {{message.type}}",
          "terminal.socket.message": "[4] Socket {{direction}}: {{message.type}}",
          "terminal.daemon.session_action": "[5] Session {{action}}: `{{session.id}}` ({{sessions.count}} total)",
          "terminal.pty.spawned": "[6] PTY `{{session.id}}` running (pid={{pid}})",
          "terminal.health.check": "[7] Health {{direction}}: latency={{latency.ms}}ms, missed={{missed.count}}"
        },
        "summary": "**Connected**\n- Existing sessions: {{sessions.count}}"
      },
      "filterDefault": false
    },
    {
      "id": "connect-spawn-daemon",
      "description": "No daemon running, spawn new daemon process",
      "priority": 2,
      "template": {
        "introduction": "**Starting PTY Daemon**\n\nNo daemon found, spawning new process.",
        "events": {
          "terminal.socket.connection": "[1] Socket {{state}}: attempt={{attempt}}, error={{error}}",
          "terminal.daemon.phase": "[2] Daemon {{phase}}: {{reason}} (uptime={{uptime.ms}}ms)",
          "terminal.worker.action": "[3] Worker {{action}}: session=`{{session.id}}`, direction={{direction}}",
          "terminal.daemon.client_action": "[4] Client {{action}}: {{message.type}}",
          "terminal.daemon.server_event": "[5] Server {{event}}: {{clients.count}} clients",
          "terminal.socket.message": "[6] Socket {{direction}}: {{message.type}}"
        },
        "summary": "**Daemon Started**\n- New daemon spawned"
      },
      "filterDefault": false
    },
    {
      "id": "connect-error",
      "description": "Connection failed with error",
      "priority": 3,
      "template": {
        "introduction": "**Connection Error**\n\nConnection to daemon failed.",
        "events": {
          "terminal.error": "[1] Error: {{source}} - {{error.message}} (code={{error.code}}, session={{session.id}}, recoverable={{recoverable}})"
        },
        "summary": "**Connection Failed**\n- Check daemon status"
      },
      "filterDefault": false
    }
  ]
}
