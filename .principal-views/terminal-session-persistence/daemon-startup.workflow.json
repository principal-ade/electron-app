{
  "version": "1.0.0",
  "name": "Daemon Startup",
  "description": "PTY daemon process initialization and socket creation",
  "canvas": ".principal-views/terminal-session-persistence/terminal-session-persistence.otel.canvas",
  "spanPattern": "terminal.daemon.startup",
  "scenarios": [
    {
      "id": "daemon-startup",
      "description": "Daemon initializes and begins accepting connections",
      "priority": 1,
      "template": {
        "introduction": "**PTY Daemon Starting**\n\nInitializing independent PTY daemon process.",
        "events": {
          "terminal.daemon.phase": "[1] Daemon {{phase}}: {{reason}} (uptime={{uptime.ms}}ms)",
          "terminal.daemon.server_event": "[2] Server {{event}}: {{clients.count}} clients",
          "terminal.pty.spawn_attempt": "[3] PTY spawn attempt: shell={{shell.path}}, cwd={{cwd}}",
          "terminal.pty.spawned": "[4] PTY spawned: pid={{pid}}",
          "terminal.pty.spawn_failed": "[!] PTY spawn failed: error={{error.message}}"
        },
        "summary": "**Daemon Ready**"
      }
    }
  ]
}
