{
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 250,
      "y": -120,
      "width": 700,
      "height": 80,
      "color": "#64748B",
      "text": "# Dev Server Buttons\n**Shared infrastructure for launching dev servers (Storybook, Next.js, etc.) with automatic package detection, terminal management, and browser integration**"
    },
    {
      "id": "storybook-section-label",
      "type": "text",
      "x": 50,
      "y": 0,
      "width": 200,
      "height": 40,
      "color": "#FF4785",
      "text": "### Storybook-Specific"
    },
    {
      "id": "nextjs-section-label",
      "type": "text",
      "x": 300,
      "y": 0,
      "width": 200,
      "height": 40,
      "color": "#000000",
      "text": "### Next.js-Specific"
    },
    {
      "id": "storybook-button-click",
      "type": "otel-event",
      "x": 50,
      "y": 50,
      "width": 200,
      "height": 100,
      "label": "Storybook Button",
      "shape": "rectangle",
      "event": {
        "name": "devserver.button.clicked",
        "description": "User clicked a dev server button in titlebar",
        "attributes": {
          "server_type": {
            "type": "string",
            "description": "Type of server: storybook, nextjs, etc."
          },
          "current_status": {
            "type": "string",
            "description": "Current button state: idle, starting, running, error"
          },
          "selected_package": {
            "type": "string",
            "description": "Currently selected package name"
          },
          "action": {
            "type": "string",
            "description": "Action being taken: start or stop"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "storybook-detection",
      "type": "otel-event",
      "x": 50,
      "y": 180,
      "width": 200,
      "height": 120,
      "label": "Storybook Detection",
      "shape": "rectangle",
      "event": {
        "name": "devserver.storybook.detected",
        "description": "Storybook packages detected in codebase composition",
        "attributes": {
          "packages_count": {
            "type": "number",
            "description": "Number of Storybook packages found"
          },
          "package_names": {
            "type": "string[]",
            "description": "Names of detected packages"
          },
          "has_script": {
            "type": "boolean",
            "description": "Whether package has storybook npm script"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "storybook-command",
      "type": "otel-event",
      "x": 50,
      "y": 330,
      "width": 200,
      "height": 120,
      "label": "Storybook Command",
      "shape": "rectangle",
      "event": {
        "name": "devserver.storybook.command",
        "description": "Generated Storybook command based on package.json scripts",
        "attributes": {
          "command": {
            "type": "string",
            "description": "Full command: npm run storybook -p {port}"
          },
          "strategy": {
            "type": "string",
            "description": "Strategy used: npm_script or npx_direct"
          },
          "port_range": {
            "type": "string",
            "description": "Port range: 6006-6020"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "nextjs-button-click",
      "type": "otel-event",
      "x": 300,
      "y": 50,
      "width": 200,
      "height": 100,
      "label": "Next.js Button",
      "shape": "rectangle",
      "event": {
        "name": "devserver.button.clicked",
        "description": "User clicked a dev server button in titlebar",
        "attributes": {
          "server_type": {
            "type": "string",
            "description": "Type of server: storybook, nextjs, etc."
          },
          "current_status": {
            "type": "string",
            "description": "Current button state: idle, starting, running, error"
          },
          "selected_package": {
            "type": "string",
            "description": "Currently selected package name"
          },
          "action": {
            "type": "string",
            "description": "Action being taken: start or stop"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "nextjs-detection",
      "type": "otel-event",
      "x": 300,
      "y": 180,
      "width": 200,
      "height": 120,
      "label": "Next.js Detection",
      "shape": "rectangle",
      "event": {
        "name": "devserver.nextjs.detected",
        "description": "Next.js packages detected in codebase composition",
        "attributes": {
          "packages_count": {
            "type": "number",
            "description": "Number of Next.js packages found"
          },
          "package_names": {
            "type": "string[]",
            "description": "Names of detected packages"
          },
          "has_dev_script": {
            "type": "boolean",
            "description": "Whether package has dev npm script"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "nextjs-command",
      "type": "otel-event",
      "x": 300,
      "y": 330,
      "width": 200,
      "height": 120,
      "label": "Next.js Command",
      "shape": "rectangle",
      "event": {
        "name": "devserver.nextjs.command",
        "description": "Generated Next.js dev command based on package.json scripts",
        "attributes": {
          "command": {
            "type": "string",
            "description": "Full command: npm run dev -p {port}"
          },
          "strategy": {
            "type": "string",
            "description": "Strategy used: npm_script or npx_direct"
          },
          "port_range": {
            "type": "string",
            "description": "Port range: 3000-3020"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "shared-section-label",
      "type": "text",
      "x": 550,
      "y": 0,
      "width": 250,
      "height": 40,
      "color": "#64748B",
      "text": "### Shared Infrastructure"
    },
    {
      "id": "port-find",
      "type": "otel-event",
      "x": 550,
      "y": 50,
      "width": 200,
      "height": 100,
      "label": "findAvailablePort()",
      "shape": "rectangle",
      "event": {
        "name": "devserver.port.found",
        "description": "Found available port for dev server",
        "attributes": {
          "server_type": {
            "type": "string",
            "description": "Type of server requesting port"
          },
          "port": {
            "type": "number",
            "description": "Selected port number"
          },
          "start_port": {
            "type": "number",
            "description": "Start of port range scanned"
          },
          "end_port": {
            "type": "number",
            "description": "End of port range scanned"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "terminal-create",
      "type": "otel-event",
      "x": 550,
      "y": 180,
      "width": 200,
      "height": 120,
      "label": "Terminal Session",
      "shape": "rectangle",
      "event": {
        "name": "devserver.terminal.created",
        "description": "Terminal session created for dev server process",
        "attributes": {
          "server_type": {
            "type": "string",
            "description": "Type of server: storybook, nextjs"
          },
          "session_id": {
            "type": "string",
            "description": "Terminal session ID"
          },
          "context": {
            "type": "string",
            "description": "Terminal context: terminal:{owner}/{repo}:{server_type}"
          },
          "cwd": {
            "type": "string",
            "description": "Working directory"
          },
          "command": {
            "type": "string",
            "description": "Command being executed"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "session-event",
      "type": "otel-event",
      "x": 550,
      "y": 330,
      "width": 200,
      "height": 100,
      "label": "Event Emit",
      "shape": "rectangle",
      "event": {
        "name": "devserver.session.event_emitted",
        "description": "Terminal session created event emitted to panel framework",
        "attributes": {
          "event_type": {
            "type": "string",
            "description": "Event: terminal-session-created"
          },
          "session_id": {
            "type": "string",
            "description": "Terminal session ID"
          },
          "server_type": {
            "type": "string",
            "description": "Type of dev server"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "panel-layout",
      "type": "otel-event",
      "x": 800,
      "y": 50,
      "width": 200,
      "height": 120,
      "label": "Panel Layout",
      "shape": "rectangle",
      "event": {
        "name": "devserver.layout.configured",
        "description": "Panel layout reconfigured for dev server workflow",
        "attributes": {
          "server_type": {
            "type": "string",
            "description": "Type of dev server"
          },
          "left_collapsed": {
            "type": "boolean",
            "description": "Whether left panel was collapsed"
          },
          "panel_sizes": {
            "type": "number[]",
            "description": "Panel size percentages [left, middle, right]"
          },
          "right_panel": {
            "type": "string",
            "description": "Panel shown on right: localhostBrowser"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "port-wait",
      "type": "otel-event",
      "x": 800,
      "y": 200,
      "width": 200,
      "height": 100,
      "label": "waitForPortReady()",
      "shape": "rectangle",
      "event": {
        "name": "devserver.port.ready",
        "description": "Dev server port became responsive",
        "attributes": {
          "server_type": {
            "type": "string",
            "description": "Type of dev server"
          },
          "port": {
            "type": "number",
            "description": "Port that became ready"
          },
          "wait_duration_ms": {
            "type": "number",
            "description": "Time spent waiting for port"
          },
          "attempts": {
            "type": "number",
            "description": "Number of poll attempts made"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "browser-navigate",
      "type": "otel-event",
      "x": 800,
      "y": 330,
      "width": 200,
      "height": 100,
      "label": "Browser Navigate",
      "shape": "rectangle",
      "event": {
        "name": "devserver.browser.navigated",
        "description": "Localhost browser panel navigated to dev server URL",
        "attributes": {
          "server_type": {
            "type": "string",
            "description": "Type of dev server"
          },
          "port": {
            "type": "number",
            "description": "Target port"
          },
          "path": {
            "type": "string",
            "description": "URL path (usually /)"
          },
          "full_url": {
            "type": "string",
            "description": "Complete localhost URL"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "status-running",
      "type": "otel-event",
      "x": 800,
      "y": 460,
      "width": 200,
      "height": 80,
      "label": "Status: Running",
      "shape": "rectangle",
      "event": {
        "name": "devserver.status.changed",
        "description": "Dev server button status changed",
        "attributes": {
          "server_type": {
            "type": "string",
            "description": "Type of dev server"
          },
          "previous_status": {
            "type": "string",
            "description": "Previous status"
          },
          "new_status": {
            "type": "string",
            "description": "New status: idle, starting, running, error"
          },
          "port": {
            "type": "number",
            "description": "Active port if running"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "stop-flow",
      "type": "otel-event",
      "x": 550,
      "y": 460,
      "width": 200,
      "height": 100,
      "label": "Stop Dev Server",
      "shape": "rectangle",
      "event": {
        "name": "devserver.stopped",
        "description": "Dev server process stopped and resources cleaned up",
        "attributes": {
          "server_type": {
            "type": "string",
            "description": "Type of dev server stopped"
          },
          "session_id": {
            "type": "string",
            "description": "Destroyed terminal session ID"
          },
          "port": {
            "type": "number",
            "description": "Port that was released"
          },
          "restored_panel": {
            "type": "string",
            "description": "Panel restored on right: fileCity"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-dev-workspace"
      }
    },
    {
      "id": "server-config-note",
      "type": "text",
      "x": 1050,
      "y": 0,
      "width": 220,
      "height": 200,
      "text": "SERVER CONFIGURATIONS\n\n**Storybook**\nPort range: 6006-6020\nDetection: @storybook/*\nScript: storybook\n\n**Next.js**\nPort range: 3000-3020\nDetection: next\nScript: dev\n\n**Extensible** to Vite,\nRemix, etc.",
      "color": "#3B82F6"
    },
    {
      "id": "state-note",
      "type": "text",
      "x": 1050,
      "y": 220,
      "width": 220,
      "height": 160,
      "text": "SHARED STATE\n\ndevServerStatus:\n  Map<type, status>\n\ndevServerSessions:\n  Map<type, sessionId>\n\ndevServerPorts:\n  Map<type, port>\n\nselectedPackages:\n  Map<type, package>",
      "color": "#F59E0B"
    },
    {
      "id": "flow-note",
      "type": "text",
      "x": 1050,
      "y": 400,
      "width": 220,
      "height": 180,
      "text": "SHARED FLOW\n\n1. Detect packages (init)\n2. User clicks button\n3. Get server-specific cmd\n4. Find available port\n5. Create terminal session\n6. Configure panel layout\n7. Wait for port ready\n8. Navigate browser\n9. Set status: running",
      "color": "#10B981"
    }
  ],
  "edges": [
    {
      "id": "e-sb-detect",
      "fromNode": "storybook-button-click",
      "toNode": "storybook-detection",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "useEffect",
      "edgeType": "uses"
    },
    {
      "id": "e-sb-cmd",
      "fromNode": "storybook-detection",
      "toNode": "storybook-command",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "packages found",
      "edgeType": "uses"
    },
    {
      "id": "e-sb-to-shared",
      "fromNode": "storybook-command",
      "toNode": "port-find",
      "fromSide": "right",
      "toSide": "left",
      "label": "onClick",
      "edgeType": "uses"
    },
    {
      "id": "e-nj-detect",
      "fromNode": "nextjs-button-click",
      "toNode": "nextjs-detection",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "useEffect",
      "edgeType": "uses"
    },
    {
      "id": "e-nj-cmd",
      "fromNode": "nextjs-detection",
      "toNode": "nextjs-command",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "packages found",
      "edgeType": "uses"
    },
    {
      "id": "e-nj-to-shared",
      "fromNode": "nextjs-command",
      "toNode": "port-find",
      "fromSide": "right",
      "toSide": "left",
      "label": "onClick",
      "edgeType": "uses"
    },
    {
      "id": "e-port-terminal",
      "fromNode": "port-find",
      "toNode": "terminal-create",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "port found",
      "edgeType": "uses"
    },
    {
      "id": "e-terminal-event",
      "fromNode": "terminal-create",
      "toNode": "session-event",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "session created",
      "edgeType": "subscription"
    },
    {
      "id": "e-event-layout",
      "fromNode": "session-event",
      "toNode": "panel-layout",
      "fromSide": "right",
      "toSide": "left",
      "label": "after 500ms",
      "edgeType": "uses"
    },
    {
      "id": "e-layout-wait",
      "fromNode": "panel-layout",
      "toNode": "port-wait",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "layout set",
      "edgeType": "uses"
    },
    {
      "id": "e-wait-browser",
      "fromNode": "port-wait",
      "toNode": "browser-navigate",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "port ready",
      "edgeType": "uses"
    },
    {
      "id": "e-browser-status",
      "fromNode": "browser-navigate",
      "toNode": "status-running",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "navigated",
      "edgeType": "subscription"
    },
    {
      "id": "e-status-stop",
      "fromNode": "status-running",
      "toNode": "stop-flow",
      "fromSide": "left",
      "toSide": "right",
      "label": "click Stop",
      "edgeType": "uses"
    },
    {
      "id": "e-stop-reset",
      "fromNode": "stop-flow",
      "toNode": "port-find",
      "fromSide": "top",
      "toSide": "bottom",
      "label": "reset to idle",
      "edgeType": "uses"
    }
  ],
  "name": "Dev Server Buttons",
  "description": "Flow of dev server button interactions from right sidebar: package detection, terminal spawning, port management, and browser navigation. Supports Storybook, Next.js, and extensible to other dev servers.",
  "markdown": ".principal-views/dev-server-buttons/dev-server-buttons.md",
  "nodeTypes": {
    "ui": {
      "label": "UI Component",
      "color": "#10B981"
    },
    "service": {
      "label": "Service",
      "color": "#3B82F6"
    },
    "terminal": {
      "label": "Terminal",
      "color": "#8B5CF6"
    },
    "panel": {
      "label": "Panel",
      "color": "#6366F1"
    },
    "port": {
      "label": "Port Detection",
      "color": "#F59E0B"
    },
    "browser": {
      "label": "Browser",
      "color": "#EC4899"
    },
    "event": {
      "label": "Event",
      "color": "#14B8A6"
    },
    "storybook": {
      "label": "Storybook",
      "color": "#FF4785"
    },
    "nextjs": {
      "label": "Next.js",
      "color": "#000000"
    },
    "shared": {
      "label": "Shared Infrastructure",
      "color": "#64748B"
    }
  },
  "edgeTypes": {
    "ipc": {
      "label": "IPC",
      "style": "solid",
      "color": "#8B5CF6"
    }
  }
}
