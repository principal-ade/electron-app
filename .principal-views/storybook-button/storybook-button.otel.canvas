{
  "pv": {
    "name": "Storybook Button",
    "version": "1.0.0",
    "description": "Flow of Storybook button interaction from right sidebar: package detection, terminal spawning, port management, and browser navigation in dev workspace",
    "markdown": ".principal-views/storybook-button/storybook-button.md",
    "nodeTypes": {
      "ui": {
        "label": "UI Component",
        "color": "#10B981"
      },
      "service": {
        "label": "Service",
        "color": "#3B82F6"
      },
      "terminal": {
        "label": "Terminal",
        "color": "#8B5CF6"
      },
      "panel": {
        "label": "Panel",
        "color": "#6366F1"
      },
      "port": {
        "label": "Port Detection",
        "color": "#F59E0B"
      },
      "browser": {
        "label": "Browser",
        "color": "#EC4899"
      },
      "event": {
        "label": "Event",
        "color": "#14B8A6"
      }
    },
    "edgeTypes": {
      "user-action": {
        "label": "User Action",
        "style": "solid",
        "color": "#10B981"
      },
      "service-call": {
        "label": "Service Call",
        "style": "solid",
        "color": "#3B82F6"
      },
      "async-wait": {
        "label": "Async Wait",
        "style": "dashed",
        "color": "#F59E0B"
      },
      "event-emit": {
        "label": "Event Emit",
        "style": "solid",
        "color": "#14B8A6"
      },
      "ipc": {
        "label": "IPC",
        "style": "solid",
        "color": "#8B5CF6"
      }
    }
  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 300,
      "y": -100,
      "width": 600,
      "height": 60,
      "color": "#64748B",
      "text": "# Storybook Button Flow\n**Package detection, terminal spawning, and browser navigation in dev workspace**"
    },
    {
      "id": "button-click",
      "type": "text",
      "x": 50,
      "y": 0,
      "width": 200,
      "height": 100,
      "text": "Storybook Button\n\nUser clicks button\nin right sidebar",
      "pv": {
        "nodeType": "ui",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/components/Sidebar/StorybookSidebarButton.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ui"
        },
        "event": {
          "name": "storybook.button.clicked",
          "description": "User clicked the Storybook button in titlebar",
          "attributes": {
            "current_status": {
              "type": "string",
              "description": "Current button state: idle, starting, running, error"
            },
            "selected_package": {
              "type": "string",
              "description": "Currently selected Storybook package name"
            },
            "action": {
              "type": "string",
              "description": "Action being taken: start or stop"
            }
          }
        }
      }
    },
    {
      "id": "package-detection",
      "type": "text",
      "x": 50,
      "y": 150,
      "width": 200,
      "height": 120,
      "text": "StorybookService\n.findStorybookPackages()\n\nUses codebase-composition\nPackageLayer[] data",
      "pv": {
        "nodeType": "service",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/services/StorybookService.ts",
          "@principal-ai/codebase-composition"
        ],
        "otel": {
          "kind": "event",
          "category": "detection"
        },
        "event": {
          "name": "storybook.packages.detected",
          "description": "Storybook packages detected in codebase composition",
          "attributes": {
            "packages_count": {
              "type": "number",
              "description": "Number of Storybook packages found"
            },
            "package_names": {
              "type": "string[]",
              "description": "Names of detected packages"
            },
            "has_script": {
              "type": "boolean",
              "description": "Whether package has storybook npm script"
            }
          }
        }
      }
    },
    {
      "id": "port-find",
      "type": "text",
      "x": 300,
      "y": 0,
      "width": 200,
      "height": 100,
      "text": "findAvailablePort()\n\nScans 6006-6020\nfinds first free port",
      "pv": {
        "nodeType": "port",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/utils/portDetection.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "network"
        },
        "event": {
          "name": "storybook.port.found",
          "description": "Found available port for Storybook server",
          "attributes": {
            "port": {
              "type": "number",
              "description": "Selected port number"
            },
            "start_port": {
              "type": "number",
              "description": "Start of port range scanned",
              "display": false
            },
            "end_port": {
              "type": "number",
              "description": "End of port range scanned",
              "display": false
            }
          }
        }
      }
    },
    {
      "id": "get-command",
      "type": "text",
      "x": 300,
      "y": 150,
      "width": 200,
      "height": 120,
      "text": "StorybookService\n.getStorybookCommand()\n\nnpm run storybook\nor npx storybook dev",
      "pv": {
        "nodeType": "service",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/services/StorybookService.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        },
        "event": {
          "name": "storybook.command.generated",
          "description": "Generated Storybook command based on package.json scripts",
          "attributes": {
            "command": {
              "type": "string",
              "description": "Full command to execute"
            },
            "strategy": {
              "type": "string",
              "description": "Strategy used: npm_script or npx_direct"
            },
            "port": {
              "type": "number",
              "description": "Port included in command"
            },
            "cwd": {
              "type": "string",
              "description": "Working directory for command"
            }
          }
        }
      }
    },
    {
      "id": "terminal-create",
      "type": "text",
      "x": 550,
      "y": 0,
      "width": 200,
      "height": 120,
      "text": "Terminal Session\n\nCreate with context:\nterminal:{owner}/\n{repo}:storybook",
      "pv": {
        "nodeType": "terminal",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/components/Sidebar/StorybookSidebarButton.tsx"
        ],
        "otel": {
          "kind": "span",
          "category": "lifecycle"
        },
        "event": {
          "name": "storybook.terminal.created",
          "description": "Terminal session created for Storybook process",
          "attributes": {
            "session_id": {
              "type": "string",
              "description": "Terminal session ID"
            },
            "context": {
              "type": "string",
              "description": "Terminal context identifier"
            },
            "cwd": {
              "type": "string",
              "description": "Working directory"
            },
            "command": {
              "type": "string",
              "description": "Command being executed",
              "display": false
            }
          }
        }
      }
    },
    {
      "id": "session-event",
      "type": "text",
      "x": 550,
      "y": 170,
      "width": 200,
      "height": 100,
      "text": "Event Emit\n\nterminal-session-created\nnotifies other panels",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/components/Sidebar/StorybookSidebarButton.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ipc"
        },
        "event": {
          "name": "storybook.session.event_emitted",
          "description": "Terminal session created event emitted to panel framework",
          "attributes": {
            "event_type": {
              "type": "string",
              "description": "Event: terminal-session-created"
            },
            "session_id": {
              "type": "string",
              "description": "Terminal session ID"
            }
          }
        }
      }
    },
    {
      "id": "panel-layout",
      "type": "text",
      "x": 800,
      "y": 0,
      "width": 200,
      "height": 120,
      "text": "Panel Layout\n\n- Collapse left panel\n- 50/50 middle/right\n- Right: localhostBrowser",
      "pv": {
        "nodeType": "panel",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/components/Sidebar/StorybookSidebarButton.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ui"
        },
        "event": {
          "name": "storybook.layout.configured",
          "description": "Panel layout reconfigured for Storybook development",
          "attributes": {
            "left_collapsed": {
              "type": "boolean",
              "description": "Whether left panel was collapsed"
            },
            "panel_sizes": {
              "type": "number[]",
              "description": "Panel size percentages [left, middle, right]"
            },
            "right_panel": {
              "type": "string",
              "description": "Panel shown on right: localhostBrowser"
            }
          }
        }
      }
    },
    {
      "id": "port-wait",
      "type": "text",
      "x": 800,
      "y": 170,
      "width": 200,
      "height": 100,
      "text": "waitForPortReady()\n\nPolls port every 1s\n30s timeout",
      "pv": {
        "nodeType": "port",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/utils/portDetection.ts"
        ],
        "otel": {
          "kind": "span",
          "category": "network"
        },
        "event": {
          "name": "storybook.port.ready",
          "description": "Storybook server port became responsive",
          "attributes": {
            "port": {
              "type": "number",
              "description": "Port that became ready"
            },
            "wait_duration_ms": {
              "type": "number",
              "description": "Time spent waiting for port"
            },
            "attempts": {
              "type": "number",
              "description": "Number of poll attempts made"
            }
          }
        }
      }
    },
    {
      "id": "browser-navigate",
      "type": "text",
      "x": 800,
      "y": 320,
      "width": 200,
      "height": 100,
      "text": "Browser Navigate\n\nprincipal-ade.\nlocalhost-browser:\nnavigate",
      "pv": {
        "nodeType": "browser",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/components/Sidebar/StorybookSidebarButton.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ui"
        },
        "event": {
          "name": "storybook.browser.navigated",
          "description": "Localhost browser panel navigated to Storybook URL",
          "attributes": {
            "port": {
              "type": "number",
              "description": "Target port"
            },
            "path": {
              "type": "string",
              "description": "URL path (usually /)"
            },
            "full_url": {
              "type": "string",
              "description": "Complete localhost URL",
              "display": false
            }
          }
        }
      }
    },
    {
      "id": "status-running",
      "type": "text",
      "x": 550,
      "y": 320,
      "width": 200,
      "height": 80,
      "text": "Status: Running\n\nButton shows 'Stop SB'\nwith green highlight",
      "pv": {
        "nodeType": "ui",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/components/Sidebar/StorybookSidebarButton.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ui"
        },
        "event": {
          "name": "storybook.status.changed",
          "description": "Storybook button status changed",
          "attributes": {
            "previous_status": {
              "type": "string",
              "description": "Previous status"
            },
            "new_status": {
              "type": "string",
              "description": "New status: idle, starting, running, error"
            },
            "port": {
              "type": "number",
              "description": "Active port if running"
            }
          }
        }
      }
    },
    {
      "id": "stop-flow",
      "type": "text",
      "x": 300,
      "y": 320,
      "width": 200,
      "height": 100,
      "text": "Stop Storybook\n\nterminal.destroy()\nreset state\nrestore panels",
      "pv": {
        "nodeType": "terminal",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/components/Sidebar/StorybookSidebarButton.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        },
        "event": {
          "name": "storybook.stopped",
          "description": "Storybook process stopped and resources cleaned up",
          "attributes": {
            "session_id": {
              "type": "string",
              "description": "Destroyed terminal session ID"
            },
            "port": {
              "type": "number",
              "description": "Port that was released"
            },
            "restored_panel": {
              "type": "string",
              "description": "Panel restored on right: fileCity"
            }
          }
        }
      }
    },
    {
      "id": "state-note",
      "type": "text",
      "x": 1050,
      "y": 0,
      "width": 220,
      "height": 180,
      "text": "STATE MANAGEMENT\n\nstorybookStatus:\n  idle | starting |\n  running | error\n\nstorybookSessionId:\n  string | null\n\nstorybookPort:\n  number | null\n\nselectedPackage:\n  StorybookPackage | null",
      "color": "#F59E0B"
    },
    {
      "id": "package-note",
      "type": "text",
      "x": 1050,
      "y": 210,
      "width": 220,
      "height": 160,
      "text": "PACKAGE DETECTION\n\nSource: codebase-composition\nPackageLayer[] via IPC\n\nChecks:\n- availableCommands\n- dependencies for\n  @storybook/*",
      "color": "#3B82F6"
    },
    {
      "id": "flow-note",
      "type": "text",
      "x": 1050,
      "y": 400,
      "width": 220,
      "height": 180,
      "text": "FLOW SUMMARY\n\n1. Detect packages (init)\n2. User clicks button\n3. Find available port\n4. Get storybook command\n5. Create terminal session\n6. Configure panel layout\n7. Wait for port ready\n8. Navigate browser\n9. Set status: running",
      "color": "#10B981"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "fromNode": "button-click",
      "toNode": "port-find",
      "fromSide": "right",
      "toSide": "left",
      "label": "onClick (start)",
      "pv": {
        "edgeType": "user-action"
      }
    },
    {
      "id": "e2",
      "fromNode": "button-click",
      "toNode": "package-detection",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "useEffect (init)",
      "pv": {
        "edgeType": "service-call"
      }
    },
    {
      "id": "e3",
      "fromNode": "port-find",
      "toNode": "get-command",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "port found",
      "pv": {
        "edgeType": "service-call"
      }
    },
    {
      "id": "e4",
      "fromNode": "get-command",
      "toNode": "terminal-create",
      "fromSide": "right",
      "toSide": "left",
      "label": "command ready",
      "pv": {
        "edgeType": "service-call"
      }
    },
    {
      "id": "e5",
      "fromNode": "terminal-create",
      "toNode": "session-event",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "session created",
      "pv": {
        "edgeType": "event-emit"
      }
    },
    {
      "id": "e6",
      "fromNode": "session-event",
      "toNode": "panel-layout",
      "fromSide": "right",
      "toSide": "left",
      "label": "after 500ms",
      "pv": {
        "edgeType": "async-wait"
      }
    },
    {
      "id": "e7",
      "fromNode": "panel-layout",
      "toNode": "port-wait",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "layout set",
      "pv": {
        "edgeType": "service-call"
      }
    },
    {
      "id": "e8",
      "fromNode": "port-wait",
      "toNode": "browser-navigate",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "port ready",
      "pv": {
        "edgeType": "async-wait"
      }
    },
    {
      "id": "e9",
      "fromNode": "browser-navigate",
      "toNode": "status-running",
      "fromSide": "left",
      "toSide": "right",
      "label": "navigated",
      "pv": {
        "edgeType": "event-emit"
      }
    },
    {
      "id": "e10",
      "fromNode": "status-running",
      "toNode": "stop-flow",
      "fromSide": "left",
      "toSide": "right",
      "label": "click Stop",
      "pv": {
        "edgeType": "user-action"
      }
    },
    {
      "id": "e11",
      "fromNode": "stop-flow",
      "toNode": "button-click",
      "fromSide": "left",
      "toSide": "bottom",
      "label": "reset to idle",
      "pv": {
        "edgeType": "service-call"
      }
    }
  ]
}