  "edges": [
    {
      "id": "settings-to-service",
      "fromNode": "settings-modal",
      "fromSide": "right",
      "toNode": "version-service",
      "toSide": "left",
      "label": "uses service",
      "edgeType": "uses"
    },
    {
      "id": "check-button-to-service",
      "fromNode": "check-button",
      "fromSide": "right",
      "toNode": "version-service",
      "toSide": "left",
      "label": "checkForUpdate()",
      "edgeType": "uses"
    },
    {
      "id": "service-to-ipc",
      "fromNode": "version-service",
      "fromSide": "bottom",
      "toNode": "ipc-bridge",
      "toSide": "top",
      "label": "ipcRenderer.send()",
      "edgeType": "uses"
    },
    {
      "id": "ipc-to-manager",
      "fromNode": "ipc-bridge",
      "fromSide": "right",
      "toNode": "app-version-manager",
      "toSide": "left",
      "label": "IPC message",
      "edgeType": "ipc"
    },
    {
      "id": "manager-to-check",
      "fromNode": "app-version-manager",
      "fromSide": "bottom",
      "toNode": "check-for-updates",
      "toSide": "top",
      "label": "handles IPC",
      "edgeType": "uses"
    },
    {
      "id": "manager-to-autoupdater",
      "fromNode": "app-version-manager",
      "fromSide": "right",
      "toNode": "auto-updater",
      "toSide": "left",
      "label": "configures",
      "edgeType": "uses"
    },
    {
      "id": "autoupdater-to-github",
      "fromNode": "auto-updater",
      "fromSide": "right",
      "toNode": "github-releases",
      "toSide": "left",
      "label": "HTTPS GET",
      "edgeType": "http"
    },
    {
      "id": "check-to-github-request",
      "fromNode": "check-for-updates",
      "fromSide": "right",
      "toNode": "github-request",
      "toSide": "left",
      "label": "HTTP request",
      "edgeType": "http"
    },
    {
      "id": "github-request-to-available",
      "fromNode": "github-request",
      "fromSide": "right",
      "toNode": "update-available",
      "toSide": "left",
      "label": "if newer version",
      "edgeType": "subscription"
