{
  "pv": {
    "name": "App Updates",
    "version": "1.0.0",
    "description": "Electron auto-update system using electron-updater with GitHub releases",
    "markdown": ".principal-views/app-updates/app-updates.md",
    "scope": "principal-ade",
    "nodeTypes": {
      "ui-component": {
        "label": "UI Component",
        "color": "#3B82F6"
      },
      "renderer-service": {
        "label": "Renderer Service",
        "color": "#8B5CF6"
      },
      "ipc-bridge": {
        "label": "IPC Bridge",
        "color": "#F59E0B"
      },
      "main-process": {
        "label": "Main Process",
        "color": "#22C55E"
      },
      "external-service": {
        "label": "External Service",
        "color": "#64748B"
      },
      "user-action": {
        "label": "User Action",
        "color": "#EC4899"
      },
      "boundary": {
        "label": "Boundary",
        "color": "#94A3B8"
      },
      "event": {
        "label": "Event",
        "color": "#3B82F6"
      }
    },
    "edgeTypes": {
      "user-interaction": {
        "label": "User Interaction",
        "style": "solid",
        "color": "#EC4899"
      },
      "ipc-send": {
        "label": "IPC Send",
        "style": "solid",
        "color": "#F59E0B"
      },
      "ipc-receive": {
        "label": "IPC Receive",
        "style": "dashed",
        "color": "#F59E0B"
      },
      "function-call": {
        "label": "Function Call",
        "style": "solid",
        "color": "#3B82F6"
      },
      "http-request": {
        "label": "HTTP Request",
        "style": "solid",
        "color": "#22C55E"
      },
      "event-emit": {
        "label": "Event Emit",
        "style": "dashed",
        "color": "#8B5CF6"
      }
    }
  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 300,
      "y": -100,
      "width": 500,
      "height": 60,
      "color": "#64748B",
      "text": "# App Updates System\n**Electron auto-update via electron-updater + GitHub Releases**"
    },
    {
      "id": "settings-modal",
      "type": "text",
      "x": 50,
      "y": 50,
      "width": 220,
      "height": 100,
      "text": "UpdatesSettings\n(Settings Modal)\nShows version, status,\ndownload progress",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/renderer/principal-window/views/Settings/components/UpdatesSettings.tsx"
        ],
        "otel": {
          "files": ["src/renderer/principal-window/views/Settings/components/UpdatesSettings.tsx"]
        },
        "event": {
          "name": "app_updates.ui.settings_opened",
          "description": "User opened the Updates settings panel",
          "attributes": {
            "current_version": {
              "type": "string",
              "description": "Currently installed app version"
            },
            "is_dev_mode": {
              "type": "boolean",
              "description": "Whether running in development mode"
            }
          }
        }
      }
    },
    {
      "id": "check-button",
      "type": "text",
      "x": 50,
      "y": 180,
      "width": 220,
      "height": 80,
      "text": "Check for Updates\nButton\n(Manual trigger)",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/renderer/principal-window/views/Settings/components/UpdatesSettings.tsx"
        ],
        "otel": {
          "files": ["src/renderer/principal-window/views/Settings/components/UpdatesSettings.tsx"]
        },
        "event": {
          "name": "app_updates.user.check_requested",
          "description": "User clicked the Check for Updates button",
          "attributes": {
            "trigger": {
              "type": "string",
              "description": "How the check was triggered: manual, silent, periodic"
            }
          }
        }
      }
    },
    {
      "id": "version-service",
      "type": "text",
      "x": 320,
      "y": 50,
      "width": 220,
      "height": 100,
      "text": "AppVersionManagerService\n(Renderer API)\nWraps IPC calls for\nReact components",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/main-process-api/AppVersionManagerService.ts"
        ],
        "event": {
          "name": "app_updates.service.method_called",
          "description": "AppVersionManagerService method invoked",
          "attributes": {
            "method": {
              "type": "string",
              "description": "Method name: checkForUpdate, downloadUpdate, installUpdate"
            }
          }
        }
      }
    },
    {
      "id": "ipc-bridge",
      "type": "text",
      "x": 320,
      "y": 179,
      "width": 220,
      "height": 100,
      "text": "IPC Bridge\n(appVersionManagerApi)\nipcRenderer.send()\nipcRenderer.on()",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/window/main-process-api-implementations/appVersionManagerApi.ts"
        ],
        "event": {
          "name": "app_updates.ipc.message_sent",
          "description": "IPC message sent from renderer to main",
          "attributes": {
            "channel": {
              "type": "string",
              "description": "IPC channel name"
            },
            "direction": {
              "type": "string",
              "description": "Direction: renderer_to_main or main_to_renderer"
            }
          }
        }
      }
    },
    {
      "id": "app-version-manager",
      "type": "text",
      "x": 590,
      "y": 50,
      "width": 220,
      "height": 100,
      "text": "AppVersionManager\n(Main Process)\nHandles IPC, configures\nautoUpdater",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/main/AppVersionManager.ts"
        ],
        "otel": {
          "files": ["src/main/AppVersionManager.ts"]
        },
        "event": {
          "name": "app_updates.manager.initialized",
          "description": "AppVersionManager initialized and ready to handle updates",
          "attributes": {
            "auto_download": {
              "type": "boolean",
              "description": "Whether auto-download is enabled"
            },
            "auto_install": {
              "type": "boolean",
              "description": "Whether auto-install is enabled"
            }
          }
        }
      }
    },
    {
      "id": "check-for-updates",
      "type": "text",
      "x": 590,
      "y": 180,
      "width": 220,
      "height": 80,
      "text": "checkForUpdates()\nQueries GitHub releases\nfor new versions",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/main/AppVersionManager.ts"
        ],
        "otel": {
          "files": ["src/main/AppVersionManager.ts"]
        },
        "event": {
          "name": "app_updates.check.started",
          "description": "Update check initiated",
          "attributes": {
            "trigger": {
              "type": "string",
              "description": "Trigger type: manual, silent, periodic"
            },
            "current_version": {
              "type": "string",
              "description": "Current app version"
            }
          }
        }
      }
    },
    {
      "id": "github-request",
      "type": "text",
      "x": 907,
      "y": 128,
      "width": 220,
      "height": 80,
      "text": "GitHub HTTP Request\nGET latest-mac.yml\nTracks request timing",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/main/AppVersionManager.ts"
        ],
        "otel": {
          "files": ["src/main/AppVersionManager.ts"]
        },
        "event": {
          "name": "app_updates.github.request_completed",
          "description": "HTTP request to GitHub completed",
          "attributes": {
            "duration_ms": {
              "type": "number",
              "description": "Request duration in milliseconds"
            },
            "result": {
              "type": "string",
              "description": "Result: update_available or update_not_available"
            },
            "cached": {
              "type": "boolean",
              "description": "Whether the response may have been cached (no checking-for-update event fired)"
            }
          }
        }
      }
    },
    {
      "id": "auto-updater",
      "type": "text",
      "x": 1229,
      "y": 50,
      "width": 220,
      "height": 100,
      "text": "electron-updater\n(autoUpdater)\nCore update library\nwith event emitters",
      "pv": {
        "nodeType": "boundary",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/main/AppVersionManager.ts"
        ],
        "boundary": {
          "direction": "outbound",
          "node": {
            "pv.event.name": "electron-updater.checkForUpdates"
          }
        }
      }
    },
    {
      "id": "github-releases",
      "type": "text",
      "x": 1499,
      "y": 50,
      "width": 200,
      "height": 100,
      "text": "GitHub Releases\n(principal-ade/\nlanding-page)\nlatest-mac.yml",
      "pv": {
        "nodeType": "boundary",
        "shape": "rectangle",
        "status": "draft",
        "references": [],
        "boundary": {
          "direction": "outbound",
          "node": {
            "pv.event.name": "github.releases.fetch"
          }
        }
      }
    },
    {
      "id": "update-available",
      "type": "text",
      "x": 1214,
      "y": 186,
      "width": 220,
      "height": 80,
      "text": "update-available\nevent\nNew version found",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/main/AppVersionManager.ts"
        ],
        "otel": {
          "files": ["src/main/AppVersionManager.ts"]
        },
        "event": {
          "name": "app_updates.check.available",
          "description": "Update available event received",
          "attributes": {
            "available_version": {
              "type": "string",
              "description": "New version available"
            },
            "current_version": {
              "type": "string",
              "description": "Current installed version",
              "display": false
            },
            "release_date": {
              "type": "string",
              "description": "Release date of new version",
              "display": false
            }
          }
        }
      }
    },
    {
      "id": "update-not-available",
      "type": "text",
      "x": 1197,
      "y": 282,
      "width": 220,
      "height": 80,
      "text": "update-not-available\nevent\nAlready on latest",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/main/AppVersionManager.ts"
        ],
        "otel": {
          "files": ["src/main/AppVersionManager.ts"]
        },
        "event": {
          "name": "app_updates.check.not_available",
          "description": "No update available - already on latest",
          "attributes": {
            "current_version": {
              "type": "string",
              "description": "Current installed version"
            }
          }
        }
      }
    },
