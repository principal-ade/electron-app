{
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 300,
      "y": -100,
      "width": 500,
      "height": 60,
      "color": "#64748B",
      "text": "# App Updates System\n**Electron auto-update via electron-updater + GitHub Releases**"
    },
    {
      "id": "settings-modal",
      "type": "otel-event",
      "x": 50,
      "y": 50,
      "width": 220,
      "height": 100,
      "label": "UpdatesSettings",
      "shape": "rectangle",
      "event": {
        "name": "app_updates.ui.settings_opened",
        "description": "User opened the Updates settings panel",
        "attributes": {
          "current_version": {
            "type": "string",
            "description": "Currently installed app version"
          },
          "is_dev_mode": {
            "type": "boolean",
            "description": "Whether running in development mode"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/renderer/principal-window/views/Settings/components/UpdatesSettings.tsx"
        ],
        "scope": "principal-ade-principal-window"
      }
    },
    {
      "id": "check-button",
      "type": "otel-event",
      "x": 50,
      "y": 180,
      "width": 220,
      "height": 80,
      "label": "Check for Updates",
      "shape": "rectangle",
      "event": {
        "name": "app_updates.user.check_requested",
        "description": "User clicked the Check for Updates button",
        "attributes": {
          "trigger": {
            "type": "string",
            "description": "How the check was triggered: manual, silent, periodic"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/renderer/principal-window/views/Settings/components/UpdatesSettings.tsx"
        ],
        "scope": "principal-ade-principal-window"
      }
    },
    {
      "id": "version-service",
      "type": "otel-event",
      "x": 320,
      "y": 50,
      "width": 220,
      "height": 100,
      "label": "AppVersionManagerService",
      "shape": "rectangle",
      "event": {
        "name": "app_updates.service.method_called",
        "description": "AppVersionManagerService method invoked",
        "attributes": {
          "method": {
            "type": "string",
            "description": "Method name: checkForUpdate, downloadUpdate, installUpdate"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-principal-window"
      }
    },
    {
      "id": "ipc-bridge",
      "type": "otel-event",
      "x": 320,
      "y": 179,
      "width": 220,
      "height": 100,
      "label": "IPC Bridge",
      "shape": "rectangle",
      "event": {
        "name": "app_updates.ipc.message_sent",
        "description": "IPC message sent from renderer to main",
        "attributes": {
          "channel": {
            "type": "string",
            "description": "IPC channel name"
          },
          "direction": {
            "type": "string",
            "description": "Direction: renderer_to_main or main_to_renderer"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-principal-window"
      }
    },
    {
      "id": "app-version-manager",
      "type": "otel-event",
      "x": 590,
      "y": 50,
      "width": 220,
      "height": 100,
      "label": "AppVersionManager",
      "shape": "rectangle",
      "event": {
        "name": "app_updates.manager.initialized",
        "description": "AppVersionManager initialized and ready to handle updates",
        "attributes": {
          "auto_download": {
            "type": "boolean",
            "description": "Whether auto-download is enabled"
          },
          "auto_install": {
            "type": "boolean",
            "description": "Whether auto-install is enabled"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/main/AppVersionManager.ts"
        ],
        "scope": "principal-ade-main"
      }
    },
    {
      "id": "check-for-updates",
      "type": "otel-event",
      "x": 590,
      "y": 180,
      "width": 220,
      "height": 80,
      "label": "checkForUpdates()",
      "shape": "rectangle",
      "event": {
        "name": "app_updates.check.started",
        "description": "Update check initiated",
        "attributes": {
          "trigger": {
            "type": "string",
            "description": "Trigger type: manual, silent, periodic"
          },
          "current_version": {
            "type": "string",
            "description": "Current app version"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/main/AppVersionManager.ts"
        ],
        "scope": "principal-ade-main"
      }
    },
    {
      "id": "github-request",
      "type": "otel-event",
      "x": 907,
      "y": 128,
      "width": 220,
      "height": 80,
      "label": "GitHub HTTP Request",
      "shape": "rectangle",
      "event": {
        "name": "app_updates.github.request_completed",
        "description": "HTTP request to GitHub completed",
        "attributes": {
          "duration_ms": {
            "type": "number",
            "description": "Request duration in milliseconds"
          },
          "result": {
            "type": "string",
            "description": "Result: update_available or update_not_available"
          },
          "cached": {
            "type": "boolean",
            "description": "Whether the response may have been cached (no checking-for-update event fired)"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/main/AppVersionManager.ts"
        ],
        "scope": "principal-ade-main"
      }
    },
    {
      "id": "auto-updater",
      "type": "otel-boundary",
      "x": 1229,
      "y": 50,
      "width": 220,
      "height": 100,
      "label": "electron-updater",
      "shape": "rectangle",
      "otel": {
        "status": "draft"
      },
      "boundary": {
        "direction": "outbound",
        "node": {
          "pv.event.name": "electron-updater.checkForUpdates"
        }
      }
    },
    {
      "id": "github-releases",
      "type": "otel-boundary",
      "x": 1499,
      "y": 50,
      "width": 200,
      "height": 100,
      "label": "GitHub Releases",
      "shape": "rectangle",
      "otel": {
        "status": "draft"
      },
      "boundary": {
        "direction": "outbound",
        "node": {
          "pv.event.name": "github.releases.fetch"
        }
      }
    },
