{
  "version": "1.0.0",
  "name": "Session Creation",
  "description": "Terminal session creation flow from renderer through TIPC to worker",
  "mode": "span-tree",
  "canvas": ".principal-views/terminal-session-management/terminal-session-management.otel.canvas",
  "spanPattern": "terminal.session.create",
  "scenarios": [
    {
      "id": "session-creation-success",
      "description": "Successful terminal session creation with PTY and MessagePort setup",
      "priority": 1,
      "template": {
        "introduction": "**Creating Terminal Session**\n\nRenderer requested new terminal session. Session manager coordinating with worker.",
        "events": {
          "terminal.session.create_requested": "[1] Renderer requested session: cwd=`{{cwd}}`, context={{context}}",
          "terminal.session.router_handled": "[2] Router handling: window={{window.id}}, can_create={{can_create}}",
          "terminal.session.manager_action": "[3] Manager {{action}}: session=`{{session.id}}`",
          "terminal.session.store_updated": "[4] Store {{operation}}: session=`{{session.id}}`, size={{store.size}}",
          "terminal.worker.session_created": "[5] Worker created PTY: session=`{{session.id}}`, shell={{shell}}",
          "terminal.ownership.changed": "[6] Ownership claimed: session=`{{session.id}}`, owner={{new_owner.window_id}}",
          "terminal.port.worker_registered": "[7] Worker port registered: session=`{{session.id}}`, window={{window.id}}",
          "terminal.port.renderer_connected": "[8] Renderer port connected: session=`{{session.id}}`"
        },
        "summary": "**Session Created:**\n- Session ID: `{{session.id}}`\n- Directory: `{{cwd}}`\n- Owner Window: {{window.id}}"
      },
      "filterDefault": true
    }
  ]
}
