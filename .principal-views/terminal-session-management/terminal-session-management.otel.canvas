      "type": "text",
      "x": 554,
      "y": 152,
      "width": 200,
      "height": 100,
      "text": "OwnershipManager\n\n.claimOwnership()\n.releaseOwnership()\n.checkOwnership()",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
