{
  "pv": {
    "name": "Terminal Session Management",
    "version": "1.0.0",
    "description": "Lifecycle management of terminal sessions: creation, destruction, ownership, and port management",
    "markdown": ".principal-views/terminal-session-management/terminal-session-management.md",
    "scope": "principal-ade-main",
    "nodeTypes": {
      "renderer": {
        "label": "Renderer",
        "color": "#10B981"
      },
      "tipc-router": {
        "label": "TIPC Router",
        "color": "#6366F1"
      },
      "session-manager": {
        "label": "Session Manager",
        "color": "#F59E0B"
      },
      "ownership-manager": {
        "label": "Ownership Manager",
        "color": "#EC4899"
      },
      "worker": {
        "label": "Worker",
        "color": "#8B5CF6"
      },
      "store": {
        "label": "Store",
        "color": "#3B82F6"
      },
      "port": {
        "label": "Port",
        "color": "#14B8A6"
      },
      "daemon": {
        "label": "PTY Daemon",
        "color": "#EF4444"
      },
      "reconnect": {
        "label": "Reconnect Handler",
        "color": "#22C55E"
      },
      "event": {
        "label": "Event",
        "color": "#3B82F6"
      },
      "boundary": {
        "label": "Boundary",
        "color": "#64748B"
      }
    },
    "edgeTypes": {
      "tipc-invoke": {
        "label": "TIPC Invoke",
        "style": "solid",
        "color": "#6366F1"
      },
      "method-call": {
        "label": "Method Call",
        "style": "solid",
        "color": "#F59E0B"
      },
      "worker-message": {
        "label": "Worker Message",
        "style": "dashed",
        "color": "#8B5CF6"
      },
      "state-update": {
        "label": "State Update",
        "style": "solid",
        "color": "#3B82F6"
      },
      "port-transfer": {
        "label": "Port Transfer",
        "style": "dotted",
        "color": "#14B8A6"
      },
      "daemon-message": {
        "label": "Daemon Message",
        "style": "dashed",
        "color": "#EF4444"
      },
      "reconnect-trigger": {
        "label": "Reconnect Trigger",
        "style": "solid",
        "color": "#22C55E"
      }
    }
  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 250,
      "y": -100,
      "width": 500,
      "height": 50,
      "color": "#64748B",
      "text": "# Terminal Session Management\n**Lifecycle: Creation, Ownership, Destruction**"
    },
    {
      "id": "renderer",
      "type": "otel-event",
      "x": -178,
      "y": 50,
      "width": 200,
      "height": 100,
      "label": "Renderer Process",
      "shape": "rectangle",
      "event": {
        "name": "terminal.session.create_requested",
        "description": "Renderer requested terminal session creation via TIPC",
        "attributes": {
          "cwd": {
            "type": "string",
            "description": "Working directory for session"
          },
          "context": {
            "type": "string",
            "description": "Session context (principal, dashboard, etc.)"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "scope": "principal-ade-renderer",
        "files": [
          "src/renderer/tipc/terminalClient.ts"
        ]
      }
    },
    {
