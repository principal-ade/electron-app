    {
      "id": "state-note",
      "type": "text",
      "x": 800,
      "y": 0,
      "width": 250,
      "height": 200,
      "text": "SESSION STATE\n\nTerminalSession {\n  id: string\n  directory: string\n  context?: string\n  createdAt: number\n  lastActivity: number\n  repoPath?: string\n  repoId?: string\n  owner: TerminalOwner\n  metadata?: Metadata\n}",
      "color": "#F59E0B"
    },
    {
      "id": "limits-note",
      "type": "text",
      "x": 800,
      "y": 230,
      "width": 250,
      "height": 120,
      "text": "LIMITS & TRACKING\n\n- Max sessions: 20\n- Sessions indexed by ID\n- Secondary index by repo\n- Activity integrated here\n- Ports tracked per window",
      "color": "#3B82F6"
    },
    {
      "id": "cleanup-note",
      "type": "text",
      "x": 800,
      "y": 380,
      "width": 250,
      "height": 140,
      "text": "CLEANUP ON DESTROY\n\n1. Close all ports\n2. Remove ownership\n3. Delete from sessions\n4. Delete from activityStore\n5. Remove repo index\n6. Notify WebSocket bridge",
      "color": "#EC4899"
    },
    {
      "id": "sessions-panel",
      "type": "text",
      "x": -278,
      "y": -20,
      "width": 200,
      "height": 120,
      "text": "TerminalSessionsPanel\n\nLeft sidebar panel\n- Lists all sessions\n- Shows ownership\n- Click to switch/focus",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/renderer/panels/terminal-sessions/TerminalSessionsPanel.tsx"
        ],
        "otel": {
          "files": ["src/renderer/panels/terminal-sessions/TerminalSessionsPanel.tsx"]
        },
        "event": {
          "name": "terminal.panel.session_clicked",
          "description": "User clicked a session in the terminal sessions panel",
          "attributes": {
            "session.id": {
              "type": "string",
              "description": "Terminal session ID"
            },
            "is_local": {
              "type": "boolean",
              "description": "Whether session is owned by this window",
              "display": false
            },
            "owner.window_id": {
              "type": "number",
              "description": "Window ID that owns the session",
              "display": false
            },
            "current.window_id": {
              "type": "number",
              "description": "Current window ID making the click",
              "display": false
            }
          }
        }
      }
    },
