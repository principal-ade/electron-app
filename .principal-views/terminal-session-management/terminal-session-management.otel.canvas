  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 250,
      "y": -100,
      "width": 500,
      "height": 50,
      "color": "#64748B",
      "text": "# Terminal Session Management\n**Lifecycle: Creation, Ownership, Destruction**"
    },
    {
      "id": "renderer",
      "type": "text",
      "x": -10,
      "y": 100,
      "width": 200,
      "height": 100,
      "text": "Renderer Process\n\nterminalClient\n.createTerminalSession()",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/renderer/tipc/terminalClient.ts"
        ],
        "otel": {
          "files": ["src/renderer/tipc/terminalClient.ts"]
        },
        "event": {
          "name": "terminal.session.create_requested",
          "description": "Renderer requested terminal session creation via TIPC",
          "attributes": {
            "cwd": {
              "type": "string",
              "description": "Working directory for session"
            },
            "context": {
              "type": "string",
              "description": "Session context (principal, dashboard, etc.)"
            }
          }
        }
      }
    },
    {
      "id": "tipc-router",
      "type": "text",
      "x": 250,
      "y": 50,
      "width": 205,
      "height": 100,
      "text": "terminalRouter\n.createTerminalSession\n\nTIPC procedure handler",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/main/terminal/tipc/terminalRouter.ts"
        ],
        "otel": {
          "files": ["src/main/terminal/tipc/terminalRouter.ts"]
        },
        "event": {
          "name": "terminal.session.router_handled",
          "description": "TIPC router handling session creation",
          "attributes": {
            "window.id": {
              "type": "number",
              "description": "Source window ID"
            },
            "can_create": {
              "type": "boolean",
              "description": "Whether session limit allows creation"
            }
          }
        }
      }
    },
    {
      "id": "session-manager",
      "type": "text",
      "x": 252,
      "y": 350,
      "width": 200,
      "height": 120,
      "text": "TerminalSessionManager\n\n.createSession()\n.destroySession()\n.getAllSessions()\n.updateActivity()",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/main/terminal/TerminalSessionManager.ts"
        ],
        "otel": {
          "files": ["src/main/terminal/tipc/terminalRouter.ts"]
        },
        "event": {
          "name": "terminal.session.manager_action",
          "description": "Session manager performing action",
          "attributes": {
            "action": {
              "type": "string",
              "description": "create, destroy, list, updateActivity"
            },
            "session.id": {
              "type": "string",
              "description": "Terminal session ID"
            }
          }
        }
      }
    },
    {
      "id": "sessions-store",
      "type": "text",
      "x": 552,
      "y": 277,
      "width": 200,
      "height": 120,
      "text": "Session Stores\n\nsessions: Map<id, Session>\nsessionsByRepo: Map\nactivityStore: Map\nsessionPorts: Map",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/main/terminal/TerminalSessionManager.ts"
        ],
        "otel": {
          "files": ["src/main/terminal/tipc/terminalRouter.ts"]
        },
        "event": {
          "name": "terminal.session.store_updated",
          "description": "Session store state changed",
          "attributes": {
            "operation": {
              "type": "string",
              "description": "set, delete, clear"
            },
            "session.id": {
              "type": "string",
              "description": "Terminal session ID"
            },
            "store.size": {
              "type": "number",
              "description": "Current store size"
            }
          }
        }
      }
    },
    {
