    {
      "id": "window-focus",
      "type": "text",
      "x": -278,
      "y": 195,
      "width": 200,
      "height": 100,
      "text": "Window Focus\n\nWindowService\n.focusWindowById()\n→ Focus other window",
      "pv": {
