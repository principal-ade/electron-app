{
  "version": "1.0.0",
  "name": "Session List Sync",
  "description": "Window requesting and receiving terminal session list",
  "canvas": ".principal-views/terminal-session-management/terminal-session-management.otel.canvas",
  "spanPattern": "terminal.session.list",
  "scenarios": [
    {
      "id": "session-list-request",
      "description": "Window requests list of all terminal sessions and data port",
      "priority": 1,
      "template": {
        "introduction": "**Fetching Terminal Sessions**\n\nWindow requesting list of sessions and establishing data ports.",
        "events": {
          "terminal.session.router_handled": "[1] Router handling list: window={{window.id}}, can_create={{can_create}}",
          "terminal.session.manager_action": "[2] Manager {{action}}: session=`{{session.id}}`",
          "terminal.port.worker_registered": "[3] Worker port registered: session=`{{session.id}}`, window={{window.id}}",
          "terminal.port.renderer_connected": "[4] Renderer port connected: session=`{{session.id}}`"
        },
        "summary": "**Session List Retrieved:**\n- Requesting Window: {{window.id}}"
      },
      "filterDefault": true
    }
  ]
}
