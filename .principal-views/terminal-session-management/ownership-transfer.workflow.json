{
  "version": "1.0.0",
  "name": "Ownership Transfer",
  "description": "Terminal session ownership claim and transfer between windows",
  "canvas": ".principal-views/terminal-session-management/terminal-session-management.otel.canvas",
  "spanPattern": "terminal.ownership",
  "scenarios": [
    {
      "id": "ownership-claim",
      "description": "Window claims ownership of session",
      "priority": 1,
      "template": {
        "introduction": "**Claiming Session Ownership**\n\nWindow claiming ownership of terminal session.",
        "events": {
          "terminal.session.router_handled": "[1] Router handling ownership: window={{window.id}}, action={{action}}, can_create={{can_create}}",
          "terminal.ownership.changed": "[2] Ownership changed: session=`{{session.id}}`, new_owner={{new_owner.window_id}}, previous_owner={{previous_owner.window_id}}",
          "terminal.port.worker_registered": "[3] Worker port registered: session=`{{session.id}}`, window={{window.id}}",
          "terminal.port.renderer_connected": "[4] Renderer port connected: session=`{{session.id}}`"
        },
        "summary": "**Ownership Claimed:**\n- Session: `{{session.id}}`\n- New Owner: Window {{new_owner.window_id}}"
      },
      "filterDefault": true
    }
  ]
}
