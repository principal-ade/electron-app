{
  "version": "1.0.0",
  "name": "Session Destruction",
  "description": "Terminal session destruction and cleanup flow",
  "canvas": ".principal-views/terminal-session-management/terminal-session-management.otel.canvas",
  "spanPattern": "terminal.session.destroy",
  "scenarios": [
    {
      "id": "session-destruction",
      "description": "Terminal session destroyed with full cleanup",
      "priority": 1,
      "template": {
        "introduction": "**Destroying Terminal Session**\n\nSession being destroyed with full cleanup of ports and stores.",
        "events": {
          "terminal.session.manager_action": "[1] Manager {{action}}: session=`{{session.id}}`",
          "terminal.session.store_updated": "[2] Store {{operation}}: session=`{{session.id}}`, size={{store.size}}",
          "terminal.sessions.broadcast": "[3] Broadcast: {{sessions.count}} sessions to {{windows.count}} windows"
        },
        "summary": "**Session Destroyed:**\n- Session ID: `{{session.id}}`\n- Cleanup complete"
      },
      "filterDefault": true
    }
  ]
}
