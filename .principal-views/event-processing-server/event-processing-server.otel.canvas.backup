{
  "pv": {
    "name": "Event Processing Server",
    "version": "1.0.0",
    "description": "Agent session event processing server running in Electron utility process. Receives events from Claude, Cline, OpenCode, and Droid agents via HTTP webhooks and processes them through the AgentEventPipeline.",
    "markdown": ".principal-views/event-processing-server/event-processing-server.md",
    "scope": "principal-ade-main",
    "nodeTypes": {
      "main-process": {
        "label": "Main Process",
        "color": "#3B82F6"
      },
      "utility-process": {
        "label": "Utility Process",
        "color": "#8B5CF6"
      },
      "http-server": {
        "label": "HTTP Server",
        "color": "#22C55E"
      },
      "http-endpoint": {
        "label": "HTTP Endpoint",
        "color": "#10B981"
      },
      "pipeline": {
        "label": "Pipeline",
        "color": "#F59E0B"
      },
      "adapter": {
        "label": "Adapter",
        "color": "#14B8A6"
      },
      "cache": {
        "label": "Cache",
        "color": "#0D9488"
      },
      "external-agent": {
        "label": "External Agent",
        "color": "#64748B"
      },
      "renderer": {
        "label": "Renderer",
        "color": "#EC4899"
      },
      "event": {
        "label": "Event",
        "color": "#3B82F6"
      },
      "boundary": {
        "label": "Boundary",
        "color": "#64748B"
      }
    },
    "edgeTypes": {
      "spawns": {
        "label": "Spawns",
        "style": "solid",
        "color": "#64748B"
      },
      "http-post": {
        "label": "HTTP POST",
        "style": "solid",
        "color": "#22C55E"
      },
      "ipc": {
        "label": "IPC",
        "style": "solid",
        "color": "#6366F1"
      },
      "messageport": {
        "label": "MessagePort",
        "style": "solid",
        "color": "#F59E0B"
      },
      "data-flow": {
        "label": "Data Flow",
        "style": "solid",
        "color": "#8B5CF6"
      },
      "processes": {
        "label": "Processes",
        "style": "solid",
        "color": "#F59E0B"
      }
    }
  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 400,
      "y": -120,
      "width": 500,
      "height": 60,
      "color": "#64748B",
      "text": "# Event Processing Server\n**Agent session events from Claude, Cline, OpenCode, Droid**"
    },
    {
      "id": "event-server-manager",
      "type": "text",
      "x": 50,
      "y": 0,
      "width": 240,
      "height": 140,
      "text": "EventServerManager\n(Main Process)\n- start() / stop()\n- spawnWorker()\n- registerPortForWindow()\n- handleWindowBroadcast()",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/main/agent-session-events/EventServerManager.ts"
        ],
        "otel": {
          "files": ["src/main/agent-session-events/EventServerManager.ts"]
        },
        "event": {
          "name": "event.server.manager_started",
          "description": "EventServerManager started and spawned utility process",
          "attributes": {
            "server.port": {
              "type": "number",
              "description": "Port the HTTP server is listening on"
            },
            "auto.start": {
              "type": "boolean",
              "description": "Whether server auto-started"
            }
          }
        }
      }
    },
    {
      "id": "http-event-server",
      "type": "text",
      "x": 340,
      "y": 0,
      "width": 240,
      "height": 140,
      "text": "HttpEventServer\n(Utility Process)\nExpress server\nPort 3043 (prod)\nPort 3045 (dev)",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/event-processing-server/HttpEventServer.ts"
        ],
        "otel": {
          "files": ["src/event-processing-server/HttpEventServer.ts"]
        },
        "event": {
          "name": "event.server.http_started",
          "description": "HTTP server started listening for agent events",
          "attributes": {
            "server.port": {
              "type": "number",
              "description": "Port number (3043 prod, 3045 dev)"
            },
            "endpoints.count": {
              "type": "number",
              "description": "Number of agent endpoints registered"
            }
          }
        }
      }
    },
    {
