          "files": ["src/event-processing-server/HttpEventServer.ts"]
        },
        "event": {
          "name": "event.adapter.repo_resolved",
          "description": "Repository info resolved for event path",
          "attributes": {
            "repo.root": {
              "type": "string",
              "description": "Git repository root path"
            },
            "repo.owner": {
              "type": "string",
              "description": "Repository owner"
            },
            "repo.name": {
              "type": "string",
              "description": "Repository name"
            },
            "cache.hit": {
              "type": "boolean",
              "description": "Whether repo info was cached"
            }
          }
        }
      }
    },
    {
      "id": "git-repo-cache",
      "type": "text",
      "x": 340,
      "y": 480,
      "width": 240,
      "height": 80,
      "text": "GitRepoCache\nLRU cache by git root\nAvoids repeated lookups",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/event-processing-server/EventProcessingServer.ts"
        ],
        "event": {
          "name": "event.cache.repo_lookup",
          "description": "Git repository cache lookup",
          "attributes": {
            "cache.hit": {
              "type": "boolean",
              "description": "Whether lookup was a cache hit"
            },
            "cache.size": {
              "type": "number",
              "description": "Current cache size"
            }
          }
        }
      }
    },
