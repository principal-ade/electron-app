    {
      "id": "agent-event-pipeline",
      "type": "text",
      "x": 340,
      "y": 180,
      "width": 240,
      "height": 120,
      "text": "AgentEventPipeline\n(@principal-ai/\nagent-monitoring)\nprocessRawEvent()\nNormalizes events",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/event-processing-server/HttpEventServer.ts",
          "src/event-processing-server/EventProcessingServer.ts"
        ],
        "otel": {
          "files": ["src/event-processing-server/HttpEventServer.ts"]
        },
        "event": {
          "name": "event.pipeline.event_processed",
          "description": "Event processed through AgentEventPipeline",
          "attributes": {
            "provider": {
              "type": "string",
              "description": "Agent provider (claude, cline, opencode, droid)"
            },
            "session.id": {
              "type": "string",
              "description": "Agent session ID"
            },
            "event.type": {
              "type": "string",
              "description": "Event type (start, stop, tool_use, etc.)"
            },
            "duration_ms": {
              "type": "number",
              "description": "Pipeline processing duration"
            }
          }
        }
      }
    },
    {
      "id": "path-adapter",
      "type": "text",
      "x": 340,
      "y": 340,
      "width": 240,
      "height": 100,
      "text": "ServerPathNormalization\nAdapter\nGit repo detection\nPath resolution",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/event-processing-server/HttpEventServer.ts",
