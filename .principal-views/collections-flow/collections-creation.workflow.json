{
  "version": "1.0.0",
  "name": "Collection Creation",
  "description": "Standard workflow for creating a new collection in an existing GitHub setup",
  "mode": "span-tree",
  "canvas": ".principal-views/collections-flow/collections-flow.otel.canvas",
  "spanPattern": "collections.create",
  "scenarios": [
    {
      "id": "successful-creation-full",
      "description": "User creates a new collection with icon and description, syncs to GitHub",
      "priority": 1,
      "template": {
        "introduction": "**Collection Created Successfully**\n\nCreated collection **\"{{collection.name}}\"** (ID: `{{collection.id}}`) and synchronized to GitHub.\n\nThe collection is now available across all devices.",
        "events": {
          "collections.ui.modal_opened": "User opened {{ui.modal.type}} modal (action: {{user.action}})",
          "collections.ui.create_requested": "User clicked create button in {{ui.component}} (trigger: {{event.trigger}})",
          "collections.context.create_started": "Context received request: **{{collection.name}}** (icon: {{collection.icon}}, description: {{collection.description}})",
          "collections.renderer.ipc_invoked": "Renderer service invoked IPC: {{ipc.method}} (input: {{collection.input}})",
          "collections.preload.forwarded": "Preload bridge forwarded to main process via {{ipc.channel}} ({{ipc.direction}})",
          "collections.main.create_started": "Main process created collection **{{collection.name}}** (`{{collection.id}}`) at {{collection.created_at}}",
          "collections.github.repo_check": "Checking if {{github.repo.name}} exists (authenticated: {{github.user.authenticated}})",
          "collections.github.sync_enabled": "GitHub sync enabled (repo created: {{github.repo.created}}, URL: {{github.repo.url}})",
          "collections.github.repo_created": "Created repository **{{github.repo.name}}** ({{github.repo.visibility}}) - {{http.method}} {{http.url}} -> {{http.status_code}}",
          "collections.github.api_request": "GitHub API {{http.method}} {{http.url}} -> {{http.status_code}} (repo exists: {{github.repo.exists}})",
          "collections.github.sync_started": "Syncing {{collections.count}} collections and {{memberships.count}} memberships",
          "collections.github.file_updated": "{{http.method}} {{http.url}} -> {{http.status_code}}: Updated {{github.file.name}} ({{github.file.size_bytes}} bytes, SHA: {{github.file.sha}})",
          "collections.github.memberships_updated": "{{http.method}} {{http.url}} -> {{http.status_code}}: Updated memberships in {{github.file.name}}",
          "collections.storage.persisted": "**Data persisted** (type: {{storage.type}}) to {{storage.location}} ({{storage.sync.timestamp}})",
          "collections.event.created_emitted": "Event emitted: {{event.type}} for `{{collection.id}}` from {{event.source}}",
          "collections.context.refreshed": "Context refreshed with {{collections.count}} collections (trigger: {{refresh.trigger}})",
          "collections.ui.rendered": "**{{ui.component}} updated in {{render.duration_ms}}ms** (displaying {{collections.displayed}} collections)"
        },
        "summary": "**Collection Details:**\n- Name: **{{collection.name}}**\n- ID: `{{collection.id}}`\n- Icon: {{collection.icon}}\n- Description: {{collection.description}}\n\n**GitHub Storage:**\n- Repository: {{storage.location}}\n- Total collections: {{collections.count}}\n- Sync timestamp: {{storage.sync.timestamp}}\n\n**Performance:**\n- UI render time: {{render.duration_ms}}ms\n\n**Architecture Flow:**\nUI Modal -> Context -> IPC -> Main Process -> GitHub API -> Storage -> Context Refresh -> UI Update"
      }
    }
  ]
}
