{
  "version": "1.0.0",
  "name": "Theme Update",
  "description": "POST /theme/update endpoint for updating theme properties via UserPreferences",
  "mode": "span-tree",
  "canvas": ".principal-views/principal-mcp-bridge/principal-mcp-bridge.otel.canvas",
  "spanPattern": "principal_mcp.theme_update",
  "scenarios": [
    {
      "id": "success",
      "description": "Theme property updated successfully via UserPreferences",
      "priority": 1,
      "template": {
        "introduction": "Updated theme property **{{theme.property_path}}**",
        "events": {
          "principal_mcp.client.request_initiated": "1. Client ({{client.type}}) sent {{http.method}} request to {{http.url}}",
          "principal_mcp.server.request_received": "2. Server received {{http.method}} {{http.path}} on port {{server.port}}",
          "principal_mcp.health.checked": "3. Health: {{health.status}} at {{health.timestamp}} (port {{health.port}})",
          "principal_mcp.theme.schema_requested": "4. Schema context for theme: {{theme.target_theme}}",
          "principal_mcp.theme.schema_retrieved": "5. Schema loaded: **{{theme.name}}** ({{theme.schema_properties_count}} properties, {{theme.available_themes_count}} themes)",
          "principal_mcp.theme.update_requested": "6. Requested update to {{theme.property_path}} for {{theme.target_theme}} (type: {{theme.value_type}})",
          "principal_mcp.theme.preferences_updated": "7. Updated preferences for theme '{{theme.target_theme}}' at path {{theme.property_path}}",
          "principal_mcp.theme.renderer_broadcast": "8. Broadcasting to {{broadcast.window_count}} window(s) via {{broadcast.channel}} (has_overrides: {{broadcast.has_theme_overrides}})",
          "principal_mcp.theme.renderer_notified": "9. Notified {{notification.windows_notified}} renderer window(s) via {{notification.channel}}",
          "principal_mcp.theme.update_completed": "10. Updated {{theme.property_path}} in theme '{{theme.updated_theme}}': success={{theme.success}}, warning={{theme.warning}}, active={{theme.active_theme}}"
        },
        "summary": "Successfully updated {{theme.property_path}} in theme '{{theme.updated_theme}}'"
      }
    },
    {
      "id": "validation-failed",
      "description": "Request validation failed - missing or invalid property path",
      "priority": 2,
      "template": {
        "introduction": "Theme update validation failed",
        "events": {
          "principal_mcp.client.request_initiated": "1. Client ({{client.type}}) sent {{http.method}} request to {{http.url}}",
          "principal_mcp.server.request_received": "2. Server received {{http.method}} {{http.path}} on port {{server.port}}",
          "principal_mcp.health.checked": "3. Health: {{health.status}} at {{health.timestamp}} (port {{health.port}})",
          "principal_mcp.theme.schema_requested": "4. Schema context for theme: {{theme.target_theme}}",
          "principal_mcp.error.validation_failed": "5. Validation error: {{error.message}} (field: {{error.field}})",
          "principal_mcp.error.theme_not_found": "6. Theme '{{theme.requested}}' not found: {{error.message}}",
          "principal_mcp.error.theme_update_failed": "7. Update failed for path {{theme.property_path}}: {{error.message}}"
        },
        "summary": "Update rejected - {{error.message}}"
      }
    },
    {
      "id": "update-failed",
      "description": "Theme update failed during preferences update",
      "priority": 3,
      "template": {
        "introduction": "Theme update failed",
        "events": {
          "principal_mcp.client.request_initiated": "1. Client ({{client.type}}) sent {{http.method}} request to {{http.url}}",
          "principal_mcp.server.request_received": "2. Server received {{http.method}} {{http.path}} on port {{server.port}}",
          "principal_mcp.health.checked": "3. Health: {{health.status}} at {{health.timestamp}} (port {{health.port}})",
          "principal_mcp.theme.schema_requested": "4. Schema context for theme: {{theme.target_theme}}",
          "principal_mcp.theme.schema_retrieved": "5. Schema loaded: **{{theme.name}}** ({{theme.schema_properties_count}} properties, {{theme.available_themes_count}} themes)",
          "principal_mcp.theme.update_requested": "6. Requested update to {{theme.property_path}} for {{theme.target_theme}}",
          "principal_mcp.error.theme_not_found": "7. Theme '{{theme.requested}}' not found: {{error.message}}",
          "principal_mcp.error.theme_update_failed": "8. Update failed for path {{theme.property_path}}: {{error.message}}"
        },
        "summary": "Preferences update failed - {{error.message}}"
      }
    }
  ]
}
