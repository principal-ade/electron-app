{
  "version": "1.0.0",
  "name": "Theme Schema",
  "description": "GET /theme/schema endpoint for retrieving theme documentation and available themes",
  "canvas": ".principal-views/principal-mcp-bridge/principal-mcp-bridge.otel.canvas",
  "spanPattern": "principal_mcp.theme_schema",
  "scenarios": [
    {
      "id": "theme-schema-flow",
      "description": "Theme schema request flow - handles success and errors",
      "priority": 1,
      "template": {
        "introduction": "**Theme Schema Request**\n\nRetrieving theme schema for **{{theme.name}}**",
        "events": {
          "principal_mcp.client.request_initiated": "1. Client ({{client.type}}) sent {{http.method}} request to {{http.url}}",
          "principal_mcp.server.request_received": "2. Server received {{http.method}} {{http.path}} on port {{server.port}}",
          "principal_mcp.health.checked": "3. Health: {{health.status}} at {{health.timestamp}} (port {{health.port}})",
          "principal_mcp.theme.schema_requested": "4. Schema requested for theme: {{theme.target_theme}}",
          "principal_mcp.theme.schema_retrieved": "5. Retrieved **{{theme.name}}** with {{theme.schema_properties_count}} schema properties and {{theme.available_themes_count}} available themes",
          "principal_mcp.error.theme_not_found": "6. Theme '{{theme.requested}}' not found: {{error.message}}",
          "principal_mcp.dependency.resolve_requested": "7. [Dep] Resolving: `{{dependency.id}}` (root: {{repository.root}})",
          "principal_mcp.repo_monitoring.calling": "8. [Dep] Calling repo monitoring for `{{dependency.id}}` (has_root={{has_repository_root}})",
          "principal_mcp.repo_monitoring.result_received": "9. [Dep] Result for `{{dependency.id}}`: found={{found}}, alexandria={{has_alexandria_entry}}, package={{has_package_info}}, suggestions={{has_suggestions}}",
          "principal_mcp.resolution.alexandria_found": "10. [Dep] Alexandria for `{{dependency.id}}`: {{alexandria.name}} at `{{alexandria.path}}` (remote: {{alexandria.remote_url}}, commit: {{alexandria.last_commit_hash}})",
          "principal_mcp.resolution.alexandria_not_found": "11. [Dep] `{{dependency.id}}` not in Alexandria",
          "principal_mcp.resolution.package_found": "12. [Dep] Package: `{{dependency.id}}` -> {{package.name}}@{{package.version}} at `{{package.path}}` (dev: {{package.is_dev_dependency}})",
          "principal_mcp.resolution.package_not_found": "13. [Dep] `{{dependency.id}}` not in packages",
          "principal_mcp.resolution.suggestions_generated": "14. [Dep] Suggestions for `{{dependency.id}}`: {{suggestions.install_commands}} (target: {{suggestions.target_package}}, pm: {{suggestions.package_manager}})",
          "principal_mcp.resolution.no_suggestions": "15. [Dep] No suggestions for `{{dependency.id}}`",
          "principal_mcp.error.validation_failed": "16. [Dep] Validation: {{error.field}} - {{error.message}} (type: {{error.type}})",
          "principal_mcp.error.resolution_failed": "17. [Dep] Resolution failed for `{{dependency.id}}`: {{error.message}} (type: {{error.type}})",
          "principal_mcp.repo_monitoring.dependency_resolved": "18. [Dep] Complete for `{{dependency.id}}`: success={{resolution.success}}, found={{found}}, source={{source}}",
          "principal_mcp.theme.update_requested": "19. [Theme] Update: {{theme.property_path}} for {{theme.target_theme}} (type: {{theme.value_type}})",
          "principal_mcp.theme.preferences_updated": "20. [Theme] Preferences: {{theme.property_path}} for {{theme.target_theme}}",
          "principal_mcp.theme.renderer_broadcast": "21. [Theme] Broadcast: {{broadcast.window_count}} windows via {{broadcast.channel}} (overrides: {{broadcast.has_theme_overrides}})",
          "principal_mcp.theme.renderer_notified": "22. [Theme] Notified: {{notification.windows_notified}} windows via {{notification.channel}}",
          "principal_mcp.theme.update_completed": "23. [Theme] Done: {{theme.property_path}} in {{theme.updated_theme}} (success={{theme.success}}, warning={{theme.warning}}, active={{theme.active_theme}})",
          "principal_mcp.error.theme_update_failed": "24. [Theme] Failed: {{theme.property_path}} - {{error.message}}"
        },
        "summary": "**Theme Schema:**\n- Name: {{theme.name}}\n- Properties: {{theme.schema_properties_count}}\n- Available themes: {{theme.available_themes_count}}"
      }
    }
  ]
}
