            "theme.property_path": {
              "type": "string",
              "description": "Property path being updated (e.g., colors.primary)"
            },
            "theme.value_type": {
              "type": "string",
              "description": "Type of the new value"
            },
            "theme.target_theme": {
              "type": "string",
              "description": "Theme name to update (current if not specified)"
            }
          }
        }
      }
    },
    {
      "id": "theme-prefs-update",
      "type": "text",
      "x": 570,
      "y": 850,
      "width": 200,
      "height": 60,
      "text": "UserPreferencesHandler\nUpdates & Broadcasts",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
