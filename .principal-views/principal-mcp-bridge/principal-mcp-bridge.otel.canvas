            },
            "theme.target_theme": {
              "type": "string",
              "description": "Theme being updated"
            }
          }
        }
      }
    },
    {
      "id": "theme-renderer-broadcast",
      "type": "text",
      "x": 570,
      "y": 930,
      "width": 200,
      "height": 60,
      "text": "Broadcast to\nRenderer Windows",
      "pv": {
        "nodeType": "event",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/main/stores/userPreferencesHandler.ts"
