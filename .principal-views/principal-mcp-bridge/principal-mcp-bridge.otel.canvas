    {
      "id": "bruno-section-title",
      "type": "text",
      "x": 50,
      "y": 1120,
      "width": 500,
      "height": 40,
      "color": "#64748B",
      "text": "## Bruno Validation Routes\n**Routes for validating .bru files and collections**"
    },
    {
      "id": "bruno-validate-route",
      "type": "otel-event",
      "x": 300,
      "y": 1190,
      "width": 220,
      "height": 100,
      "label": "POST /api/bruno/validate",
      "shape": "rectangle",
      "event": {
        "name": "principal_mcp.bruno.validate_content_requested",
        "description": "Validate .bru file content endpoint called",
        "attributes": {
          "bruno.content_length": {
            "type": "number",
            "description": "Length of .bru content in characters"
          }
        }
      },
      "otel": {
