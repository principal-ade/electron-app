{
  "version": "1.0.0",
  "name": "Principal MCP Health Check",
  "description": "Health check endpoint flow for the Principal MCP Bridge",
  "canvas": ".principal-views/principal-mcp-bridge/principal-mcp-bridge.otel.canvas",
  "spanPattern": "principal_mcp.health_check",
  "scenarios": [
    {
      "id": "health-check-success",
      "description": "Health check endpoint returns OK status",
      "priority": 1,
      "template": {
        "introduction": "**Health Check Successful**\n\nThe Principal MCP Bridge health endpoint responded successfully.",
        "events": {
          "principal_mcp.client.request_initiated": "1. Client ({{client.type}}) sent {{http.method}} request to {{http.url}}",
          "principal_mcp.server.request_received": "2. Server received {{http.method}} {{http.path}} on port {{server.port}}",
          "principal_mcp.health.checked": "3. Health status: **{{health.status}}** at {{health.timestamp}} (port {{health.port}})",
          "principal_mcp.dependency.resolve_requested": "4. [Dep] Resolving: `{{dependency.id}}` (root: {{repository.root}})",
          "principal_mcp.repo_monitoring.calling": "5. [Dep] Calling repo monitoring for `{{dependency.id}}` (has_root={{has_repository_root}})",
          "principal_mcp.repo_monitoring.result_received": "6. [Dep] Result for `{{dependency.id}}`: found={{found}}, alexandria={{has_alexandria_entry}}, package={{has_package_info}}, suggestions={{has_suggestions}}",
          "principal_mcp.resolution.alexandria_found": "7. [Dep] Alexandria for `{{dependency.id}}`: {{alexandria.name}} at `{{alexandria.path}}` (remote: {{alexandria.remote_url}}, commit: {{alexandria.last_commit_hash}})",
          "principal_mcp.resolution.alexandria_not_found": "8. [Dep] `{{dependency.id}}` not in Alexandria",
          "principal_mcp.resolution.package_found": "9. [Dep] Package: `{{dependency.id}}` -> {{package.name}}@{{package.version}} at `{{package.path}}` (dev: {{package.is_dev_dependency}})",
          "principal_mcp.resolution.package_not_found": "10. [Dep] `{{dependency.id}}` not in packages",
          "principal_mcp.resolution.suggestions_generated": "11. [Dep] Suggestions for `{{dependency.id}}`: {{suggestions.install_commands}} (target: {{suggestions.target_package}}, pm: {{suggestions.package_manager}})",
          "principal_mcp.resolution.no_suggestions": "12. [Dep] No suggestions for `{{dependency.id}}`",
          "principal_mcp.error.validation_failed": "13. [Dep] Validation: {{error.field}} - {{error.message}} (type: {{error.type}})",
          "principal_mcp.error.resolution_failed": "14. [Dep] Resolution failed for `{{dependency.id}}`: {{error.message}} (type: {{error.type}})",
          "principal_mcp.repo_monitoring.dependency_resolved": "15. [Dep] Complete for `{{dependency.id}}`: success={{resolution.success}}, found={{found}}, source={{source}}",
          "principal_mcp.theme.schema_requested": "16. [Theme] Schema: {{theme.target_theme}}",
          "principal_mcp.theme.schema_retrieved": "17. [Theme] **{{theme.name}}** ({{theme.schema_properties_count}} props, {{theme.available_themes_count}} themes)",
          "principal_mcp.error.theme_not_found": "18. [Theme] '{{theme.requested}}' not found: {{error.message}}",
          "principal_mcp.theme.update_requested": "19. [Theme] Update: {{theme.property_path}} for {{theme.target_theme}} (type: {{theme.value_type}})",
          "principal_mcp.theme.preferences_updated": "20. [Theme] Preferences: {{theme.property_path}} for {{theme.target_theme}}",
          "principal_mcp.theme.renderer_broadcast": "21. [Theme] Broadcast: {{broadcast.window_count}} windows via {{broadcast.channel}} (overrides: {{broadcast.has_theme_overrides}})",
          "principal_mcp.theme.renderer_notified": "22. [Theme] Notified: {{notification.windows_notified}} windows via {{notification.channel}}",
          "principal_mcp.theme.update_completed": "23. [Theme] Done: {{theme.property_path}} in {{theme.updated_theme}} (success={{theme.success}}, warning={{theme.warning}}, active={{theme.active_theme}})",
          "principal_mcp.error.theme_update_failed": "24. [Theme] Failed: {{theme.property_path}} - {{error.message}}"
        },
        "summary": "**Health Status:**\n- Status: {{health.status}}\n- Port: {{health.port}}\n- Timestamp: {{health.timestamp}}\n\nThe bridge is running and accepting requests."
      }
    }
  ]
}
