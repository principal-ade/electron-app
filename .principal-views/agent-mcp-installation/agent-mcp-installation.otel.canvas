{
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 300,
      "y": -100,
      "width": 500,
      "height": 60,
      "color": "#64748B",
      "text": "# Agent MCP Installation\n**Configure MCP servers for Claude, Cline, OpenCode, and Droid**"
    },
    {
      "id": "setup-wizard",
      "type": "otel-event",
      "x": 50,
      "y": 50,
      "width": 200,
      "height": 100,
      "label": "AgentSetupWizard",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.ui.toggle_clicked",
        "description": "User clicks the MCP enable/disable toggle button",
        "attributes": {
          "agent.type": {
            "type": "string",
            "description": "Agent type: claude, cline, opencode, droid"
          },
          "mcp.current_status": {
            "type": "boolean",
            "description": "Current MCP enabled status before toggle"
          },
          "mcp.action": {
            "type": "string",
            "description": "Action being performed: enable or disable"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "detailed-view",
      "type": "otel-event",
      "x": 50,
      "y": 180,
      "width": 200,
      "height": 100,
      "label": "DetailedConfigurationView",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.ui.detailed_view_opened",
        "description": "User opens the detailed MCP configuration view",
        "attributes": {
          "agent.type": {
            "type": "string",
            "description": "Agent type being configured"
          },
          "view.mode": {
            "type": "string",
            "description": "Current view mode: hooks, mcp, install"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "renderer-service",
      "type": "otel-event",
      "x": 300,
      "y": 50,
      "width": 220,
      "height": 100,
      "label": "AgentConfigurationService",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.service.request_initiated",
        "description": "Renderer service initiates MCP operation request",
        "attributes": {
          "agent.type": {
            "type": "string",
            "description": "Agent type"
          },
          "operation": {
            "type": "string",
            "description": "Operation: addMCPToAgent, removeMCPFromAgent, getAgentMCPStatus"
          },
          "server.name": {
            "type": "string",
            "description": "MCP server name being configured"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "ipc-add-mcp",
      "type": "otel-event",
      "x": 570,
      "y": 50,
      "width": 200,
      "height": 80,
      "label": "IPC Handler",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.ipc.add_mcp_received",
        "description": "Main process receives add MCP request via IPC",
        "attributes": {
          "agent.type": {
            "type": "string",
            "description": "Agent type"
          },
          "server.name": {
            "type": "string",
            "description": "Server name to add"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "ipc-remove-mcp",
      "type": "otel-event",
      "x": 570,
      "y": 150,
      "width": 200,
      "height": 80,
      "label": "IPC Handler",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.ipc.remove_mcp_received",
        "description": "Main process receives remove MCP request via IPC",
        "attributes": {
          "agent.type": {
            "type": "string",
            "description": "Agent type"
          },
          "server.name": {
            "type": "string",
            "description": "Server name to remove"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "ipc-get-status",
      "type": "otel-event",
      "x": 570,
      "y": 250,
      "width": 200,
      "height": 80,
      "label": "IPC Handler",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.ipc.get_status_received",
        "description": "Main process receives get MCP status request via IPC",
        "attributes": {
          "agent.type": {
            "type": "string",
            "description": "Agent type"
          },
          "server.name": {
            "type": "string",
            "description": "Server name to check"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "agent-manager-lib",
      "type": "otel-event",
      "x": 840,
      "y": 50,
      "width": 220,
      "height": 100,
      "label": "@principal-ade/agent-manager",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.library.operation_called",
        "description": "External agent-manager library function called",
        "attributes": {
          "agent.type": {
            "type": "string",
            "description": "Agent type"
          },
          "library.function": {
            "type": "string",
            "description": "Function called: enableAgentMCP, disableAgentMCP, getAgentMCPStatus"
          },
          "server.name": {
            "type": "string",
            "description": "Server name parameter"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "claude-config",
      "type": "otel-event",
      "x": 1100,
      "y": 50,
      "width": 200,
      "height": 80,
      "label": "Claude Config",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.config.claude_updated",
        "description": "Claude configuration file updated with MCP server",
        "attributes": {
          "config.path": {
            "type": "string",
            "description": "Path to config file: ~/.claude.json"
          },
          "mcp.server_count": {
            "type": "number",
            "description": "Number of MCP servers after update"
          },
          "mcp.has_principal": {
            "type": "boolean",
            "description": "Whether principal-mcp server is configured"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "cline-config",
      "type": "otel-event",
      "x": 1100,
      "y": 150,
      "width": 200,
      "height": 80,
      "label": "Cline Config",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.config.cline_updated",
        "description": "Cline configuration updated with MCP server",
        "attributes": {
          "config.path": {
            "type": "string",
            "description": "Path to Cline config"
          },
          "mcp.server_count": {
            "type": "number",
            "description": "Number of MCP servers after update"
          },
          "mcp.has_principal": {
            "type": "boolean",
            "description": "Whether principal-mcp server is configured"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "opencode-config",
      "type": "otel-event",
      "x": 1100,
      "y": 250,
      "width": 200,
      "height": 80,
      "label": "OpenCode Config",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.config.opencode_updated",
        "description": "OpenCode configuration updated with MCP server",
        "attributes": {
          "config.path": {
            "type": "string",
            "description": "Path to config: ~/.config/openCode/openCode.json"
          },
          "mcp.server_count": {
            "type": "number",
            "description": "Number of MCP servers after update"
          },
          "mcp.has_principal": {
            "type": "boolean",
            "description": "Whether principal-mcp server is configured"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "droid-config",
      "type": "otel-event",
      "x": 1100,
      "y": 350,
      "width": 200,
      "height": 80,
      "label": "Droid Config",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.config.droid_updated",
        "description": "Droid configuration updated with MCP server",
        "attributes": {
          "config.path": {
            "type": "string",
            "description": "Path to config: ~/.factory/mcp.json"
          },
          "mcp.server_count": {
            "type": "number",
            "description": "Number of MCP servers after update"
          },
          "mcp.has_principal": {
            "type": "boolean",
            "description": "Whether principal-mcp server is configured"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "operation-success",
      "type": "otel-event",
      "x": 840,
      "y": 200,
      "width": 200,
      "height": 80,
      "label": "Operation Success",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.operation.success",
        "description": "MCP operation completed successfully",
        "attributes": {
          "agent.type": {
            "type": "string",
            "description": "Agent type"
          },
          "operation": {
            "type": "string",
            "description": "Operation performed"
          },
          "result.has_mcp": {
            "type": "boolean",
            "description": "Whether agent now has MCP configured"
          },
          "result.mcp_count": {
            "type": "number",
            "description": "Total number of MCP servers"
          },
          "result.config_path": {
            "type": "string",
            "description": "Path to the updated config file"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "operation-error",
      "type": "otel-event",
      "x": 840,
      "y": 320,
      "width": 200,
      "height": 80,
      "label": "Operation Error",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.operation.error",
        "description": "MCP operation failed",
        "attributes": {
          "agent.type": {
            "type": "string",
            "description": "Agent type"
          },
          "operation": {
            "type": "string",
            "description": "Operation that failed"
          },
          "error.message": {
            "type": "string",
            "description": "Error message"
          },
          "error.type": {
            "type": "string",
            "description": "Error type: config_not_found, write_failed, parse_error"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "ui-state-updated",
      "type": "otel-event",
      "x": 300,
      "y": 200,
      "width": 220,
      "height": 80,
      "label": "UI State Updated",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.ui.state_updated",
        "description": "UI state updated after MCP operation",
        "attributes": {
          "agent.type": {
            "type": "string",
            "description": "Agent type"
          },
          "ui.mcp_enabled": {
            "type": "boolean",
            "description": "New MCP enabled state"
          },
          "ui.server_count": {
            "type": "number",
            "description": "Number of configured servers"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "ui-error-shown",
      "type": "otel-event",
      "x": 300,
      "y": 320,
      "width": 220,
      "height": 80,
      "label": "Error Displayed",
      "shape": "rectangle",
      "event": {
        "name": "agent_mcp.ui.error_displayed",
        "description": "Error message displayed to user",
        "attributes": {
          "agent.type": {
            "type": "string",
            "description": "Agent type"
          },
          "error.message": {
            "type": "string",
            "description": "Error message shown to user"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "app-branding",
      "type": "text",
      "x": 50,
      "y": 320,
      "width": 200,
      "height": 100,
      "text": "**Config Source**\nAPP_BRANDING.\nMCP_SERVER_CONFIG_KEY\nDefines server name",
      "color": "#64748B"
    },
    {
      "id": "supported-agents",
      "type": "text",
      "x": 50,
      "y": 450,
      "width": 200,
      "height": 120,
      "text": "**Supported Agents**\n- Claude (~/.claude.json)\n- Cline (VS Code ext)\n- OpenCode (config)\n- Droid (~/.factory/)",
      "color": "#64748B"
    }
  ],
  "edges": [
    {
      "id": "wizard-to-service",
      "fromNode": "setup-wizard",
      "fromSide": "right",
      "toNode": "renderer-service",
      "toSide": "left",
      "label": "handleMCPToggle()",
      "edgeType": "uses"
    },
    {
      "id": "detailed-to-service",
      "fromNode": "detailed-view",
      "fromSide": "right",
      "toNode": "renderer-service",
      "toSide": "left",
      "label": "toggle MCP",
      "edgeType": "uses"
    },
    {
      "id": "service-to-add-ipc",
      "fromNode": "renderer-service",
      "fromSide": "right",
      "toNode": "ipc-add-mcp",
      "toSide": "left",
      "label": "addMCPToAgent()",
      "edgeType": "ipc"
    },
    {
      "id": "service-to-remove-ipc",
      "fromNode": "renderer-service",
      "fromSide": "right",
      "toNode": "ipc-remove-mcp",
      "toSide": "left",
      "label": "removeMCPFromAgent()",
      "edgeType": "ipc"
    },
    {
      "id": "service-to-status-ipc",
      "fromNode": "renderer-service",
      "fromSide": "right",
      "toNode": "ipc-get-status",
      "toSide": "left",
      "label": "getAgentMCPStatus()",
      "edgeType": "ipc"
    },
    {
      "id": "add-ipc-to-lib",
      "fromNode": "ipc-add-mcp",
      "fromSide": "right",
      "toNode": "agent-manager-lib",
      "toSide": "left",
      "label": "enableAgentMCP()",
      "edgeType": "uses"
    },
    {
      "id": "remove-ipc-to-lib",
      "fromNode": "ipc-remove-mcp",
      "fromSide": "right",
      "toNode": "agent-manager-lib",
      "toSide": "left",
      "label": "disableAgentMCP()",
      "edgeType": "uses"
    },
    {
      "id": "status-ipc-to-lib",
      "fromNode": "ipc-get-status",
      "fromSide": "right",
      "toNode": "agent-manager-lib",
      "toSide": "left",
      "label": "getAgentMCPStatus()",
      "edgeType": "uses"
    },
    {
      "id": "lib-to-claude",
      "fromNode": "agent-manager-lib",
      "fromSide": "right",
      "toNode": "claude-config",
      "toSide": "left",
      "label": "if claude",
      "edgeType": "uses"
    },
    {
      "id": "lib-to-cline",
      "fromNode": "agent-manager-lib",
      "fromSide": "right",
      "toNode": "cline-config",
      "toSide": "left",
      "label": "if cline",
      "edgeType": "uses"
    },
    {
      "id": "lib-to-opencode",
      "fromNode": "agent-manager-lib",
      "fromSide": "right",
      "toNode": "opencode-config",
      "toSide": "left",
      "label": "if opencode",
      "edgeType": "uses"
    },
    {
      "id": "lib-to-droid",
      "fromNode": "agent-manager-lib",
      "fromSide": "right",
      "toNode": "droid-config",
      "toSide": "left",
      "label": "if droid",
      "edgeType": "uses"
    },
    {
      "id": "lib-to-success",
      "fromNode": "agent-manager-lib",
      "fromSide": "bottom",
      "toNode": "operation-success",
      "toSide": "top",
      "label": "success",
      "edgeType": "uses"
    },
    {
      "id": "lib-to-error",
      "fromNode": "agent-manager-lib",
      "fromSide": "bottom",
      "toNode": "operation-error",
      "toSide": "top",
      "label": "catch error",
      "edgeType": "uses"
    },
    {
      "id": "success-to-service",
      "fromNode": "operation-success",
      "fromSide": "left",
      "toNode": "renderer-service",
      "toSide": "right",
      "label": "return status",
      "edgeType": "ipc"
    },
    {
      "id": "error-to-service",
      "fromNode": "operation-error",
      "fromSide": "left",
      "toNode": "renderer-service",
      "toSide": "right",
      "label": "return error",
      "edgeType": "uses"
    },
    {
      "id": "service-to-ui-success",
      "fromNode": "renderer-service",
      "fromSide": "bottom",
      "toNode": "ui-state-updated",
      "toSide": "top",
      "label": "update state",
      "edgeType": "uses"
    },
    {
      "id": "service-to-ui-error",
      "fromNode": "renderer-service",
      "fromSide": "bottom",
      "toNode": "ui-error-shown",
      "toSide": "top",
      "label": "show error",
      "edgeType": "uses"
    }
  ],
  "name": "Agent MCP Installation",
  "description": "Flow for installing and configuring MCP servers for AI agents (Claude, Cline, OpenCode, Droid)",
  "markdown": ".principal-views/agent-mcp-installation/agent-mcp-installation.md",
  "nodeTypes": {
    "ui-component": {
      "label": "UI Component",
      "color": "#3B82F6"
