{
  "pv": {
    "name": "File City Images",
    "version": "1.0.0",
    "description": "File City visualization image generation for repository project cards",
    "markdown": ".principal-views/file-city-images/file-city-images.md",
    "nodeTypes": {
      "event": {
        "label": "Event",
        "color": "#3B82F6"
      },
      "boundary": {
        "label": "Boundary",
        "color": "#64748B"
      }
    },
    "edgeTypes": {
      "function-call": {
        "label": "Function Call",
        "style": "solid",
        "color": "#3B82F6"
      },
      "cache-check": {
        "label": "Cache Check",
        "style": "dashed",
        "color": "#8B5CF6"
      },
      "data-flow": {
        "label": "Data Flow",
        "style": "solid",
        "color": "#22C55E"
      }
    }
  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 250,
      "y": -50,
      "width": 400,
      "height": 50,
      "color": "#64748B",
      "text": "# File City Image Generation\n**PNG visualization for repository cards**"
    },
    {
      "id": "image-requested",
      "type": "otel-event",
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "label": "Image Requested",
      "shape": "rectangle",
      "event": {
        "name": "file_city.image.requested",
        "description": "Image generation requested for a repository",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Absolute path to the repository",
            "required": true
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/main/stores/FileCityImageService.ts"
        ]
      }
    },
    {
      "id": "cache-check",
      "type": "otel-event",
      "x": 100,
      "y": 200,
      "width": 200,
      "height": 100,
      "label": "Cache Check",
      "shape": "rectangle",
      "event": {
        "name": "file_city.cache.checked",
        "description": "Checked disk cache for existing image",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path",
            "required": true
          },
          "cache_key": {
            "type": "string",
            "description": "SHA256 hash used as cache key",
            "required": true
          },
          "cache_hit": {
            "type": "boolean",
            "description": "Whether cached image was found",
            "required": true
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/main/stores/FileCityImageService.ts"
        ]
      }
    },
    {
      "id": "cache-hit",
      "type": "otel-event",
      "x": 400,
      "y": 200,
      "width": 200,
      "height": 100,
      "label": "Cache Hit",
      "shape": "rectangle",
      "event": {
        "name": "file_city.image.cache_hit",
        "description": "Cached image found and returned",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path",
            "required": true
          },
          "cache_path": {
            "type": "string",
            "description": "Path to cached PNG file",
            "required": true
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/main/stores/FileCityImageService.ts"
        ]
      }
    },
    {
      "id": "get-filetree",
      "type": "otel-event",
      "x": 100,
      "y": 350,
      "width": 200,
      "height": 100,
      "label": "Get FileTree",
      "shape": "rectangle",
      "event": {
        "name": "file_city.filetree.fetched",
        "description": "FileTree fetched from repository-monitoring cache",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path",
            "required": true
          },
          "file_count": {
            "type": "integer",
            "description": "Number of files in tree"
          },
          "tree_sha": {
            "type": "string",
            "description": "SHA of the file tree"
          },
          "has_tree": {
            "type": "boolean",
            "description": "Whether file tree was available",
            "required": true
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/main/stores/FileCityImageService.ts"
        ]
      }
    },
    {
      "id": "no-filetree",
      "type": "otel-event",
      "x": 400,
      "y": 350,
      "width": 200,
      "height": 100,
      "label": "No FileTree",
      "shape": "rectangle",
      "event": {
        "name": "file_city.image.skipped",
        "description": "Image generation skipped - no file tree available",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path",
            "required": true
          },
          "reason": {
            "type": "string",
            "description": "Why generation was skipped",
            "required": true
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/main/stores/FileCityImageService.ts"
        ]
      }
    },
    {
      "id": "generate-image",
      "type": "otel-event",
      "x": 100,
      "y": 500,
      "width": 200,
      "height": 100,
      "label": "Generate Image",
      "shape": "rectangle",
      "event": {
        "name": "file_city.image.generation_started",
        "description": "Started generating File City image",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path",
            "required": true
          },
          "file_count": {
            "type": "integer",
            "description": "Number of files to visualize",
            "required": true
          },
          "image_width": {
            "type": "integer",
            "description": "Output image width in pixels"
          },
          "image_height": {
            "type": "integer",
            "description": "Output image height in pixels"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/main/stores/FileCityImageService.ts"
        ]
      }
    },
    {
      "id": "save-cache",
      "type": "otel-event",
      "x": 100,
      "y": 650,
      "width": 200,
      "height": 100,
      "label": "Save to Cache",
      "shape": "rectangle",
      "event": {
        "name": "file_city.image.generation_complete",
        "description": "Image generated and saved to cache",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path",
            "required": true
          },
          "cache_path": {
            "type": "string",
            "description": "Path where image was saved",
            "required": true
          },
          "duration_ms": {
            "type": "integer",
            "description": "Time taken to generate image"
          },
          "file_size_bytes": {
            "type": "integer",
            "description": "Size of generated PNG"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/main/stores/FileCityImageService.ts"
        ]
      }
    },
    {
      "id": "generation-error",
      "type": "otel-event",
      "x": 400,
      "y": 500,
      "width": 200,
      "height": 100,
      "label": "Error",
      "shape": "rectangle",
      "event": {
        "name": "file_city.image.error",
        "description": "Error occurred during image generation",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path",
            "required": true
          },
          "error_type": {
            "type": "string",
            "description": "Type of error",
            "required": true
          },
          "error_message": {
            "type": "string",
            "description": "Error message",
            "required": true
          },
          "phase": {
            "type": "string",
            "description": "Phase where error occurred (cache_check, filetree_fetch, generation, save)"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/main/stores/FileCityImageService.ts"
        ]
      }
    },
    {
      "id": "renderer-section",
      "type": "text",
      "x": 700,
      "y": -50,
      "width": 400,
      "height": 50,
      "color": "#64748B",
      "text": "# Renderer Process\n**ProjectInfoPanel image display**"
    },
    {
      "id": "renderer-action-called",
      "type": "otel-event",
      "x": 700,
      "y": 50,
      "width": 200,
      "height": 100,
      "label": "Action Called",
      "shape": "rectangle",
      "event": {
        "name": "file_city.renderer.action_called",
        "description": "Renderer action called to fetch File City image",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path requested",
            "required": true
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/renderer/panels/ProjectInfoPanel.tsx"
        ]
      }
    },
    {
      "id": "renderer-url-received",
      "type": "otel-event",
      "x": 700,
      "y": 200,
      "width": 200,
      "height": 100,
      "label": "URL Received",
      "shape": "rectangle",
      "event": {
        "name": "file_city.renderer.url_received",
        "description": "URL received from main process",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path",
            "required": true
          },
          "url": {
            "type": "string",
            "description": "file:// URL or null"
          },
          "has_url": {
            "type": "boolean",
            "description": "Whether a URL was returned",
            "required": true
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/renderer/panels/ProjectInfoPanel.tsx"
        ]
      }
    },
    {
      "id": "renderer-state-updated",
      "type": "otel-event",
      "x": 700,
      "y": 350,
      "width": 200,
      "height": 100,
      "label": "State Updated",
      "shape": "rectangle",
      "event": {
        "name": "file_city.renderer.state_updated",
        "description": "React state updated with image URL",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path",
            "required": true
          },
          "url": {
            "type": "string",
            "description": "URL set in state"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/renderer/panels/ProjectInfoPanel.tsx"
        ]
      }
    },
    {
      "id": "renderer-card-rendered",
      "type": "otel-event",
      "x": 700,
      "y": 500,
      "width": 200,
      "height": 100,
      "label": "Card Rendered",
      "shape": "rectangle",
      "event": {
        "name": "file_city.renderer.card_rendered",
        "description": "LocalProjectCard rendered with image URL",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path",
            "required": true
          },
          "has_custom_image": {
            "type": "boolean",
            "description": "Whether customImageUrl prop was provided",
            "required": true
          },
          "image_url": {
            "type": "string",
            "description": "The customImageUrl prop value"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/renderer/panels/ProjectInfoPanel.tsx"
        ]
      }
    },
    {
      "id": "playback-section",
      "type": "text",
      "x": 1000,
      "y": -50,
      "width": 400,
      "height": 50,
      "color": "#64748B",
      "text": "# Commit History Playback\n**Animate through historical visualizations**"
    },
    {
      "id": "playback-started",
      "type": "otel-event",
      "x": 1000,
      "y": 50,
      "width": 200,
      "height": 100,
      "label": "Playback Started",
      "shape": "rectangle",
      "event": {
        "name": "commit_history.playback.started",
        "description": "User started commit history playback",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path",
            "required": true
          },
          "mode": {
            "type": "string",
            "description": "Playback mode (today, week, year)",
            "required": true
          }
        }
      },
      "otel": {
        "status": "not-implemented",
        "files": [
          "src/renderer/panels/ProjectInfoPanel.tsx"
        ]
      }
    },
    {
      "id": "commits-fetched",
      "type": "otel-event",
      "x": 1000,
      "y": 200,
      "width": 200,
      "height": 100,
      "label": "Commits Fetched",
      "shape": "rectangle",
      "event": {
        "name": "commit_history.commits.fetched",
        "description": "Commits fetched for playback range",
        "attributes": {
          "commit_count": {
            "type": "integer",
            "description": "Number of commits found",
            "required": true
          },
          "start_date": {
            "type": "string",
            "description": "Start date of range",
            "required": true
          },
          "end_date": {
            "type": "string",
            "description": "End date of range",
            "required": true
          }
        }
      },
      "otel": {
        "status": "not-implemented",
        "files": [
          "src/renderer/panels/ProjectInfoPanel.tsx",
          "src/renderer/main-process-api/GitService.ts"
        ]
      }
    },
    {
      "id": "commit-loading",
      "type": "otel-event",
      "x": 1000,
      "y": 350,
      "width": 200,
      "height": 100,
      "label": "Loading Commit",
      "shape": "rectangle",
      "event": {
        "name": "commit_history.commit.loading",
        "description": "Loading a specific commit for display",
        "attributes": {
          "commit_hash": {
            "type": "string",
            "description": "Git commit hash",
            "required": true
          },
          "commit_message": {
            "type": "string",
            "description": "Commit message",
            "required": true
          },
          "current": {
            "type": "integer",
            "description": "Current index in playback",
            "required": true
          },
          "total": {
            "type": "integer",
            "description": "Total commits to play",
            "required": true
          }
        }
      },
      "otel": {
        "status": "not-implemented",
        "files": [
          "src/renderer/panels/ProjectInfoPanel.tsx"
        ]
      }
    },
    {
      "id": "historical-image-generated",
      "type": "otel-event",
      "x": 1000,
      "y": 500,
      "width": 200,
      "height": 100,
      "label": "Image Generated",
      "shape": "rectangle",
      "event": {
        "name": "commit_history.image.generated",
        "description": "Historical File City image generated for commit",
        "attributes": {
          "commit_hash": {
            "type": "string",
            "description": "Git commit hash",
            "required": true
          },
          "file_count": {
            "type": "integer",
            "description": "Number of files in tree at this commit",
            "required": true
          }
        }
      },
      "otel": {
        "status": "not-implemented",
        "files": [
          "src/renderer/panels/ProjectInfoPanel.tsx",
          "src/main/stores/FileCityImageService.ts"
        ]
      }
    },
    {
      "id": "playback-completed",
      "type": "otel-event",
      "x": 1000,
      "y": 650,
      "width": 200,
      "height": 100,
      "label": "Playback Completed",
      "shape": "rectangle",
      "event": {
        "name": "commit_history.playback.completed",
        "description": "Playback finished (completed or cancelled)",
        "attributes": {
          "total": {
            "type": "integer",
            "description": "Total commits played",
            "required": true
          },
          "cancelled": {
            "type": "boolean",
            "description": "Whether playback was cancelled by user",
            "required": true
          }
        }
      },
      "otel": {
        "status": "not-implemented",
        "files": [
          "src/renderer/panels/ProjectInfoPanel.tsx"
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "request-to-cache",
      "fromNode": "image-requested",
      "fromSide": "bottom",
      "toNode": "cache-check",
      "toSide": "top",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "cache-to-hit",
      "fromNode": "cache-check",
      "fromSide": "right",
      "toNode": "cache-hit",
      "toSide": "left",
      "label": "found",
      "pv": {
        "edgeType": "cache-check"
      }
    },
    {
      "id": "cache-to-filetree",
      "fromNode": "cache-check",
      "fromSide": "bottom",
      "toNode": "get-filetree",
      "toSide": "top",
      "label": "not found",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "filetree-to-no",
      "fromNode": "get-filetree",
      "fromSide": "right",
      "toNode": "no-filetree",
      "toSide": "left",
      "label": "no tree",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "filetree-to-generate",
      "fromNode": "get-filetree",
      "fromSide": "bottom",
      "toNode": "generate-image",
      "toSide": "top",
      "label": "has tree",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "generate-to-save",
      "fromNode": "generate-image",
      "fromSide": "bottom",
      "toNode": "save-cache",
      "toSide": "top",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "generate-to-error",
      "fromNode": "generate-image",
      "fromSide": "right",
      "toNode": "generation-error",
      "toSide": "left",
      "label": "error",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "renderer-action-to-request",
      "fromNode": "renderer-action-called",
      "fromSide": "left",
      "toNode": "image-requested",
      "toSide": "right",
      "label": "IPC",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "cache-hit-to-renderer",
      "fromNode": "cache-hit",
      "fromSide": "right",
      "toNode": "renderer-url-received",
      "toSide": "left",
      "label": "IPC response",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "save-to-renderer",
      "fromNode": "save-cache",
      "fromSide": "right",
      "toNode": "renderer-url-received",
      "toSide": "left",
      "label": "IPC response",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "renderer-url-to-state",
      "fromNode": "renderer-url-received",
      "fromSide": "bottom",
      "toNode": "renderer-state-updated",
      "toSide": "top",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "renderer-state-to-card",
      "fromNode": "renderer-state-updated",
      "fromSide": "bottom",
      "toNode": "renderer-card-rendered",
      "toSide": "top",
      "label": "re-render",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "playback-to-commits",
      "fromNode": "playback-started",
      "fromSide": "bottom",
      "toNode": "commits-fetched",
      "toSide": "top",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "commits-to-loading",
      "fromNode": "commits-fetched",
      "fromSide": "bottom",
      "toNode": "commit-loading",
      "toSide": "top",
      "label": "for each",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "loading-to-image",
      "fromNode": "commit-loading",
      "fromSide": "bottom",
      "toNode": "historical-image-generated",
      "toSide": "top",
      "pv": {
        "edgeType": "function-call"
      }
    },
    {
      "id": "image-to-loading",
      "fromNode": "historical-image-generated",
      "fromSide": "left",
      "toNode": "commit-loading",
      "toSide": "left",
      "label": "next commit",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "image-to-completed",
      "fromNode": "historical-image-generated",
      "fromSide": "bottom",
      "toNode": "playback-completed",
      "toSide": "top",
      "label": "last commit",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "loading-to-generate",
      "fromNode": "commit-loading",
      "fromSide": "left",
      "toNode": "generate-image",
      "toSide": "right",
      "label": "IPC",
      "pv": {
        "edgeType": "function-call"
      }
    }
  ]
}
