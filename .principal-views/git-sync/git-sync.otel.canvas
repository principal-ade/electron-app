    {
      "id": "lock-acquire",
      "type": "otel-event",
      "x": -200,
      "y": 320,
      "width": 220,
      "height": 100,
      "label": "Acquire Lock",
      "shape": "rectangle",
      "event": {
        "name": "git_sync.lock.acquire_requested",
        "description": "Request to acquire exclusive lock on a resource",
        "attributes": {
          "resource": {
            "type": "string",
            "description": "Resource path being locked"
          },
          "resource_type": {
            "type": "string",
            "description": "Type of resource (file, directory)"
          },
          "exclusive": {
            "type": "boolean",
            "description": "Whether lock is exclusive"
          },
          "duration": {
            "type": "number",
            "description": "Requested lock duration in ms"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-renderer",
        "files": [
          "src/renderer/services/git-sync/GitSyncClient.ts"
        ]
      }
    },
