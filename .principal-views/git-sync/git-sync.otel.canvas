{
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 300,
      "y": -120,
      "width": 500,
      "height": 60,
      "color": "#64748B",
      "text": "# Git Sync Feature\n**Real-time collaboration via WebSocket to Traffic Controller**"
    },
    {
      "id": "auth-init",
      "type": "otel-event",
      "x": -200,
      "y": 0,
      "width": 220,
      "height": 100,
      "label": "Auth Initialize",
      "shape": "rectangle",
      "event": {
        "name": "git_sync.auth.initialize",
        "description": "GitSyncConnectionManager initializes authentication by checking CLI auth state",
        "attributes": {
          "auth.method": {
            "type": "string",
            "description": "Authentication method (cli, oauth)"
          },
          "auth.success": {
            "type": "boolean",
            "description": "Whether initial auth check succeeded"
          },
          "user.login": {
            "type": "string",
            "description": "GitHub username if authenticated"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-renderer",
        "files": [
          "src/renderer/services/git-sync/GitSyncConnectionManager.ts"
        ]
      }
    },
    {
      "id": "room-token-request",
      "type": "otel-event",
      "x": 100,
      "y": 0,
      "width": 220,
      "height": 100,
      "label": "Request Room Token",
      "shape": "rectangle",
      "event": {
        "name": "git_sync.auth.room_token_requested",
        "description": "Request room-specific JWT token from OAuth server",
        "attributes": {
          "repository": {
            "type": "string",
            "description": "Repository ID (owner/repo)"
          },
          "branch": {
            "type": "string",
            "description": "Branch name"
          },
          "device_id": {
            "type": "string",
            "description": "Stable device identifier"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-main",
        "files": [
          "src/main/services/GitSyncWebSocketManager.ts"
        ]
      }
    },
    {
      "id": "room-token-received",
      "type": "otel-event",
      "x": 400,
      "y": 0,
      "width": 220,
      "height": 100,
      "label": "Room Token Received",
      "shape": "rectangle",
      "event": {
        "name": "git_sync.auth.room_token_received",
        "description": "Received JWT room token from OAuth server",
        "attributes": {
          "permissions.canRead": {
            "type": "boolean",
            "description": "Read permission granted"
          },
          "permissions.canWrite": {
            "type": "boolean",
            "description": "Write permission granted"
          },
          "expires_in": {
            "type": "number",
            "description": "Token expiration time in seconds"
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-ade-main",
        "files": [
          "src/main/services/GitSyncWebSocketManager.ts"
        ]
      }
    },
    {
      "id": "ws-connect",
      "type": "otel-event",
      "x": -200,
      "y": 150,
      "width": 220,
      "height": 100,
      "label": "WebSocket Connect",
      "shape": "rectangle",
      "event": {
        "name": "git_sync.connection.connect",
