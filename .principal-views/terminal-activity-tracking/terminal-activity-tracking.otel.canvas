          "description": "Agent started working - session added to store",
          "attributes": {
            "session.id": {
              "type": "string",
              "description": "Terminal session ID"
            },
            "store.size": {
              "type": "number",
              "description": "Current number of active sessions"
            }
          }
        }
      }
    },
    {
      "id": "agent-stopped",
      "type": "text",
      "x": 323,
      "y": 431,
      "width": 180,
      "height": 100,
      "text": "Agent Stopped\n\nactivityStore.delete()\nSession removed",
      "pv": {
        "nodeType": "activity-store",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
