          "files": [
            "src/main/terminal/tipc/terminalRouter.ts"
          ]
        },
        "event": {
          "name": "terminal.activity.agent_stopped",
          "description": "Agent stopped working - session removed from store",
          "attributes": {
            "session.id": {
              "type": "string",
              "description": "Terminal session ID"
            },
            "store.size": {
              "type": "number",
              "description": "Remaining active sessions"
            }
          }
        }
      }
    },
    {
      "id": "broadcast",
      "type": "text",
      "x": 194,
      "y": 585,
      "width": 200,
      "height": 100,
      "text": "Broadcast\n\nBrowserWindow\n.getAllWindows()\n.forEach(send)",
      "pv": {
