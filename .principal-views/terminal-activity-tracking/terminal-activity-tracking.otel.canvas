{
  "pv": {
    "name": "Terminal Activity Tracking",
    "version": "1.0.0",
    "description": "Flow of terminal/agent working state from terminal panel through TIPC to main process store and cross-window broadcast",
    "markdown": ".principal-views/terminal-activity-tracking/terminal-activity-tracking.md",
    "nodeTypes": {
      "terminal-panel": {
        "label": "Terminal Panel",
        "color": "#10B981"
      },
      "panel-host": {
        "label": "Panel Host",
        "color": "#3B82F6"
      },
      "tipc-client": {
        "label": "TIPC Client",
        "color": "#8B5CF6"
      },
      "tipc-router": {
        "label": "TIPC Router",
        "color": "#6366F1"
      },
      "activity-store": {
        "label": "Activity Store",
        "color": "#F59E0B"
      },
      "broadcast": {
        "label": "Broadcast",
        "color": "#EC4899"
      },
      "window": {
        "label": "Window",
        "color": "#14B8A6"
      }
    },
    "edgeTypes": {
      "event-emit": {
        "label": "Event Emit",
        "style": "solid",
        "color": "#10B981"
      },
      "tipc-invoke": {
        "label": "TIPC Invoke",
        "style": "solid",
        "color": "#6366F1"
      },
      "state-update": {
        "label": "State Update",
        "style": "solid",
        "color": "#F59E0B"
      },
      "ipc-broadcast": {
        "label": "IPC Broadcast",
        "style": "dashed",
        "color": "#EC4899"
      }
    }
  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 300,
      "y": -80,
      "width": 500,
      "height": 50,
      "color": "#64748B",
      "text": "# Terminal Activity Tracking\n**Agent working state propagation across windows**"
    },
    {
      "id": "external-origin",
      "type": "text",
      "x": 50,
      "y": 0,
      "width": 450,
      "height": 100,
      "text": "**External Origin**\n\n@industry-theme/xterm-terminal-panel\nThemedTerminal → events.emit('terminal:activity-change')",
      "color": "#64748B"
    },
    {
      "id": "panel-host",
      "type": "text",
      "x": 550,
      "y": 0,
      "width": 200,
      "height": 100,
      "text": "Panel Host\n\nReceives event via\nevents.on() listener",
      "pv": {
        "nodeType": "panel-host",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/renderer/dev-workspace/DevWorkspacePanelFramework.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "files": [
            "src/renderer/dev-workspace/DevWorkspacePanelFramework.tsx"
          ]
        },
        "event": {
          "name": "terminal.activity.host_received",
          "description": "Panel host received activity change event from terminal panel",
          "attributes": {
            "event.type": {
              "type": "string",
              "description": "Received event type",
              "display": false
            },
            "session.id": {
              "type": "string",
              "description": "Terminal session ID"
            },
            "is_working": {
              "type": "boolean",
              "description": "Working state from event"
            },
            "handler.name": {
              "type": "string",
              "description": "Handler function name"
            }
          }
        }
      }
    },
    {
      "id": "tipc-client",
      "type": "text",
      "x": 550,
      "y": 150,
      "width": 200,
      "height": 100,
      "text": "terminalClient\n.updateActivity()\n\nTIPC invoke to main",
      "pv": {
        "nodeType": "tipc-client",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/renderer/dev-workspace/DevWorkspacePanelFramework.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ipc",
          "files": [
            "src/renderer/dev-workspace/DevWorkspacePanelFramework.tsx"
          ]
        },
        "event": {
          "name": "terminal.activity.tipc_invoked",
          "description": "TIPC client invoked updateActivity procedure",
          "attributes": {
            "procedure.name": {
              "type": "string",
              "description": "TIPC procedure: updateActivity"
            },
            "session.id": {
              "type": "string",
              "description": "Terminal session ID",
              "display": false
            },
            "is_working": {
              "type": "boolean",
              "description": "Working state being sent"
            },
            "working_message": {
              "type": "string",
              "description": "Working message if provided",
              "display": false
            }
          }
        }
      }
    },
    {
      "id": "tipc-router",
      "type": "text",
      "x": 197,
      "y": 255,
      "width": 200,
      "height": 120,
      "text": "terminalRouter\n.updateActivity\n\nt.procedure\n.input<UpdateActivityInput>()\n.action()",
      "pv": {
        "nodeType": "tipc-router",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
          "src/main/terminal/tipc/terminalRouter.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "ipc",
          "files": [
            "src/main/terminal/tipc/terminalRouter.ts"
          ]
        },
        "event": {
          "name": "terminal.activity.router_handled",
          "description": "TIPC router handled updateActivity procedure in main process",
          "attributes": {
            "procedure.name": {
              "type": "string",
              "description": "TIPC procedure: updateActivity",
              "display": false
            },
            "window.id": {
              "type": "number",
              "description": "Source window ID from context.sender"
            },
            "session.id": {
              "type": "string",
              "description": "Terminal session ID"
            },
            "is_working": {
              "type": "boolean",
              "description": "Working state from input",
              "display": false
            }
          }
        }
      }
    },
    {
      "id": "agent-started",
      "type": "text",
      "x": 101,
      "y": 431,
      "width": 180,
      "height": 100,
      "text": "Agent Started\n\nactivityStore.set()\nSession added",
      "pv": {
        "nodeType": "activity-store",
        "shape": "rectangle",
        "status": "implemented",
        "references": [
