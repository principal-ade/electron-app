{
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 300,
      "y": -80,
      "width": 500,
      "height": 50,
      "color": "#64748B",
      "text": "# Terminal Activity Tracking\n**Agent working state propagation across windows**"
    },
    {
      "id": "external-origin",
      "type": "text",
      "x": 50,
      "y": 0,
      "width": 450,
      "height": 100,
      "text": "**External Origin**\n\n@industry-theme/xterm-terminal-panel\nThemedTerminal → events.emit('terminal:activity-change')",
      "color": "#64748B"
    },
    {
      "id": "panel-host",
      "type": "otel-event",
      "x": 550,
      "y": 0,
      "width": 200,
      "height": 100,
      "label": "Panel Host",
      "shape": "rectangle",
      "event": {
        "name": "terminal.activity.host_received",
        "description": "Panel host received activity change event from terminal panel",
        "attributes": {
          "event.type": {
            "type": "string",
            "description": "Received event type",
            "display": false
          },
          "session.id": {
            "type": "string",
            "description": "Terminal session ID"
          },
          "is_working": {
            "type": "boolean",
            "description": "Working state from event"
          },
          "handler.name": {
            "type": "string",
            "description": "Handler function name"
          }
        }
      },
      "otel": {
        "status": "implemented",
        "scope": "principal-ade-dev-workspace",
        "files": [
          "src/renderer/dev-workspace/DevWorkspacePanelFramework.tsx"
        ]
      }
    },
    {
      "id": "tipc-client",
      "type": "otel-event",
      "x": 550,
      "y": 150,
      "width": 200,
      "height": 100,
      "label": "terminalClient",
      "shape": "rectangle",
      "event": {
        "name": "terminal.activity.tipc_invoked",
        "description": "TIPC client invoked updateActivity procedure",
        "attributes": {
          "procedure.name": {
            "type": "string",
            "description": "TIPC procedure: updateActivity"
          },
          "session.id": {
            "type": "string",
            "description": "Terminal session ID",
            "display": false
          },
          "is_working": {
            "type": "boolean",
            "description": "Working state being sent"
          },
          "working_message": {
            "type": "string",
            "description": "Working message if provided",
            "display": false
          }
        }
      },
      "otel": {
        "status": "implemented",
        "scope": "principal-ade-dev-workspace",
        "files": [
          "src/renderer/dev-workspace/DevWorkspacePanelFramework.tsx"
        ]
      }
    },
    {
      "id": "tipc-router",
      "type": "otel-event",
      "x": 197,
      "y": 255,
      "width": 200,
      "height": 120,
      "label": "terminalRouter",
      "shape": "rectangle",
      "event": {
        "name": "terminal.activity.router_handled",
        "description": "TIPC router handled updateActivity procedure in main process",
        "attributes": {
          "procedure.name": {
            "type": "string",
            "description": "TIPC procedure: updateActivity",
            "display": false
          },
          "window.id": {
            "type": "number",
            "description": "Source window ID from context.sender"
          },
          "session.id": {
            "type": "string",
            "description": "Terminal session ID"
          },
          "is_working": {
            "type": "boolean",
            "description": "Working state from input",
            "display": false
          }
        }
      },
      "otel": {
        "status": "implemented",
        "scope": "principal-ade-main",
        "files": [
          "src/main/terminal/tipc/terminalRouter.ts"
        ]
      }
    },
    {
      "id": "agent-started",
