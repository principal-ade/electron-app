          "name": "terminal.activity.broadcast_sent",
          "description": "Activity state broadcast to all windows",
          "attributes": {
            "channel": {
              "type": "string",
              "description": "IPC channel: terminal:activity-sync"
            },
            "windows.count": {
              "type": "number",
              "description": "Number of windows receiving broadcast"
            },
            "activities.count": {
              "type": "number",
              "description": "Number of active sessions in payload"
            }
          }
        }
      }
