    {
      "id": "state-note",
      "type": "text",
      "x": 800,
      "y": 0,
      "width": 250,
      "height": 180,
      "text": "STATE PAYLOAD\n\nTerminalActivityState[] {\n  sessionId: string\n  isWorking: boolean\n  workingMessage?: string\n  workingSubtitle?: string\n  windowId: number\n  timestamp: number\n}",
      "color": "#F59E0B"
    },
    {
      "id": "scenarios-note",
      "type": "text",
      "x": 800,
      "y": 210,
      "width": 250,
      "height": 220,
      "text": "SCENARIOS\n\n1. Agent Starts Working\n   blinds down -> store set\n\n2. Agent Stops Working\n   blinds up -> store delete\n\n3. Window Requests State\n   getActivityState() on load\n\n4. Session Destroyed\n   cleanup from store",
      "color": "#3B82F6"
    },
    {
      "id": "use-cases-note",
      "type": "text",
      "x": 800,
      "y": 460,
      "width": 250,
      "height": 160,
      "text": "USE CASES\n\n- Badge in window title\n- Activity overview panel\n- Prevent close warning\n- Taskbar progress\n- Multi-window awareness",
      "color": "#10B981"
    }
