{
  "pv": {
    "name": "Window Switcher Cards",
    "version": "1.0.0",
    "description": "Integration of LocalProjectCard from industry-themed-repository-composition-panels into the Window Switcher overlay",
    "markdown": ".principal-views/window-switcher-cards/window-switcher-cards.md",
    "nodeTypes": {
      "renderer": {
        "label": "Renderer",
        "color": "#10B981"
      },
      "main-process": {
        "label": "Main Process",
        "color": "#6366F1"
      },
      "window-manager": {
        "label": "Window Manager",
        "color": "#F59E0B"
      },
      "store": {
        "label": "Store",
        "color": "#3B82F6"
      },
      "component": {
        "label": "Component",
        "color": "#EC4899"
      }
    },
    "edgeTypes": {
      "ipc": {
        "label": "IPC",
        "style": "solid",
        "color": "#6366F1"
      },
      "method-call": {
        "label": "Method Call",
        "style": "solid",
        "color": "#F59E0B"
      },
      "data-flow": {
        "label": "Data Flow",
        "style": "dashed",
        "color": "#3B82F6"
      },
      "import": {
        "label": "Import",
        "style": "dotted",
        "color": "#8B5CF6"
      }
    }
  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 200,
      "y": -120,
      "width": 600,
      "height": 60,
      "color": "#64748B",
      "text": "# Window Switcher Cards Integration\n**Using LocalProjectCard from industry-themed-repository-composition-panels**"
    },
    {
      "id": "quick-open-trigger",
      "type": "text",
      "x": -300,
      "y": 50,
      "width": 200,
      "height": 100,
      "text": "Quick Open\n\nopenDevWorkspaceWindow()\nwith alexandriaEntry",
      "pv": {
        "nodeType": "main-process",
        "shape": "rectangle",
        "status": "approved",
        "references": [
          "src/main/window/quickOpen.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "navigation",
          "files": [
            "src/main/window/quickOpen.ts"
          ]
        },
        "event": {
          "name": "window.open.quick_open_triggered",
          "description": "User selected a project from Quick Open",
          "attributes": {
            "entry.name": {
              "type": "string",
              "description": "Project name"
            },
            "entry.remoteUrl": {
              "type": "string",
              "description": "GitHub remote URL"
            }
          }
        }
      }
    },
    {
      "id": "dev-workspace-handler",
      "type": "text",
      "x": 0,
      "y": 50,
      "width": 220,
      "height": 100,
      "text": "devWorkspaceWindowHandlers\n\nopenDevWorkspaceWindow()\nStores alexandriaEntry\nin window metadata",
      "pv": {
        "nodeType": "window-manager",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/main/window/devWorkspaceWindowHandlers.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "files": [
            "src/main/window/devWorkspaceWindowHandlers.ts"
          ]
        },
        "event": {
          "name": "window.open.dev_workspace_created",
          "description": "Dev workspace window created with AlexandriaEntry stored",
          "attributes": {
            "window.id": {
              "type": "number",
              "description": "Browser window ID"
            },
            "entry.name": {
              "type": "string",
              "description": "Project name"
            },
            "entry.has_github": {
              "type": "boolean",
              "description": "Whether entry has GitHub metadata"
            }
          }
        }
      }
    },
    {
      "id": "window-metadata",
      "type": "text",
      "x": 280,
      "y": 50,
      "width": 200,
      "height": 120,
      "text": "WindowMetadata\n\nprimaryType: PrimaryWindowType\ndisplayName: string\nremoteUrl?: string\nlocalPath?: string\nalexandriaEntry?: AlexandriaEntry",
      "pv": {
        "nodeType": "store",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/main/window/types.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "storage",
          "files": [
            "src/main/window/types.ts"
          ]
        },
        "event": {
          "name": "window.metadata.updated",
          "description": "Window metadata updated with AlexandriaEntry",
          "attributes": {
            "window.id": {
              "type": "number",
              "description": "Browser window ID"
            },
            "has_entry": {
              "type": "boolean",
              "description": "Whether AlexandriaEntry is present"
            }
          }
        }
      }
    },
    {
      "id": "application-windows",
      "type": "text",
      "x": 280,
      "y": 200,
      "width": 200,
      "height": 100,
      "text": "applicationWindows\n\nMap<number, IModernApplicationWindow>\n\nStores all open windows\nwith their metadata",
      "pv": {
        "nodeType": "store",
        "shape": "rectangle",
        "status": "approved",
        "references": [
          "src/main/window/types.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "storage",
          "files": [
            "src/main/window/types.ts"
          ]
        },
        "event": {
          "name": "window.store.accessed",
          "description": "Application windows store accessed",
          "attributes": {
            "operation": {
              "type": "string",
              "description": "get, set, delete, iterate"
            },
            "store.size": {
              "type": "number",
              "description": "Current number of windows"
            }
          }
        }
      }
    },
    {
      "id": "window-switcher-main",
      "type": "text",
      "x": 0,
      "y": 350,
      "width": 220,
      "height": 120,
      "text": "WindowSwitcher (Main)\n\nupdateWindowList()\nsendWindowList()\n\nIterates applicationWindows\nExtracts alexandriaEntry",
      "pv": {
        "nodeType": "main-process",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/main/window/windowSwitcher.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "ui",
          "files": [
            "src/main/window/windowSwitcher.ts"
          ]
        },
        "event": {
          "name": "window_switcher.list.updated",
          "description": "Window switcher updated its window list with AlexandriaEntry data",
          "attributes": {
            "windows.count": {
              "type": "number",
              "description": "Number of windows in list"
            },
            "windows.with_entry": {
              "type": "number",
              "description": "Number of windows with AlexandriaEntry"
            }
          }
        }
      }
    },
    {
      "id": "switcher-window-type",
      "type": "text",
      "x": 280,
      "y": 350,
      "width": 200,
      "height": 120,
      "text": "SwitcherWindow Type\n\nid: number\ntitle: string\nalexandriaEntry?: AlexandriaEntry\nprimaryType: PrimaryWindowType",
      "pv": {
        "nodeType": "store",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/main/window/windowSwitcher.ts",
          "src/renderer/window-switcher/WindowSwitcherApp.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "storage",
          "files": [
            "src/main/window/windowSwitcher.ts"
          ]
        },
        "event": {
          "name": "window_switcher.window.serialized",
          "description": "Window data serialized for IPC transfer",
          "attributes": {
            "window.id": {
              "type": "number",
              "description": "Window ID"
            },
            "has_entry": {
              "type": "boolean",
              "description": "Whether AlexandriaEntry is included"
            }
          }
        }
      }
    },
    {
      "id": "window-switcher-renderer",
      "type": "text",
      "x": 0,
      "y": 520,
      "width": 220,
      "height": 100,
      "text": "WindowSwitcherApp\n\nReceives window list\nwith AlexandriaEntry\nRenders LocalProjectCard",
      "pv": {
        "nodeType": "renderer",
        "shape": "rectangle",
        "status": "draft",
        "references": [
          "src/renderer/window-switcher/WindowSwitcherApp.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ui",
          "files": [
            "src/renderer/window-switcher/WindowSwitcherApp.tsx"
          ]
        },
        "event": {
          "name": "window_switcher.rendered",
          "description": "Window switcher UI rendered with project cards",
          "attributes": {
            "cards.count": {
              "type": "number",
              "description": "Number of cards rendered"
            },
            "selected.index": {
              "type": "number",
              "description": "Currently selected card index"
            }
          }
        }
      }
    },
    {
      "id": "local-project-card",
      "type": "text",
      "x": 280,
      "y": 520,
      "width": 200,
      "height": 100,
      "text": "LocalProjectCard\n\nFrom @industry-theme/\nrepository-composition-panels\n\nDisplays AlexandriaEntry",
      "color": "#8B5CF6"
    },
    {
      "id": "card-layout",
      "type": "text",
      "x": 540,
      "y": 520,
      "width": 200,
      "height": 100,
      "text": "CardLayout\n\nBeveled nameplate\nOwner avatar\nStar count\nLanguage/License badges",
      "color": "#8B5CF6"
    },
    {
      "id": "sprite-renderer",
      "type": "text",
      "x": 540,
      "y": 650,
      "width": 200,
      "height": 80,
      "text": "Sprite Renderer\n\nIsometric building sprite\nCached PNG rendering",
      "color": "#8B5CF6"
    },
    {
      "id": "window-selected",
      "type": "text",
      "x": 0,
      "y": 680,
      "width": 220,
      "height": 80,
      "text": "Window Selected\n\nUser clicks card or\npresses Enter",
      "pv": {
        "nodeType": "renderer",
        "shape": "rectangle",
        "status": "approved",
        "references": [
          "src/renderer/window-switcher/WindowSwitcherApp.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ui",
          "files": [
            "src/renderer/window-switcher/WindowSwitcherApp.tsx"
          ]
        },
        "event": {
          "name": "window_switcher.window_selected",
          "description": "User selected a window to switch to",
          "attributes": {
            "target.window_id": {
              "type": "number",
              "description": "Window ID being switched to"
            },
            "target.name": {
              "type": "string",
              "description": "Project name"
            },
            "selection.method": {
              "type": "string",
              "description": "click, enter, or cycle"
            }
          }
        }
      }
    },
    {
      "id": "notes-entry",
      "type": "text",
      "x": 550,
      "y": 50,
      "width": 250,
      "height": 180,
      "text": "ALEXANDRIAENTRY DATA\n\nname: string\npath?: string\nremoteUrl?: string\nviewCount?: number\nlastOpenedAt?: string\ngithub?: {\n  owner: string\n  stars: number\n  description: string\n  primaryLanguage: string\n  license: string\n}",
      "color": "#3B82F6"
    },
    {
      "id": "notes-package",
      "type": "text",
      "x": 550,
      "y": 260,
      "width": 250,
      "height": 140,
      "text": "PACKAGE DEPENDENCY\n\n@industry-theme/\nrepository-composition-panels\n\nPeer deps:\n- @principal-ade/industry-theme\n- @principal-ai/alexandria-core-library",
      "color": "#8B5CF6"
    },
    {
      "id": "trigger-shortcut",
      "type": "text",
      "x": -300,
      "y": 350,
      "width": 200,
      "height": 80,
      "text": "Keyboard Shortcut\n\nCommand+' (toggle)\nCommand+; (cycle)",
      "pv": {
        "nodeType": "main-process",
        "shape": "rectangle",
        "status": "approved",
        "references": [
          "src/main/main.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "input",
          "files": [
            "src/main/main.ts"
          ]
        },
        "event": {
          "name": "window_switcher.shortcut_triggered",
          "description": "User triggered window switcher via keyboard",
          "attributes": {
            "shortcut": {
              "type": "string",
              "description": "toggle or cycle"
            }
          }
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "fromNode": "quick-open-trigger",
      "toNode": "dev-workspace-handler",
      "fromSide": "right",
      "toSide": "left",
      "label": "alexandriaEntry",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "e2",
      "fromNode": "dev-workspace-handler",
      "toNode": "window-metadata",
      "fromSide": "right",
      "toSide": "left",
      "label": "store entry",
      "pv": {
        "edgeType": "method-call"
      }
    },
    {
      "id": "e3",
      "fromNode": "window-metadata",
      "toNode": "application-windows",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "stored in",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "e4",
      "fromNode": "application-windows",
      "toNode": "window-switcher-main",
      "fromSide": "left",
      "toSide": "right",
      "label": "iterate windows",
      "pv": {
        "edgeType": "method-call"
      }
    },
    {
      "id": "e5",
      "fromNode": "window-switcher-main",
      "toNode": "switcher-window-type",
      "fromSide": "right",
      "toSide": "left",
      "label": "build list",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "e6",
      "fromNode": "window-switcher-main",
      "toNode": "window-switcher-renderer",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "IPC: update-list",
      "pv": {
        "edgeType": "ipc"
      }
    },
    {
      "id": "e7",
      "fromNode": "window-switcher-renderer",
      "toNode": "local-project-card",
      "fromSide": "right",
      "toSide": "left",
      "label": "render",
      "pv": {
        "edgeType": "import"
      }
    },
    {
      "id": "e8",
      "fromNode": "local-project-card",
      "toNode": "card-layout",
      "fromSide": "right",
      "toSide": "left",
      "label": "uses",
      "pv": {
        "edgeType": "import"
      }
    },
    {
      "id": "e9",
      "fromNode": "local-project-card",
      "toNode": "sprite-renderer",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "renders sprite",
      "pv": {
        "edgeType": "method-call"
      }
    },
    {
      "id": "e10",
      "fromNode": "window-switcher-renderer",
      "toNode": "window-selected",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "user action",
      "pv": {
        "edgeType": "method-call"
      }
    },
    {
      "id": "e11",
      "fromNode": "window-selected",
      "toNode": "window-switcher-main",
      "fromSide": "left",
      "toSide": "bottom",
      "label": "IPC: select",
      "pv": {
        "edgeType": "ipc"
      }
    },
    {
      "id": "e12",
      "fromNode": "trigger-shortcut",
      "toNode": "window-switcher-main",
      "fromSide": "right",
      "toSide": "left",
      "label": "toggle/show",
      "pv": {
        "edgeType": "method-call"
      }
    }
  ]
}
