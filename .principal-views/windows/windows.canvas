{
  "pv": {
    "name": "Principal ADE - Window Architecture",
    "version": "1.0.0",
    "markdown": ".principal-views/windows/windows.md",
    "nodeTypes": {
      "primary-window": {
        "label": "Primary Window",
        "color": "#3B82F6"
      },
      "workspace-window": {
        "label": "Workspace Window",
        "color": "#8B5CF6"
      },
      "viewer-window": {
        "label": "Viewer Window",
        "color": "#22C55E"
      },
      "utility-window": {
        "label": "Utility Window",
        "color": "#F59E0B"
      },
      "external-window": {
        "label": "External Window",
        "color": "#EF4444"
      },
      "manager": {
        "label": "Window Manager",
        "color": "#64748B"
      }
    },
    "edgeTypes": {
      "creates": {
        "label": "Creates",
        "style": "solid",
        "color": "#3B82F6"
      },
      "ipc": {
        "label": "IPC",
        "style": "solid",
        "color": "#8B5CF6"
      },
      "manages": {
        "label": "Manages",
        "style": "dashed",
        "color": "#64748B"
      }
    }
  },
  "nodes": [
    {
      "id": "window-manager",
      "type": "text",
      "x": 400,
      "y": 0,
      "width": 220,
      "height": 70,
      "text": "Modern Window Manager",
      "pv": {
        "nodeType": "manager",
        "shape": "rectangle",
        "references": ["src/main/window/modernWindowManager.ts"]
      }
    },
    {
      "id": "main-window",
      "type": "text",
      "x": 0,
      "y": 150,
      "width": 200,
      "height": 80,
      "text": "Main Window\n(principal.html)",
      "pv": {
        "nodeType": "primary-window",
        "shape": "rectangle",
        "references": ["src/main/window/modernWindowManager.ts"]
      }
    },
    {
