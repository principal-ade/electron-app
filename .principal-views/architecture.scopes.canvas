      "width": 280,
      "height": 140,
      "color": "#A855F7",
      "text": "**Alexandria**\nKnowledge workspace\n\n*Span namespaces:*\n`alexandria.*` `quality.panel.*`",
      "pv": {
        "nodeType": "scope",
        "description": "Alexandria Workspace - knowledge base and code exploration",
        "otel": {
          "scope": "principal-ade-alexandria"
        }
      }
    },
    {
      "id": "principal-ade-event-processor",
      "type": "text",
      "x": -235,
      "y": 420,
      "width": 280,
      "height": 140,
      "color": "#F59E0B",
      "text": "**Event Processor**\nUtility process (Node.js)\n\n*Span namespaces:*\n`event.*` `agent.*`",
      "pv": {
        "nodeType": "scope",
        "description": "Event Processing Server - utility process for agent session events",
        "otel": {
          "scope": "principal-ade-event-processor"
        }
      }
    },
    {
      "id": "principal-ade-repo-monitor",
      "type": "text",
      "x": 100,
      "y": 437,
      "width": 200,
      "height": 100,
      "color": "#14B8A6",
      "text": "**Repo Monitor**\nUtility process (Node.js)",
      "pv": {
        "nodeType": "scope",
        "description": "Repository Monitoring Server - utility process for file watching and cache building",
        "otel": {
          "scope": "principal-ade-repo-monitor"
        }
      }
    },
    {
      "id": "principal-ade-terminal-worker",
      "type": "text",
      "x": 340,
      "y": 412,
      "width": 220,
      "height": 80,
      "color": "#6366F1",
      "text": "**Terminal Worker**\nUtility process (Node.js)\n\n*No telemetry yet*",
      "pv": {
        "nodeType": "scope",
        "description": "Terminal session router - bridges main process to PTY daemon or manages PTYs directly",
        "otel": {
          "scope": "principal-ade-terminal-worker"
        }
      }
    },
    {
      "id": "principal-ade-cli-bridge",
      "type": "text",
      "x": -467,
      "y": 420,
      "width": 200,
      "height": 80,
      "color": "#6366F1",
      "text": "**CLI Bridge**\nUtility process (Node.js)\n\n*No telemetry yet*",
      "pv": {
        "nodeType": "scope",
        "description": "CLI command executor - runs git, npm, and other CLI tools in isolated workers",
        "otel": {
          "scope": "principal-ade-cli-bridge"
        }
      }
    },
    {
      "id": "principal-ade-daemon",
      "type": "text",
      "x": 250,
      "y": 662,
      "width": 400,
      "height": 200,
      "color": "#0D9488",
      "text": "**PTY Daemon**\nStandalone Node.js process\n\n*Span namespaces:*\n`terminal.daemon.*`\n`terminal.pty.*`",
      "pv": {
        "nodeType": "scope",
        "description": "Standalone PTY daemon process managing persistent terminal sessions via Unix socket",
        "otel": {
          "scope": "principal-ade-daemon"
        }
      }
    },
