{
  "pv": {
    "name": "Instrumentation Scopes",
    "version": "2.0.0",
    "description": "OpenTelemetry instrumentation scopes representing process boundaries. Traces require context propagation to cross scope boundaries.",
    "markdown": ".principal-views/architecture.scopes.md"
  },
  "nodes": [
    {
      "id": "principal-ade",
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 400,
      "height": 280,
      "color": "#4F46E5",
      "text": "**Main Process**\nElectron main process (Node.js)\n\n*Span namespaces:*\n`window.*` `project.*` `fs.*`\n`app.update.*` `mcp.*`\n`terminal.session.*`\n`ipc.handle.*`",
      "pv": {
        "nodeType": "scope",
        "description": "Electron main process - Node.js runtime handling IPC, services, and system operations",
        "otel": {
          "scope": "principal-ade"
        }
      }
    },
    {
      "id": "principal-ade-renderer",
      "type": "text",
      "x": 500,
      "y": 0,
      "width": 400,
      "height": 280,
      "color": "#7C3AED",
      "text": "**Renderer Process**\nElectron renderer (Chromium/React)\n\n*Span namespaces:*\n`terminal.panel.*` `quality.panel.*`\n`trace.viewer.*` `devworkspace.*`\n`alexandria.*`\n`ipc.invoke.*`",
      "pv": {
        "nodeType": "scope",
        "description": "Electron renderer process - React/TypeScript UI running in Chromium",
        "otel": {
          "scope": "principal-ade-renderer"
        }
      }
    },
    {
      "id": "principal-ade-daemon",
      "type": "text",
      "x": 250,
      "y": 380,
      "width": 400,
      "height": 240,
      "color": "#0D9488",
      "text": "**PTY Daemon**\nStandalone Node.js process\n\n*Span namespaces:*\n`terminal.daemon.*`\n`terminal.pty.*`",
      "pv": {
        "nodeType": "scope",
        "description": "Standalone PTY daemon process managing persistent terminal sessions via Unix socket",
        "otel": {
          "scope": "principal-ade-daemon"
        }
      }
    },
    {
      "id": "principal-ade-storybook",
      "type": "text",
      "x": 1000,
      "y": 0,
      "width": 300,
      "height": 120,
      "color": "#EC4899",
      "text": "**Storybook**\nUI component dev environment\n\n*For development only*",
      "pv": {
        "nodeType": "scope",
        "description": "Storybook development environment for UI components",
        "otel": {
          "scope": "principal-ade-storybook"
        }
      }
    },
    {
      "id": "principal-ade-tests",
      "type": "text",
      "x": 1000,
      "y": 160,
      "width": 300,
      "height": 120,
      "color": "#F59E0B",
      "text": "**Test Runner**\nIntegration test suite\n\n*For testing only*",
      "pv": {
        "nodeType": "scope",
        "description": "Integration test suite runner",
        "otel": {
          "scope": "principal-ade-tests"
        }
      }
    },
    {
      "id": "external-github",
      "type": "text",
      "x": 1000,
      "y": 380,
      "width": 300,
      "height": 100,
      "color": "#64748B",
      "text": "**GitHub API**\nExternal service\n\n*W3C trace context headers*",
      "pv": {
        "nodeType": "scope",
        "description": "External GitHub API - trace context via W3C traceparent headers",
        "otel": {
          "scope": "external"
        }
      }
    },
    {
      "id": "external-agents",
      "type": "text",
      "x": 1000,
      "y": 500,
      "width": 300,
      "height": 100,
      "color": "#64748B",
      "text": "**Agent Connections**\nExternal HTTP clients\n\n*W3C trace context headers*",
      "pv": {
        "nodeType": "scope",
        "description": "External agent connections via event server",
        "otel": {
          "scope": "external"
        }
      }
    },
    {
      "id": "legend",
      "type": "text",
      "x": 0,
      "y": 380,
      "width": 200,
      "height": 240,
      "color": "#1E293B",
      "text": "**Context Propagation**\n\nTraces cross scope\nboundaries via:\n\n- IPC metadata\n- Socket messages\n- HTTP headers"
    }
  ],
  "edges": [
    {
      "id": "renderer-to-main",
      "fromNode": "principal-ade-renderer",
      "fromSide": "left",
      "toNode": "principal-ade",
      "toSide": "right",
      "label": "IPC (traceparent)",
      "pv": {
        "edgeType": "ipc"
      }
    },
    {
      "id": "main-to-daemon",
      "fromNode": "principal-ade",
      "fromSide": "bottom",
      "toNode": "principal-ade-daemon",
      "toSide": "top",
      "label": "Unix socket (traceparent)",
      "pv": {
        "edgeType": "worker-message"
      }
    },
    {
      "id": "main-to-github",
      "fromNode": "principal-ade",
      "fromSide": "right",
      "toNode": "external-github",
      "toSide": "left",
      "label": "HTTP (traceparent)",
      "pv": {
        "edgeType": "http"
      }
    },
    {
      "id": "main-to-agents",
      "fromNode": "principal-ade",
      "fromSide": "right",
      "toNode": "external-agents",
      "toSide": "left",
      "label": "HTTP (traceparent)",
      "pv": {
        "edgeType": "http"
      }
    }
  ]
}
