{
  "pv": {
    "name": "Instrumentation Scopes",
    "version": "2.0.0",
    "description": "OpenTelemetry instrumentation scopes representing process boundaries. Traces require context propagation to cross scope boundaries.",
    "markdown": ".principal-views/architecture.scopes.md"
  },
  "nodes": [
    {
      "id": "principal-ade-main",
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 400,
      "height": 280,
      "color": "#4F46E5",
      "text": "**Main Process**\nElectron main process (Node.js)\n\n*Span namespaces:*\n`window.*` `project.*` `fs.*`\n`app.update.*` `mcp.*`\n`terminal.session.*`\n`ipc.handle.*`",
      "pv": {
        "nodeType": "scope",
        "description": "Electron main process - Node.js runtime handling IPC, services, and system operations",
        "otel": {
          "scope": "principal-ade-main"
        }
      }
    },
    {
      "id": "principal-ade-principal-window",
      "type": "text",
      "x": 60,
      "y": -355,
      "width": 280,
      "height": 140,
      "color": "#7C3AED",
      "text": "**Principal Window**\nMain app shell\n\n*Span namespaces:*\n`ipc.invoke.*`",
      "pv": {
        "nodeType": "scope",
        "description": "Principal Window - main app shell with auth, workspaces, settings",
        "otel": {
          "scope": "principal-ade-principal-window"
        }
      }
    },
    {
      "id": "principal-ade-dev-workspace",
      "type": "text",
      "x": 391,
      "y": -356,
      "width": 280,
      "height": 140,
      "color": "#8B5CF6",
      "text": "**Dev Workspace**\nDevelopment environment\n\n*Span namespaces:*\n`devworkspace.*` `terminal.panel.*`",
      "pv": {
        "nodeType": "scope",
        "description": "Dev Workspace - development environment with panels and terminal",
        "otel": {
          "scope": "principal-ade-dev-workspace"
        }
      }
    },
    {
      "id": "principal-ade-alexandria",
      "type": "text",
      "x": -269,
