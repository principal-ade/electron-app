          "src/renderer/panels/ActivityFeedPanel.tsx"
        ]
      }
    },
    {
      "id": "repo-double-clicked",
      "type": "otel-event",
      "x": 550,
      "y": 680,
      "width": 200,
      "height": 100,
      "label": "Repo Double-Clicked",
      "shape": "rectangle",
      "event": {
        "name": "feed.repo.opened",
        "description": "User double-clicked repo image to open in workspace",
        "attributes": {
          "repo_path": {
            "type": "string",
