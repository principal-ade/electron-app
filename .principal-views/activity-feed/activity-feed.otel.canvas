{
  "pv": {
    "name": "Activity Feed",
    "version": "1.0.0",
    "description": "Cross-repository activity feed showing recent commits from all local repositories",
    "markdown": ".principal-views/activity-feed/activity-feed.md",
    "nodeTypes": {
      "ui-component": {
        "label": "UI Component",
        "color": "#EC4899"
      },
      "context": {
        "label": "React Context",
        "color": "#A855F7"
      },
      "renderer-service": {
        "label": "Renderer Service",
        "color": "#7C3AED"
      },
      "main-process": {
        "label": "Main Process",
        "color": "#4F46E5"
      },
      "hook": {
        "label": "React Hook",
        "color": "#F59E0B"
      },
      "event": {
        "label": "Event",
        "color": "#3B82F6"
      },
      "boundary": {
        "label": "Boundary",
        "color": "#64748B"
      }
    },
    "edgeTypes": {
      "user-action": {
        "label": "User Action",
        "style": "solid",
        "color": "#EC4899"
      },
      "data-flow": {
        "label": "Data Flow",
        "style": "solid",
        "color": "#3B82F6"
      },
      "ipc-invoke": {
        "label": "IPC Invoke",
        "style": "solid",
        "color": "#6366F1"
      },
      "state-update": {
        "label": "State Update",
        "style": "dashed",
        "color": "#22C55E"
      },
      "event-emit": {
        "label": "Event Emit",
        "style": "dashed",
        "color": "#A855F7"
      }
    }
  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 400,
      "y": -100,
      "width": 500,
      "height": 60,
      "color": "#64748B",
      "text": "# Activity Feed Feature\n**Cross-repository commit activity with File City images**"
    },
    {
      "id": "navigation-sidebar",
      "type": "otel-event",
      "x": 50,
      "y": 0,
      "width": 200,
      "height": 100,
      "label": "NavigationSidebar",
      "shape": "rectangle",
      "event": {
        "name": "feed.navigation.clicked",
        "description": "User clicked Feed item in navigation sidebar",
        "attributes": {
          "previous_view": {
            "type": "string",
            "description": "Previous active view before clicking Feed"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/principal-window/components/IntegratedShell/NavigationSidebar.tsx"
        ]
      }
    },
    {
      "id": "integrated-shell",
      "type": "otel-event",
      "x": 300,
      "y": 0,
      "width": 200,
      "height": 100,
      "label": "IntegratedShell",
      "shape": "rectangle",
      "event": {
        "name": "feed.view.activated",
        "description": "FeedView component mounted and active",
        "attributes": {
          "view_name": {
            "type": "string",
            "description": "View name: feed"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/principal-window/components/IntegratedShell/IntegratedShell.tsx"
        ]
      }
    },
    {
      "id": "feed-view",
      "type": "otel-event",
      "x": 550,
      "y": 0,
      "width": 200,
      "height": 100,
      "label": "FeedView",
      "shape": "rectangle",
      "event": {
        "name": "feed.provider.initialized",
        "description": "FeedPanelProvider initialized with context",
        "attributes": {
          "has_repositories": {
            "type": "boolean",
            "description": "Whether repositories were loaded"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/principal-window/views/FeedView/FeedView.tsx"
        ]
      }
    },
    {
      "id": "section-repo-events",
      "type": "text",
      "x": -400,
      "y": 130,
      "width": 350,
      "height": 40,
      "color": "#64748B",
      "text": "## Repository Events\n**Commit detection and feed refresh**"
    },
    {
      "id": "repo-monitoring-manager",
      "type": "otel-event",
      "x": -400,
      "y": 200,
      "width": 220,
      "height": 100,
      "label": "RepositoryMonitoringManager",
      "shape": "rectangle",
      "event": {
        "name": "repo.git_state.changed",
        "description": "Git state changed in a monitored repository (commit, branch change, etc)",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path where change occurred"
          },
          "event_type": {
            "type": "string",
            "description": "Type of git event: GIT_STATUS_CHANGED or GIT_STATE_EVENT"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/main/services/RepositoryMonitoringManager.ts"
        ]
      }
    },
    {
      "id": "ipc-broadcast",
      "type": "otel-event",
      "x": -400,
      "y": 350,
      "width": 220,
      "height": 100,
      "label": "broadcastToRelevantWindows",
      "shape": "rectangle",
      "event": {
        "name": "repo.event.broadcast",
        "description": "Git event broadcasted to relevant renderer windows via IPC",
        "attributes": {
          "window_count": {
            "type": "integer",
            "description": "Number of windows receiving the broadcast"
          },
          "event_channel": {
            "type": "string",
            "description": "IPC channel used for broadcast"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/main/services/RepositoryMonitoringManager.ts",
          "src/main/ipc/ipcHandlers.ts"
        ]
      }
    },
    {
      "id": "alexandria-on-repo-change",
      "type": "otel-event",
      "x": -400,
      "y": 500,
      "width": 220,
      "height": 100,
      "label": "AlexandriaService.onRepositoryChange",
      "shape": "rectangle",
      "event": {
        "name": "feed.repo_change.received",
        "description": "FeedView received repository change event via AlexandriaService listener",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository that changed"
          },
          "trigger_refresh": {
            "type": "boolean",
            "description": "Whether this triggers a feed refresh"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/main-process-api/AlexandriaService.ts",
          "src/renderer/principal-window/views/FeedView/FeedView.tsx"
        ]
      }
    },
    {
      "id": "feed-refresh-trigger",
      "type": "otel-event",
      "x": -150,
      "y": 500,
      "width": 180,
      "height": 100,
      "label": "Feed Refresh Triggered",
      "shape": "rectangle",
      "event": {
        "name": "feed.refresh.triggered",
        "description": "Activity feed refresh triggered by repository change event",
        "attributes": {
          "reason": {
            "type": "string",
            "description": "Reason for refresh: repo_change, manual, initial_load"
          },
          "debounce_ms": {
            "type": "integer",
            "description": "Debounce delay before refresh"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/principal-window/views/FeedView/FeedView.tsx",
          "src/renderer/hooks/useActivityFeed.ts"
        ]
      }
    },
    {
      "id": "section-data-loading",
      "type": "text",
      "x": 50,
      "y": 130,
      "width": 300,
      "height": 40,
      "color": "#64748B",
      "text": "## Data Loading\n**Repositories and commits**"
    },
    {
      "id": "alexandria-service",
      "type": "otel-event",
      "x": 50,
      "y": 200,
      "width": 200,
      "height": 100,
      "label": "AlexandriaService",
      "shape": "rectangle",
      "event": {
        "name": "feed.repositories.fetched",
        "description": "Fetched local repositories from Alexandria",
        "attributes": {
          "repository_count": {
            "type": "integer",
            "description": "Number of repositories returned"
          },
          "duration_ms": {
            "type": "integer",
            "description": "Time taken to fetch repositories"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/main-process-api/AlexandriaService.ts",
          "src/renderer/principal-window/views/FeedView/FeedView.tsx"
        ]
      }
    },
    {
      "id": "use-activity-feed",
      "type": "otel-event",
      "x": 300,
      "y": 200,
      "width": 200,
      "height": 100,
      "label": "useActivityFeed",
      "shape": "rectangle",
      "event": {
        "name": "feed.activity.loading_started",
        "description": "Started loading activity feed commits",
        "attributes": {
          "max_repos": {
            "type": "integer",
            "description": "Maximum repos to fetch from (default: 10)"
          },
          "commits_per_repo": {
            "type": "integer",
            "description": "Commits per repo to fetch (default: 5)"
          },
          "total_limit": {
            "type": "integer",
            "description": "Maximum total commits (default: 20)"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/hooks/useActivityFeed.ts"
        ]
      }
    },
    {
      "id": "get-directory-info",
      "type": "otel-event",
      "x": 550,
      "y": 200,
      "width": 200,
      "height": 100,
      "label": "FileSystemService",
      "shape": "rectangle",
      "event": {
        "name": "feed.repos.mtime_fetched",
        "description": "Fetched modification time for repositories to sort by recent activity",
        "attributes": {
          "repos_checked": {
            "type": "integer",
            "description": "Number of repos checked for mtime"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/main-process-api/FileSystemService.ts",
          "src/renderer/hooks/useActivityFeed.ts"
        ]
      }
    },
    {
      "id": "git-service-commits",
      "type": "otel-event",
      "x": 800,
      "y": 200,
      "width": 220,
      "height": 100,
      "label": "GitService.getCommitsInDateRange",
      "shape": "rectangle",
      "event": {
        "name": "feed.commits.fetched",
        "description": "Fetched commits for a repository in date range",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path"
          },
          "commit_count": {
            "type": "integer",
            "description": "Number of commits found"
          },
          "start_date": {
            "type": "string",
            "description": "Start date of range"
          },
          "end_date": {
            "type": "string",
            "description": "End date of range"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/main-process-api/GitService.ts",
          "src/renderer/hooks/useActivityFeed.ts"
        ]
      }
    },
    {
      "id": "activity-feed-loaded",
      "type": "otel-event",
      "x": 300,
      "y": 350,
      "width": 200,
      "height": 100,
      "label": "Activity Feed Loaded",
      "shape": "rectangle",
      "event": {
        "name": "feed.activity.loaded",
        "description": "Activity feed fully loaded with commits",
        "attributes": {
          "total_commits": {
            "type": "integer",
            "description": "Total commits in feed"
          },
          "unique_repos": {
            "type": "integer",
            "description": "Number of unique repositories"
          },
          "duration_ms": {
            "type": "integer",
            "description": "Total time to load feed"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/hooks/useActivityFeed.ts"
        ]
      }
    },
    {
      "id": "section-images",
      "type": "text",
      "x": 550,
      "y": 320,
      "width": 300,
      "height": 40,
      "color": "#64748B",
      "text": "## File City Images\n**Visual repo representations**"
    },
    {
      "id": "file-city-service",
      "type": "otel-event",
      "x": 550,
      "y": 380,
      "width": 220,
      "height": 100,
      "label": "FileCityImageService",
      "shape": "rectangle",
      "event": {
        "name": "feed.images.requested",
        "description": "Requested File City images for repos in activity feed",
        "attributes": {
          "repo_count": {
            "type": "integer",
            "description": "Number of unique repos to fetch images for"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/panels/ActivityFeedPanel.tsx",
          "src/renderer/main-process-api/FileCityImageService.ts"
        ]
      }
    },
    {
      "id": "images-loaded",
      "type": "otel-event",
      "x": 800,
      "y": 380,
      "width": 200,
      "height": 100,
      "label": "Images Loaded",
      "shape": "rectangle",
      "event": {
        "name": "feed.images.loaded",
        "description": "File City images loaded for repo grid",
        "attributes": {
          "images_found": {
            "type": "integer",
            "description": "Number of images successfully loaded"
          },
          "images_missing": {
            "type": "integer",
            "description": "Repos without File City images"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/panels/ActivityFeedPanel.tsx"
        ]
      }
    },
    {
      "id": "section-panel",
      "type": "text",
      "x": 50,
      "y": 480,
      "width": 300,
      "height": 40,
      "color": "#64748B",
      "text": "## Activity Feed Panel\n**UI rendering and interactions**"
    },
    {
      "id": "activity-feed-panel",
      "type": "otel-event",
      "x": 50,
      "y": 540,
      "width": 200,
      "height": 100,
      "label": "ActivityFeedPanel",
      "shape": "rectangle",
      "event": {
        "name": "feed.panel.rendered",
        "description": "Activity feed panel rendered with commits and images",
        "attributes": {
          "commits_displayed": {
            "type": "integer",
            "description": "Number of commits shown"
          },
          "repos_in_grid": {
            "type": "integer",
            "description": "Number of repos in image grid"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/panels/ActivityFeedPanel.tsx"
        ]
      }
    },
    {
      "id": "commit-hovered",
      "type": "otel-event",
      "x": 300,
      "y": 540,
      "width": 200,
      "height": 100,
      "label": "Commit Hovered",
      "shape": "rectangle",
      "event": {
        "name": "feed.commit.hovered",
        "description": "User hovered over a commit item",
        "attributes": {
          "repo_name": {
            "type": "string",
            "description": "Repository name"
          },
          "commit_hash": {
            "type": "string",
            "description": "Git commit hash"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/panels/ActivityFeedPanel.tsx"
        ]
      }
    },
    {
      "id": "repo-selected",
      "type": "otel-event",
      "x": 550,
      "y": 540,
      "width": 200,
      "height": 100,
      "label": "Repo Selected",
      "shape": "rectangle",
      "event": {
        "name": "feed.repo.selected",
        "description": "User clicked to filter by repository",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Selected repository path"
          },
          "repo_name": {
            "type": "string",
            "description": "Selected repository name"
          }
        }
      },
      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/panels/ActivityFeedPanel.tsx"
        ]
      }
    },
    {
      "id": "commit-clicked",
      "type": "otel-event",
      "x": 300,
      "y": 680,
      "width": 200,
      "height": 100,
      "label": "Commit Clicked",
      "shape": "rectangle",
      "event": {
        "name": "feed.commit.clicked",
        "description": "User clicked on a commit to navigate to repository",
        "attributes": {
          "repo_path": {
            "type": "string",
            "description": "Repository path to navigate to"
          },
          "commit_hash": {
            "type": "string",
            "description": "Commit hash clicked"
          }
        }
