  ],
  "edges": [
    {
      "id": "monitoring-to-broadcast",
      "fromNode": "repo-monitoring-manager",
      "fromSide": "bottom",
      "toNode": "ipc-broadcast",
      "toSide": "top",
      "label": "emit GIT_STATE_EVENT",
      "pv": {
        "edgeType": "event-emit"
      }
    },
    {
      "id": "broadcast-to-renderer",
      "fromNode": "ipc-broadcast",
      "fromSide": "bottom",
      "toNode": "alexandria-on-repo-change",
      "toSide": "top",
      "label": "IPC to renderer",
      "pv": {
        "edgeType": "ipc-invoke"
      }
    },
    {
      "id": "repo-change-to-refresh",
      "fromNode": "alexandria-on-repo-change",
      "fromSide": "right",
      "toNode": "feed-refresh-trigger",
      "toSide": "left",
      "label": "trigger refresh",
      "pv": {
        "edgeType": "event-emit"
      }
    },
    {
      "id": "refresh-to-hook",
      "fromNode": "feed-refresh-trigger",
      "fromSide": "right",
      "toNode": "use-activity-feed",
      "toSide": "left",
      "label": "reload commits",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "nav-to-shell",
      "fromNode": "navigation-sidebar",
      "fromSide": "right",
      "toNode": "integrated-shell",
      "toSide": "left",
      "label": "view change",
      "pv": {
        "edgeType": "user-action"
      }
    },
    {
      "id": "shell-to-view",
      "fromNode": "integrated-shell",
      "fromSide": "right",
      "toNode": "feed-view",
      "toSide": "left",
      "label": "render",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "view-to-alexandria",
      "fromNode": "feed-view",
      "fromSide": "bottom",
      "toNode": "alexandria-service",
      "toSide": "top",
      "label": "getRepositories()",
      "pv": {
        "edgeType": "ipc-invoke"
      }
    },
    {
      "id": "alexandria-to-hook",
      "fromNode": "alexandria-service",
      "fromSide": "right",
      "toNode": "use-activity-feed",
      "toSide": "left",
      "label": "repositories",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "hook-to-fs",
      "fromNode": "use-activity-feed",
      "fromSide": "right",
      "toNode": "get-directory-info",
      "toSide": "left",
      "label": "get mtime",
      "pv": {
        "edgeType": "ipc-invoke"
      }
    },
    {
      "id": "fs-to-git",
      "fromNode": "get-directory-info",
      "fromSide": "right",
      "toNode": "git-service-commits",
      "toSide": "left",
      "label": "top repos",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "git-to-loaded",
      "fromNode": "git-service-commits",
      "fromSide": "bottom",
      "toNode": "activity-feed-loaded",
      "toSide": "right",
      "label": "commits",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "hook-to-loaded",
      "fromNode": "use-activity-feed",
      "fromSide": "bottom",
      "toNode": "activity-feed-loaded",
      "toSide": "top",
      "label": "aggregate",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "loaded-to-images",
      "fromNode": "activity-feed-loaded",
      "fromSide": "right",
      "toNode": "file-city-service",
      "toSide": "left",
      "label": "unique repos",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "images-service-to-loaded",
      "fromNode": "file-city-service",
      "fromSide": "right",
      "toNode": "images-loaded",
      "toSide": "left",
      "label": "fetch images",
      "pv": {
        "edgeType": "ipc-invoke"
      }
    },
    {
      "id": "loaded-to-panel",
      "fromNode": "activity-feed-loaded",
      "fromSide": "bottom",
      "toNode": "activity-feed-panel",
      "toSide": "top",
      "label": "state update",
      "pv": {
        "edgeType": "state-update"
      }
    },
    {
      "id": "images-to-panel",
      "fromNode": "images-loaded",
      "fromSide": "bottom",
      "toNode": "activity-feed-panel",
      "toSide": "right",
      "label": "image URLs",
      "pv": {
        "edgeType": "state-update"
      }
    },
    {
      "id": "panel-to-hovered",
      "fromNode": "activity-feed-panel",
      "fromSide": "right",
      "toNode": "commit-hovered",
      "toSide": "left",
