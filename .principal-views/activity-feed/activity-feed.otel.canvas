    {
      "id": "window-service",
      "type": "otel-event",
      "x": 800,
      "y": 680,
      "width": 200,
      "height": 100,
      "label": "WindowService",
      "shape": "rectangle",
      "event": {
        "name": "feed.workspace.opened",
        "description": "Dev workspace opened for repository",
        "attributes": {
          "repo_path": {
            "type": "string",
