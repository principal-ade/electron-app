      "otel": {
        "status": "draft",
        "files": [
          "src/renderer/panels/ActivityFeedPanel.tsx"
        ],
        "scope": "principal-ade-principal-window"
      }
    },
    {
      "id": "section-panel",
      "type": "text",
      "x": 50,
      "y": 480,
      "width": 300,
      "height": 40,
      "color": "#64748B",
      "text": "## Activity Feed Panel\n**UI rendering and interactions**"
    },
    {
      "id": "activity-feed-panel",
      "type": "otel-event",
      "x": 50,
      "y": 540,
      "width": 200,
