  "edges": [
    {
      "id": "view-to-hook",
      "fromNode": "auth-view",
      "toNode": "use-auth-state",
      "label": "uses",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "hook-to-service",
      "fromNode": "use-auth-state",
      "toNode": "authentication-service",
      "label": "calls",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "service-to-api",
      "fromNode": "authentication-service",
      "toNode": "authentication-api",
      "label": "window.mainProcess",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "api-to-events",
      "fromNode": "authentication-api",
      "toNode": "auth-events",
      "label": "uses channels",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "api-to-auth-service",
      "fromNode": "authentication-api",
      "toNode": "auth-service",
      "label": "ipcRenderer.invoke(LOGIN)",
      "pv": {
        "edgeType": "ipc-invoke"
      }
    },
    {
      "id": "state-to-api",
      "fromNode": "auth-state-manager",
      "toNode": "authentication-api",
      "label": "auth-state:changed",
      "pv": {
        "edgeType": "ipc-event"
      }
    },
    {
      "id": "auth-service-to-state",
      "fromNode": "auth-service",
      "toNode": "auth-state-manager",
      "label": "setAuthenticated()",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "auth-service-to-oauth",
      "fromNode": "auth-service",
      "toNode": "oauth-client",
      "label": "authenticate()",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "auth-service-to-token-ipc",
      "fromNode": "auth-service",
      "toNode": "secure-token-ipc",
      "label": "store tokens",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "auth-service-to-jwt",
      "fromNode": "auth-service",
      "toNode": "jwt-service",
      "label": "createJWT()",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "oauth-to-workos",
      "fromNode": "oauth-client",
      "toNode": "workos-api",
      "label": "POST /start, /token, /refresh",
      "pv": {
        "edgeType": "http"
      }
    },
    {
      "id": "oauth-to-browser",
      "fromNode": "oauth-client",
      "toNode": "browser",
      "label": "shell.openExternal()",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "auth-service-to-github",
      "fromNode": "auth-service",
      "toNode": "github-api",
      "label": "GET /user",
      "pv": {
        "edgeType": "http"
      }
    },
    {
      "id": "token-ipc-to-storage",
      "fromNode": "secure-token-ipc",
      "toNode": "unified-storage",
      "label": "setToken/getToken",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "storage-to-keychain",
      "fromNode": "unified-storage",
      "toNode": "keychain",
      "label": "safeStorage.encrypt/decrypt",
      "pv": {
        "edgeType": "stores"
      }
    },
    {
      "id": "storage-to-file",
      "fromNode": "unified-storage",
      "toNode": "storage-file",
      "label": "write/read",
      "pv": {
        "edgeType": "stores"
      }
    },
    {
      "id": "jwt-to-github-token-auth",
      "fromNode": "jwt-service",
      "toNode": "github-token-auth",
      "label": "provides token",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "file-to-token-github",
      "fromNode": "storage-file",
      "toNode": "token-github",
      "label": "contains",
      "pv": {
        "edgeType": "stores"
      }
    },
    {
      "id": "file-to-token-workos",
      "fromNode": "storage-file",
      "toNode": "token-workos",
      "label": "contains",
      "pv": {
        "edgeType": "stores"
      }
    },
    {
      "id": "file-to-token-refresh",
      "fromNode": "storage-file",
      "toNode": "token-refresh",
      "label": "contains",
      "pv": {
        "edgeType": "stores"
      }
    }
  ]
}
