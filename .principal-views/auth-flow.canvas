        "color": "#EF4444"
      },
      "uses": {
        "label": "Uses",
        "style": "dotted",
        "color": "#64748B"
      },
      "stores": {
        "label": "Stores",
        "style": "solid",
        "color": "#10B981"
      },
      "broadcasts": {
        "label": "Broadcasts",
        "style": "dashed",
        "color": "#0EA5E9"
      }
    }
  },
