{
  "pv": {
    "name": "CollectionMapPanel: Repository Positioning & Region Management",
    "version": "1.0.0",
    "description": "Telemetry events for dragging repositories, creating regions, and layout management in CollectionMapPanel",
    "markdown": ".principal-views/collection-map-interactions/collection-map-interactions.md",
    "nodeTypes": {
      "ui-component": {
        "label": "UI Component",
        "color": "#EC4899"
      },
      "callback": {
        "label": "Callback Handler",
        "color": "#14B8A6"
      },
      "context": {
        "label": "React Context",
        "color": "#A855F7"
      },
      "service": {
        "label": "Service Layer",
        "color": "#4F46E5"
      },
      "github-api": {
        "label": "GitHub API",
        "color": "#22C55E"
      },
      "state": {
        "label": "State Management",
        "color": "#F59E0B"
      }
    },
    "edgeTypes": {
      "user-action": {
        "label": "User Action",
        "style": "solid",
        "color": "#EC4899"
      },
      "callback-invoke": {
        "label": "Callback Invoke",
        "style": "solid",
        "color": "#14B8A6"
      },
      "state-update": {
        "label": "State Update",
        "style": "solid",
        "color": "#F59E0B"
      },
      "api-call": {
        "label": "API Call",
        "style": "solid",
        "color": "#22C55E"
      },
      "event-emit": {
        "label": "Event Emit",
        "style": "dashed",
        "color": "#A855F7"
      },
      "data-flow": {
        "label": "Data Flow",
        "style": "solid",
        "color": "#3B82F6"
      }
    }
  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 600,
      "y": -100,
      "width": 700,
      "height": 60,
      "color": "#64748B",
      "text": "# CollectionMapPanel: Repository Positioning Flow\n**From drag & drop to GitHub persistence with optimistic updates**"
    },
    {
      "id": "user-drag-start",
      "type": "text",
      "x": 50,
      "y": 0,
      "width": 220,
      "height": 100,
      "text": "User Interaction\n(drag repository\ncard onto map)",
      "pv": {
        "nodeType": "ui-component",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/dev-workspace/DevWorkspacePanelFramework.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ui",
          "isNew": true
        },
        "event": {
          "name": "collection_map.ui.repository_drag_started",
          "description": "User started dragging a repository card on the collection map",
          "attributes": {
            "repository.id": {
              "type": "string",
              "description": "Repository ID being dragged"
            },
            "repository.name": {
              "type": "string",
              "description": "Repository name for debugging"
            },
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "drag.source_region": {
              "type": "string",
              "description": "Region ID where drag started (or 'unassigned')"
            }
          }
        }
      }
    },
    {
      "id": "user-drag-drop",
      "type": "text",
      "x": 50,
      "y": 140,
      "width": 220,
      "height": 100,
      "text": "Drop Event\n(repository dropped\non region or position)",
      "pv": {
        "nodeType": "ui-component",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/dev-workspace/DevWorkspacePanelFramework.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ui",
          "isNew": true
        },
        "event": {
          "name": "collection_map.ui.repository_dropped",
          "description": "User dropped repository on map or region",
          "attributes": {
            "repository.id": {
              "type": "string",
              "description": "Repository ID being dropped"
            },
            "drop.target_type": {
              "type": "string",
              "description": "Type of drop target: region | map"
            },
            "drop.target_region": {
              "type": "string",
              "description": "Region ID if dropped on region"
            },
            "drop.position.x": {
              "type": "number",
              "description": "X coordinate of drop position"
            },
            "drop.position.y": {
              "type": "number",
              "description": "Y coordinate of drop position"
            }
          }
        }
      }
    },
    {
      "id": "callback-repository-assigned",
      "type": "text",
      "x": 320,
      "y": 0,
      "width": 240,
      "height": 100,
      "text": "onRepositoryAssigned\n(assign repo to region)",
      "pv": {
        "nodeType": "callback",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/contexts/WorldsViewPanelContext.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "isNew": true
        },
        "event": {
          "name": "collection_map.callback.repository_assigned",
          "description": "Repository assigned to region callback invoked",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "repository.id": {
              "type": "string",
              "description": "Repository ID"
            },
            "region.id": {
              "type": "string",
              "description": "Target region ID"
            },
            "region.name": {
              "type": "string",
              "description": "Region name for debugging"
            },
            "callback.source": {
              "type": "string",
              "description": "Component that triggered callback: CollectionMapPanel"
            }
          }
        }
      }
    },
    {
      "id": "callback-position-updated",
      "type": "text",
      "x": 320,
      "y": 140,
      "width": 240,
      "height": 120,
      "text": "onRepositoryPositionUpdated\n(update x, y coordinates\nand size)",
      "pv": {
        "nodeType": "callback",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/contexts/WorldsViewPanelContext.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "isNew": true
        },
        "event": {
          "name": "collection_map.callback.position_updated",
          "description": "Repository position updated callback invoked",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "repository.id": {
              "type": "string",
              "description": "Repository ID"
            },
            "repository.name": {
              "type": "string",
              "description": "Repository name for debugging"
            },
            "position.x": {
              "type": "number",
              "description": "New X coordinate"
            },
            "position.y": {
              "type": "number",
              "description": "New Y coordinate"
            },
            "position.width": {
              "type": "number",
              "description": "Repository card width"
            },
            "position.height": {
              "type": "number",
              "description": "Repository card height"
            },
            "region.id": {
              "type": "string",
              "description": "Region ID if repository is assigned to region"
            }
          }
        }
      }
    },
    {
      "id": "optimistic-update",
      "type": "text",
      "x": 610,
      "y": 140,
      "width": 220,
      "height": 100,
      "text": "Optimistic Update\n(immediate UI feedback\nvia setCollectionMemberships)",
      "pv": {
        "nodeType": "state",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/contexts/WorldsViewPanelContext.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "state",
          "isNew": true
        },
        "event": {
          "name": "collection_map.state.optimistic_update_applied",
          "description": "Optimistic state update applied before GitHub sync",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "repository.id": {
              "type": "string",
              "description": "Repository ID"
            },
            "update.type": {
              "type": "string",
              "description": "Type of update: position | assignment | both"
            },
            "memberships.count": {
              "type": "number",
              "description": "Total membership count after update"
            },
            "optimistic.timestamp": {
              "type": "number",
              "description": "Unix timestamp of optimistic update"
            }
          }
        }
      }
    },
    {
      "id": "ui-rerender",
      "type": "text",
      "x": 50,
      "y": 280,
      "width": 220,
      "height": 100,
      "text": "UI Re-render\n(map updates instantly\nwith new position)",
      "pv": {
        "nodeType": "ui-component",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/dev-workspace/DevWorkspacePanelFramework.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ui",
          "isNew": true
        },
        "event": {
          "name": "collection_map.ui.rendered",
          "description": "CollectionMapPanel re-rendered with updated positions",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID being displayed"
            },
            "repositories.count": {
              "type": "number",
              "description": "Number of repositories on map"
            },
            "regions.count": {
              "type": "number",
              "description": "Number of regions on map"
            },
            "render.trigger": {
              "type": "string",
              "description": "What triggered render: optimistic_update | sync_complete"
            },
            "render.duration_ms": {
              "type": "number",
              "description": "Time taken to render component"
            }
          }
        }
      }
    },
    {
      "id": "github-sync-start",
      "type": "text",
      "x": 880,
      "y": 140,
      "width": 220,
      "height": 100,
      "text": "GitHub Sync Started\n(background sync\nto web-ade-collections)",
      "pv": {
        "nodeType": "service",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/contexts/WorldsViewPanelContext.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "github",
          "isNew": true
        },
        "event": {
          "name": "collection_map.github.sync_started",
          "description": "Background GitHub sync started for repository metadata update",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "repository.id": {
              "type": "string",
              "description": "Repository ID"
            },
            "sync.operation": {
              "type": "string",
              "description": "Operation: remove_and_readd"
            },
            "sync.timestamp": {
              "type": "number",
              "description": "Unix timestamp when sync started"
            }
          }
        }
      }
    },
    {
      "id": "collections-service-remove",
      "type": "text",
      "x": 1150,
      "y": 0,
      "width": 220,
      "height": 100,
      "text": "CollectionsService\n.removeRepository()\n(delete membership)",
      "pv": {
        "nodeType": "service",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/main/services/CollectionsService.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "github",
          "isNew": true
        },
        "event": {
          "name": "collection_map.service.repository_removed",
          "description": "Removing repository membership before re-adding with updated metadata",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "repository.id": {
              "type": "string",
              "description": "Repository ID"
            },
            "operation.reason": {
              "type": "string",
              "description": "Reason: metadata_update"
            }
          }
        }
      }
    },
    {
      "id": "collections-service-add",
      "type": "text",
      "x": 1150,
      "y": 140,
      "width": 220,
      "height": 120,
      "text": "CollectionsService\n.addRepository()\n(re-add with new\nmetadata.layout)",
      "pv": {
        "nodeType": "service",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/main/services/CollectionsService.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "github",
          "isNew": true
        },
        "event": {
          "name": "collection_map.service.repository_added",
          "description": "Re-adding repository with updated layout metadata",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "repository.id": {
              "type": "string",
              "description": "Repository ID"
            },
            "metadata.region_id": {
              "type": "string",
              "description": "Region assignment if any"
            },
            "metadata.layout.x": {
              "type": "number",
              "description": "X coordinate"
            },
            "metadata.layout.y": {
              "type": "number",
              "description": "Y coordinate"
            },
            "metadata.layout.width": {
              "type": "number",
              "description": "Card width"
            },
            "metadata.layout.height": {
              "type": "number",
              "description": "Card height"
            }
          }
        }
      }
    },
    {
      "id": "github-api-update",
      "type": "text",
      "x": 1420,
      "y": 140,
      "width": 220,
      "height": 100,
      "text": "GitHub API\nPUT /contents/\ncollection-memberships.json",
      "pv": {
        "nodeType": "github-api",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/main/services/CollectionsService.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "http",
          "isNew": true
        },
        "event": {
          "name": "collection_map.github.file_updated",
          "description": "Updated collection-memberships.json with new position data",
          "attributes": {
            "http.method": {
              "type": "string",
              "description": "HTTP method: PUT"
            },
            "http.url": {
              "type": "string",
              "description": "API endpoint"
            },
            "http.status_code": {
              "type": "number",
              "description": "HTTP response status code"
            },
            "github.file.name": {
              "type": "string",
              "description": "File name: collection-memberships.json"
            },
            "github.file.sha": {
              "type": "string",
              "description": "File SHA before update"
            },
            "github.file.size_bytes": {
              "type": "number",
              "description": "Updated file size in bytes"
            }
          }
        }
      }
    },
    {
      "id": "sync-success",
      "type": "text",
      "x": 880,
      "y": 280,
      "width": 220,
      "height": 100,
      "text": "Sync Complete\n(position persisted\nto GitHub)",
      "pv": {
        "nodeType": "service",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/contexts/WorldsViewPanelContext.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "github",
          "isNew": true
        },
        "event": {
          "name": "collection_map.github.sync_completed",
          "description": "GitHub sync completed successfully",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "repository.id": {
              "type": "string",
              "description": "Repository ID"
            },
            "sync.duration_ms": {
              "type": "number",
              "description": "Time taken to complete sync"
            },
            "sync.result": {
              "type": "string",
              "description": "Sync result: success"
            }
          }
        }
      }
    },
    {
      "id": "sync-error",
      "type": "text",
      "x": 880,
      "y": 420,
      "width": 220,
      "height": 120,
      "text": "Sync Failed\n(rollback via\nfetchCollections)",
      "pv": {
        "nodeType": "service",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/contexts/WorldsViewPanelContext.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "error",
          "isNew": true
        },
        "event": {
          "name": "collection_map.github.sync_failed",
          "description": "GitHub sync failed, rolling back optimistic update",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "repository.id": {
              "type": "string",
              "description": "Repository ID"
            },
            "error.message": {
              "type": "string",
              "description": "Error message"
            },
            "error.code": {
              "type": "string",
              "description": "Error code if available"
            },
            "sync.duration_ms": {
              "type": "number",
              "description": "Time before failure"
            },
            "rollback.triggered": {
              "type": "boolean",
              "description": "Whether rollback was triggered: true"
            }
          }
        }
      }
    },
    {
      "id": "rollback-fetch",
      "type": "text",
      "x": 610,
      "y": 420,
      "width": 220,
      "height": 100,
      "text": "Rollback: fetchCollections()\n(restore from GitHub\ntruth)",
      "pv": {
        "nodeType": "state",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/contexts/WorldsViewPanelContext.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "state",
          "isNew": true
        },
        "event": {
          "name": "collection_map.state.rollback_started",
          "description": "Rolling back optimistic update by fetching from GitHub",
          "attributes": {
            "rollback.reason": {
              "type": "string",
              "description": "Reason: github_sync_failed"
            },
            "rollback.timestamp": {
              "type": "number",
              "description": "Unix timestamp of rollback"
            }
          }
        }
      }
    },
    {
      "id": "region-created",
      "type": "text",
      "x": 50,
      "y": 580,
      "width": 220,
      "height": 100,
      "text": "Create Region\n(user adds custom\nregion to map)",
      "pv": {
        "nodeType": "ui-component",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/dev-workspace/DevWorkspacePanelFramework.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ui",
          "isNew": true
        },
        "event": {
          "name": "collection_map.region.create_requested",
          "description": "User requested to create a new region",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "region.name": {
              "type": "string",
              "description": "Region name"
            },
            "region.color": {
              "type": "string",
              "description": "Region color hex code"
            },
            "region.position.x": {
              "type": "number",
              "description": "Initial X position"
            },
            "region.position.y": {
              "type": "number",
              "description": "Initial Y position"
            }
          }
        }
      }
    },
    {
      "id": "callback-region-created",
      "type": "text",
      "x": 320,
      "y": 580,
      "width": 240,
      "height": 100,
      "text": "onRegionCreated\n(add region to\ncollection.metadata)",
      "pv": {
        "nodeType": "callback",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/contexts/WorldsViewPanelContext.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "isNew": true
        },
        "event": {
          "name": "collection_map.callback.region_created",
          "description": "Region created callback invoked",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "region.id": {
              "type": "string",
              "description": "Generated region ID"
            },
            "region.name": {
              "type": "string",
              "description": "Region name"
            },
            "layout.mode_switched": {
              "type": "boolean",
              "description": "Whether auto mode was switched to manual"
            },
            "layout.previous_mode": {
              "type": "string",
              "description": "Previous layout mode: auto | manual"
            }
          }
        }
      }
    },
    {
      "id": "switch-layout-mode",
      "type": "text",
      "x": 50,
      "y": 720,
      "width": 220,
      "height": 100,
      "text": "Switch Layout Mode\n(user toggles\nauto ↔ manual)",
      "pv": {
        "nodeType": "ui-component",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/dev-workspace/DevWorkspacePanelFramework.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "ui",
          "isNew": true
        },
        "event": {
          "name": "collection_map.layout.mode_switch_requested",
          "description": "User requested to switch layout mode",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "layout.previous_mode": {
              "type": "string",
              "description": "Previous mode: auto | manual"
            },
            "layout.new_mode": {
              "type": "string",
              "description": "New mode: auto | manual"
            },
            "user.action": {
              "type": "string",
              "description": "User action: button_click"
            }
          }
        }
      }
    },
    {
      "id": "callback-switch-mode",
      "type": "text",
      "x": 320,
      "y": 720,
      "width": 240,
      "height": 100,
      "text": "onSwitchLayoutMode\n(update collection\nmetadata.layoutMode)",
      "pv": {
        "nodeType": "callback",
        "shape": "rectangle",
        "status": "draft",
        "sources": [
          "src/renderer/contexts/WorldsViewPanelContext.tsx"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "isNew": true
        },
        "event": {
          "name": "collection_map.callback.layout_mode_switched",
          "description": "Layout mode switch callback invoked",
          "attributes": {
            "collection.id": {
              "type": "string",
              "description": "Collection ID"
            },
            "layout.new_mode": {
              "type": "string",
              "description": "New layout mode: auto | manual"
            },
            "layout.previous_mode": {
              "type": "string",
              "description": "Previous layout mode"
            }
          }
        }
      }
    }
  ],
  "edges": [
    {
      "id": "drag-to-drop",
      "fromNode": "user-drag-start",
      "fromSide": "bottom",
      "toNode": "user-drag-drop",
      "toSide": "top",
      "label": "drag in progress",
      "pv": {
        "edgeType": "user-action"
      }
    },
    {
      "id": "drop-to-assigned",
      "fromNode": "user-drag-drop",
      "fromSide": "right",
      "toNode": "callback-repository-assigned",
      "toSide": "left",
      "label": "dropped on region",
      "pv": {
        "edgeType": "callback-invoke"
      }
    },
    {
      "id": "drop-to-position",
      "fromNode": "user-drag-drop",
      "fromSide": "right",
      "toNode": "callback-position-updated",
      "toSide": "left",
      "label": "position changed",
      "pv": {
        "edgeType": "callback-invoke"
      }
    },
    {
      "id": "position-to-optimistic",
      "fromNode": "callback-position-updated",
      "fromSide": "right",
      "toNode": "optimistic-update",
      "toSide": "left",
      "label": "update local state",
