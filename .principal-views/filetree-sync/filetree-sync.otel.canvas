{
  "pv": {
    "name": "FileTree Sync Event Flow",
    "version": "1.0.0",
    "description": "Complete event flow from file system changes to UI updates, including cache invalidation, rebuilding, and deduplication",
    "markdown": ".principal-views/filetree-sync/filetree-sync.md",
    "nodeTypes": {
      "file-system": {
        "label": "File System",
        "color": "#64748B"
      },
      "worker": {
        "label": "Worker Process",
        "color": "#0D9488"
      },
      "cache": {
        "label": "Cache",
        "color": "#14B8A6"
      },
      "main-process": {
        "label": "Main Process",
        "color": "#4F46E5"
      },
      "preload": {
        "label": "Preload Bridge",
        "color": "#14B8A6"
      },
      "renderer-service": {
        "label": "Renderer Service",
        "color": "#7C3AED"
      },
      "context": {
        "label": "React Context",
        "color": "#A855F7"
      },
      "ui-component": {
        "label": "UI Component",
        "color": "#EC4899"
      },
      "timing": {
        "label": "Timing/Debounce",
        "color": "#F59E0B"
      },
      "event": {
        "label": "Event",
        "color": "#3B82F6"
      },
      "boundary": {
        "label": "Boundary",
        "color": "#64748B"
      }
    },
    "edgeTypes": {
      "file-watch": {
        "label": "File Watch",
        "style": "dashed",
        "color": "#22C55E"
      },
      "worker-message": {
        "label": "Worker Message",
        "style": "solid",
        "color": "#0D9488"
      },
      "ipc-event": {
        "label": "IPC Event",
        "style": "solid",
        "color": "#818CF8"
      },
      "ipc-invoke": {
        "label": "IPC Invoke",
        "style": "solid",
        "color": "#6366F1"
      },
      "subscription": {
        "label": "Subscription",
        "style": "dashed",
        "color": "#A855F7"
      },
      "cache-invalidate": {
        "label": "Cache Invalidate",
        "style": "solid",
        "color": "#EF4444"
      },
      "cache-rebuild": {
        "label": "Cache Rebuild",
        "style": "solid",
        "color": "#22C55E"
      },
      "data-flow": {
        "label": "Data Flow",
        "style": "solid",
        "color": "#3B82F6"
      },
      "trigger": {
        "label": "Triggers",
        "style": "solid",
        "color": "#F59E0B"
      }
    }
  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "x": 300,
      "y": -100,
      "width": 500,
      "height": 60,
      "color": "#64748B",
      "text": "# FileTree Sync: Complete Event Flow\n**From file changes to UI updates with cache invalidation**"
    },
    {
      "id": "file-system",
      "type": "otel-event",
      "x": 50,
      "y": 0,
      "width": 180,
      "height": 80,
      "label": "File System",
      "shape": "rectangle",
      "event": {
        "name": "filetree.file.changed",
        "description": "File system change detected by chokidar watcher",
        "attributes": {
          "file.path": {
            "type": "string",
            "description": "Absolute path to the changed file"
          },
          "file.event": {
            "type": "string",
            "description": "Type of change: add, change, unlink, addDir, unlinkDir"
          },
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "git-watcher",
      "type": "otel-event",
      "x": 50,
      "y": 120,
      "width": 180,
      "height": 80,
      "label": "Git Watcher",
      "shape": "rectangle",
      "event": {
        "name": "filetree.watcher.detected",
        "description": "Chokidar watcher detected file system change",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          },
          "watcher.event": {
            "type": "string",
            "description": "Chokidar event type"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "repo-monitoring-worker",
      "type": "otel-event",
      "x": 280,
      "y": 120,
      "width": 200,
      "height": 80,
      "label": "Repository Monitoring",
      "shape": "rectangle",
      "event": {
        "name": "filetree.worker.notified",
        "description": "Worker process received file change notification",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          },
          "worker.pid": {
            "type": "number",
            "description": "Worker process ID"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "workspace-changed-event",
      "type": "otel-event",
      "x": 530,
      "y": 120,
      "width": 180,
      "height": 80,
      "label": "workspace:changed",
      "shape": "rectangle",
      "event": {
        "name": "filetree.workspace.changed",
        "description": "IPC event emitted immediately when workspace files change",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          },
          "event.timestamp": {
            "type": "number",
            "description": "Timestamp of event emission"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "cache-registry",
      "type": "otel-event",
      "x": 280,
      "y": 250,
      "width": 200,
      "height": 80,
      "label": "Cache Registry",
      "shape": "rectangle",
      "event": {
        "name": "filetree.cache.invalidated",
        "description": "Cache marked as stale and scheduled for rebuild",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          },
          "cache.version.before": {
            "type": "number",
            "description": "Cache version before invalidation"
          },
          "cache.rebuild.scheduled": {
            "type": "boolean",
            "description": "Whether rebuild was scheduled"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "debounce-timer",
      "type": "otel-event",
      "x": 527,
      "y": 323,
      "width": 180,
      "height": 80,
      "label": "250ms Debounce",
      "shape": "rectangle",
      "event": {
        "name": "filetree.debounce.triggered",
        "description": "Debounce timer completed, cache rebuild starting",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          },
          "debounce.delay_ms": {
            "type": "number",
            "description": "Debounce delay in milliseconds (250)"
          },
          "debounce.changes_count": {
            "type": "number",
            "description": "Number of changes that were batched"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "cache-rebuild",
      "type": "otel-event",
      "x": 281,
      "y": 484,
      "width": 200,
      "height": 80,
      "label": "Cache Rebuild",
      "shape": "rectangle",
      "event": {
        "name": "filetree.cache.rebuild",
        "description": "Cache rebuild completed with incremented version",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          },
          "cache.version.after": {
            "type": "number",
            "description": "New cache version after rebuild"
          },
          "cache.rebuild.duration_ms": {
            "type": "number",
            "description": "Time taken to rebuild cache"
          },
          "filetree.files_count": {
            "type": "number",
            "description": "Number of files in the rebuilt tree"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "cache-sync-event",
      "type": "otel-event",
      "x": 527,
      "y": 481,
      "width": 180,
      "height": 80,
      "label": "CACHE_SYNC",
      "shape": "rectangle",
      "event": {
        "name": "filetree.cache.synced",
        "description": "Cache sync event emitted with fresh file tree data",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          },
          "cache.version": {
            "type": "number",
            "description": "Cache version included in payload"
          },
          "cache.version.after": {
            "type": "number",
            "description": "Cache version after sync"
          },
          "cache.slice": {
            "type": "string",
            "description": "Cache slice type (e.g., 'fileTree')"
          },
          "event.payload.size_bytes": {
            "type": "number",
            "description": "Size of the event payload"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "preload-bridge",
      "type": "otel-event",
      "x": 758,
      "y": 361,
      "width": 200,
      "height": 100,
      "label": "Preload Bridge",
      "shape": "rectangle",
      "event": {
        "name": "filetree.preload.event_received",
        "description": "Preload bridge received IPC event, deduplication check applied",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          },
          "event.type": {
            "type": "string",
            "description": "Event type (workspace:changed or CACHE_SYNC)"
          },
          "dedup.is_duplicate": {
            "type": "boolean",
            "description": "Whether event was identified as duplicate"
          },
          "dedup.window_ms": {
            "type": "number",
            "description": "Deduplication time window (50ms)"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "repo-monitoring-service",
      "type": "otel-event",
      "x": 1010,
      "y": 120,
      "width": 200,
      "height": 80,
      "label": "RepositoryMonitoring",
      "shape": "rectangle",
      "event": {
        "name": "filetree.service.subscribed",
        "description": "Service subscribed to monitoring events",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          },
          "subscription.type": {
            "type": "string",
            "description": "Subscription type (workspace_change or cache_sync)"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "refresh-repository",
      "type": "otel-event",
      "x": 1010,
      "y": 250,
      "width": 200,
      "height": 80,
      "label": "refreshRepository()",
      "shape": "rectangle",
      "event": {
        "name": "filetree.refresh.requested",
        "description": "Explicit cache refresh requested from renderer",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          },
          "refresh.trigger": {
            "type": "string",
            "description": "What triggered the refresh (workspace_change, user_action, etc)"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "repository-panel-context",
      "type": "otel-event",
      "x": 1010,
      "y": 380,
      "width": 200,
      "height": 100,
      "label": "RepositoryPanelContext",
      "shape": "rectangle",
      "event": {
        "name": "filetree.context.updated",
        "description": "React context updated with new file tree data",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          },
          "filetree.version": {
            "type": "number",
            "description": "File tree cache version"
          },
          "update.source": {
            "type": "string",
            "description": "Update source (cache_sync event)"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    },
    {
      "id": "file-tree-ui",
      "type": "otel-event",
      "x": 1260,
      "y": 390,
      "width": 180,
      "height": 80,
      "label": "File Tree UI",
      "shape": "rectangle",
      "event": {
        "name": "filetree.ui.rendered",
        "description": "UI component re-rendered with updated file tree",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path"
          },
          "filetree.version": {
            "type": "number",
            "description": "File tree cache version being displayed"
          },
          "render.duration_ms": {
            "type": "number",
            "description": "Time taken to render the component"
          }
        }
      },
      "otel": {
        "status": "draft"
      }
    }
  ],
  "edges": [
    {
      "id": "fs-to-watcher",
      "fromNode": "file-system",
      "fromSide": "bottom",
      "toNode": "git-watcher",
      "toSide": "top",
      "label": "file change",
      "pv": {
        "edgeType": "file-watch"
      }
    },
    {
      "id": "watcher-to-worker",
      "fromNode": "git-watcher",
      "fromSide": "right",
      "toNode": "repo-monitoring-worker",
      "toSide": "left",
      "label": "notify",
      "pv": {
        "edgeType": "worker-message"
      }
    },
    {
      "id": "worker-to-workspace-event",
      "fromNode": "repo-monitoring-worker",
      "fromSide": "right",
      "toNode": "workspace-changed-event",
      "toSide": "left",
      "label": "emit immediately",
      "pv": {
        "edgeType": "ipc-event"
      }
    },
    {
      "id": "worker-to-cache",
      "fromNode": "repo-monitoring-worker",
      "fromSide": "bottom",
      "toNode": "cache-registry",
      "toSide": "top",
      "label": "invalidate cache",
      "pv": {
        "edgeType": "cache-invalidate"
      }
    },
    {
      "id": "cache-to-debounce",
      "fromNode": "cache-registry",
      "fromSide": "right",
      "toNode": "debounce-timer",
      "toSide": "left",
      "label": "schedule rebuild",
      "pv": {
        "edgeType": "trigger"
      }
    },
    {
      "id": "debounce-to-rebuild",
      "fromNode": "debounce-timer",
      "fromSide": "bottom",
      "toNode": "cache-sync-event",
      "toSide": "top",
      "label": "after 250ms",
      "pv": {
        "edgeType": "trigger"
      }
    },
    {
      "id": "cache-to-rebuild",
      "fromNode": "cache-registry",
      "fromSide": "bottom",
      "toNode": "cache-rebuild",
      "toSide": "top",
      "label": "rebuild",
      "pv": {
        "edgeType": "cache-rebuild"
      }
    },
    {
      "id": "rebuild-to-sync-event",
      "fromNode": "cache-rebuild",
      "fromSide": "right",
      "toNode": "cache-sync-event",
      "toSide": "left",
      "label": "emit with fresh data",
      "pv": {
        "edgeType": "ipc-event"
      }
    },
    {
      "id": "workspace-event-to-preload",
      "fromNode": "workspace-changed-event",
      "fromSide": "right",
      "toNode": "preload-bridge",
      "toSide": "top",
      "label": "workspace:changed",
      "pv": {
        "edgeType": "ipc-event"
      }
    },
    {
      "id": "cache-sync-to-preload",
      "fromNode": "cache-sync-event",
      "fromSide": "right",
      "toNode": "preload-bridge",
      "toSide": "bottom",
      "label": "CACHE_SYNC",
      "pv": {
        "edgeType": "ipc-event"
      }
    },
    {
      "id": "preload-to-service",
      "fromNode": "preload-bridge",
      "fromSide": "right",
      "toNode": "repo-monitoring-service",
      "toSide": "left",
      "label": "exposes API",
      "pv": {
        "edgeType": "subscription"
      }
    },
    {
      "id": "service-to-refresh",
      "fromNode": "repo-monitoring-service",
      "fromSide": "bottom",
      "toNode": "refresh-repository",
      "toSide": "top",
      "label": "provides method",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "refresh-to-cache",
      "fromNode": "refresh-repository",
      "fromSide": "left",
      "toNode": "cache-registry",
      "toSide": "right",
      "label": "IPC invoke",
      "pv": {
        "edgeType": "ipc-invoke"
      }
    },
    {
      "id": "service-to-context",
      "fromNode": "repo-monitoring-service",
      "fromSide": "bottom",
      "toNode": "repository-panel-context",
      "toSide": "top",
      "label": "used by",
      "pv": {
        "edgeType": "data-flow"
      }
    },
    {
      "id": "context-to-ui",
      "fromNode": "repository-panel-context",
      "fromSide": "right",
      "toNode": "file-tree-ui",
      "toSide": "left",
      "label": "provides fileTreeData",
      "pv": {
        "edgeType": "data-flow"
      }
    }
  ]
}
