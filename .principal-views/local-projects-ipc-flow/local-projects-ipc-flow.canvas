{
  "pv": {
    "name": "Local Projects IPC Data Flow",
    "version": "1.0.0",
    "markdown": ".principal-views/local-projects-ipc-flow/local-projects-ipc-flow.md",
    "nodeTypes": {
      "renderer-component": {
        "label": "Renderer Component",
        "color": "#22C55E"
      },
      "renderer-service": {
        "label": "Renderer Service",
        "color": "#10B981"
      },
      "preload": {
        "label": "Preload Script",
        "color": "#8B5CF6"
      },
      "ipc-channel": {
        "label": "IPC Channel",
        "color": "#F59E0B"
      },
      "main-handler": {
        "label": "Main Process Handler",
        "color": "#3B82F6"
      },
      "main-service": {
        "label": "Main Process Service",
        "color": "#2563EB"
      },
      "external-lib": {
        "label": "External Library",
        "color": "#6366F1"
      },
      "storage": {
        "label": "Storage",
        "color": "#EC4899"
      }
    },
    "edgeTypes": {
      "calls": {
        "label": "Calls",
        "style": "solid",
        "color": "#64748B"
      },
      "ipc-invoke": {
        "label": "IPC Invoke",
        "style": "solid",
        "color": "#F59E0B"
      },
      "ipc-event": {
        "label": "IPC Event",
        "style": "dashed",
        "color": "#EF4444"
      },
      "uses": {
        "label": "Uses",
        "style": "dotted",
        "color": "#94A3B8"
      }
    }
  },
  "nodes": [
    {
      "id": "repository-panel-context",
      "type": "text",
      "x": 400,
      "y": 50,
      "width": 220,
      "height": 70,
      "text": "RepositoryPanelContext",
      "pv": {
        "nodeType": "renderer-component",
        "shape": "rectangle",
        "sources": [
          "src/renderer/contexts/RepositoryPanelContext.tsx"
        ]
      }
    },
    {
      "id": "alexandria-service",
      "type": "text",
      "x": 421,
      "y": 168,
      "width": 220,
      "height": 70,
      "text": "AlexandriaService",
      "pv": {
        "nodeType": "renderer-service",
        "shape": "rectangle",
        "sources": [
          "src/renderer/main-process-api/AlexandriaService.ts"
        ]
      }
    },
    {
      "id": "preload-bridge",
      "type": "text",
      "x": 435,
      "y": 286,
      "width": 220,
      "height": 70,
      "text": "Preload Bridge\n(window.mainProcess)",
      "pv": {
        "nodeType": "preload",
        "shape": "rectangle",
        "sources": [
          "src/window/preload.ts"
        ]
      }
    },
    {
      "id": "alexandria-api-impl",
      "type": "text",
      "x": 417,
      "y": 410,
      "width": 220,
      "height": 70,
      "text": "alexandriaApi\n(ipcRenderer.invoke)",
      "pv": {
        "nodeType": "preload",
        "shape": "rectangle",
        "sources": [
          "src/window/main-process-api-implementations/alexandriaApi.ts"
        ]
      }
    },
    {
      "id": "ipc-channels",
      "type": "text",
      "x": 779,
      "y": 187,
      "width": 220,
      "height": 70,
      "text": "IPC Channels\n(alexandria:*)",
      "pv": {
        "nodeType": "ipc-channel",
        "shape": "rectangle",
        "sources": [
          "src/shared/main-process-api-interfaces/AlexandriaAPI.ts"
        ]
      }
    },
    {
      "id": "api-event-handler",
      "type": "text",
      "x": 761,
      "y": 326,
      "width": 220,
      "height": 70,
      "text": "AlexandriaApiEventHandler\n(ipcMain.handle)",
      "pv": {
        "nodeType": "main-handler",
        "shape": "rectangle",
        "sources": [
          "src/main/stores/AlexandriaApiEventHandler.ts"
        ]
      }
    },
    {
      "id": "registry-service",
      "type": "text",
      "x": 766,
      "y": 497,
      "width": 220,
      "height": 70,
      "text": "AlexandriaRegistryService",
      "pv": {
        "nodeType": "main-service",
        "shape": "rectangle",
        "sources": [
          "src/main/stores/AlexandriaRegistryService.ts"
        ]
      }
    },
    {
      "id": "outpost-manager",
      "type": "text",
      "x": 632,
      "y": 635,
      "width": 200,
      "height": 60,
      "text": "AlexandriaOutpostManager\n(@principal-ai/alexandria)",
      "pv": {
        "nodeType": "external-lib",
        "shape": "rectangle"
      }
    },
    {
      "id": "git-client-factory",
      "type": "text",
      "x": 889,
      "y": 632,
      "width": 180,
      "height": 60,
      "text": "gitClientFactory\n(register/refresh only)",
      "pv": {
        "nodeType": "main-service",
        "shape": "rectangle",
        "sources": [
          "src/main/utils/gitClientFactory.ts"
        ]
      }
    },
    {
      "id": "alexandria-storage",
      "type": "text",
      "x": 621,
      "y": 747,
      "width": 200,
      "height": 60,
      "text": "~/.alexandria\n(Project Registry)",
      "pv": {
        "nodeType": "storage",
        "shape": "rectangle"
      }
    },
    {
      "id": "local-repos",
      "type": "text",
      "x": 915,
      "y": 745,
      "width": 180,
      "height": 60,
      "text": "Local Git Repos\n(remote URL discovery)",
      "pv": {
        "nodeType": "storage",
        "shape": "rectangle"
      }
    },
    {
      "id": "broadcast-events",
      "type": "text",
      "x": 1047,
      "y": 264,
      "width": 180,
      "height": 70,
      "text": "Broadcast Events\n(webContents.send)",
      "pv": {
        "nodeType": "ipc-channel",
        "shape": "rectangle"
      }
    }
  ],
  "edges": [
    {
      "id": "context-to-service",
      "fromNode": "repository-panel-context",
      "fromSide": "bottom",
      "toNode": "alexandria-service",
      "toSide": "top",
      "label": "getRepositories()",
      "pv": {
        "edgeType": "calls"
      }
    },
    {
      "id": "service-to-preload",
      "fromNode": "alexandria-service",
      "fromSide": "bottom",
      "toNode": "preload-bridge",
      "toSide": "top",
      "label": "window.mainProcess.alexandria.*",
      "pv": {
        "edgeType": "calls"
      }
    },
    {
      "id": "preload-to-impl",
      "fromNode": "preload-bridge",
      "fromSide": "bottom",
      "toNode": "alexandria-api-impl",
      "toSide": "top",
      "label": "exposes",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "impl-to-channels",
      "fromNode": "alexandria-api-impl",
      "fromSide": "bottom",
      "toNode": "ipc-channels",
      "toSide": "top",
      "label": "ipcRenderer.invoke()",
      "pv": {
        "edgeType": "ipc-invoke"
      }
    },
    {
      "id": "channels-to-handler",
      "fromNode": "ipc-channels",
      "fromSide": "bottom",
      "toNode": "api-event-handler",
      "toSide": "top",
      "label": "ipcMain.handle()",
      "pv": {
        "edgeType": "ipc-invoke"
      }
    },
    {
      "id": "handler-to-registry",
      "fromNode": "api-event-handler",
      "fromSide": "bottom",
      "toNode": "registry-service",
      "toSide": "top",
      "label": "delegates to",
      "pv": {
        "edgeType": "calls"
      }
    },
    {
      "id": "registry-to-outpost",
      "fromNode": "registry-service",
      "fromSide": "bottom",
      "toNode": "outpost-manager",
      "toSide": "top",
      "label": "getAllEntries()",
      "pv": {
        "edgeType": "calls"
      }
    },
    {
      "id": "registry-to-git",
      "fromNode": "registry-service",
      "fromSide": "bottom",
      "toNode": "git-client-factory",
      "toSide": "top",
      "label": "getRemotes() [register only]",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "outpost-to-storage",
      "fromNode": "outpost-manager",
      "fromSide": "bottom",
      "toNode": "alexandria-storage",
      "toSide": "top",
      "label": "reads/writes",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "git-to-repos",
      "fromNode": "git-client-factory",
      "fromSide": "bottom",
      "toNode": "local-repos",
      "toSide": "top",
      "label": "git remote -v",
      "pv": {
        "edgeType": "uses"
      }
    },
    {
      "id": "handler-to-broadcast",
      "fromNode": "api-event-handler",
      "fromSide": "right",
      "toNode": "broadcast-events",
      "toSide": "left",
      "label": "on change",
      "pv": {
        "edgeType": "calls"
      }
    },
    {
      "id": "broadcast-to-channels",
      "fromNode": "broadcast-events",
      "fromSide": "top",
      "toNode": "ipc-channels",
      "toSide": "right",
      "label": "repository-added/updated/removed",
      "pv": {
        "edgeType": "ipc-event"
      }
    },
    {
      "id": "channels-to-context",
      "fromNode": "ipc-channels",
      "fromSide": "top",
      "toNode": "repository-panel-context",
      "toSide": "right",
      "label": "onRepositoryChange()",
      "pv": {
        "edgeType": "ipc-event"
      }
    }
  ]
}