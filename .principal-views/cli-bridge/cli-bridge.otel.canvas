    {
      "id": "e8",
      "fromNode": "worker-exit",
      "toNode": "worker-restart",
      "fromSide": "right",
      "toSide": "left",
      "label": "auto-restart",
      "edgeType": "subscription"
    },
    {
      "id": "e9",
      "fromNode": "diagnostics-panel",
      "toNode": "cli-bridge-init",
      "fromSide": "right",
      "toSide": "left",
      "label": "initialize()",
      "edgeType": "uses"
    },
    {
      "id": "e10",
      "fromNode": "diagnostics-panel",
      "toNode": "worker-restart",
      "fromSide": "bottom",
      "toSide": "left",
      "label": "restartWorker()",
